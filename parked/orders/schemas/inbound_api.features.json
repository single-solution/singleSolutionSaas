{
	"type": "object",
	"title": "Inbound orders",
	"additionalProperties": false,
	"properties": {
		"mappings": {
			"type": "array",
			"title": "Schema mappings",
			"description": "Map another checkout's order JSON onto ours: POST /v1/inbound-orders?mapping=<key>. `fields` maps our field paths (number, externalId, currency, customer.email, shipping.city, amounts.total, payment.method, …) to dot paths in the payload; `lines_path` is the payload's line array and `line_fields` maps line fields (itemId, sku, title, quantity, unitAmount, …). `amounts` says whether money arrives in minor units or as decimals.",
			"default": [],
			"maxItems": 20,
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": ["key", "fields", "lines_path", "line_fields"],
				"properties": {
					"key": { "type": "string", "title": "Key", "minLength": 1, "maxLength": 40, "pattern": "^[a-z][a-z0-9_-]{0,39}$" },
					"fields": {
						"type": "array",
						"title": "Order fields",
						"maxItems": 60,
						"items": {
							"type": "object",
							"additionalProperties": false,
							"required": ["target", "source"],
							"properties": {
								"target": { "type": "string", "title": "Our field", "minLength": 1, "maxLength": 60 },
								"source": { "type": "string", "title": "Payload path", "minLength": 1, "maxLength": 200 }
							}
						}
					},
					"lines_path": { "type": "string", "title": "Line array path", "minLength": 1, "maxLength": 200 },
					"line_fields": {
						"type": "array",
						"title": "Line fields",
						"maxItems": 30,
						"items": {
							"type": "object",
							"additionalProperties": false,
							"required": ["target", "source"],
							"properties": {
								"target": { "type": "string", "title": "Our field", "minLength": 1, "maxLength": 60 },
								"source": { "type": "string", "title": "Payload path", "minLength": 1, "maxLength": 200 }
							}
						}
					},
					"amounts": { "type": "string", "title": "Money format", "enum": ["minor", "decimal"] },
					"source_label": { "type": "string", "title": "Source name", "maxLength": 60 }
				}
			},
			"x-kind": "config"
		},
		"publish_placed": {
			"type": "boolean",
			"title": "Publish order.placed@1 for orders received here",
			"description": "Lets the other products (stock, loyalty, reviews) react to orders from external checkouts. Turn off when the external checkout publishes order.placed@1 itself.",
			"default": true,
			"x-kind": "flag"
		},
		"accept_checkout_events": {
			"type": "boolean",
			"title": "Take in orders from order.placed@1 events (your Checkout)",
			"default": true,
			"x-kind": "flag"
		},
		"orders_per_minute": {
			"type": "integer",
			"title": "Inbound orders per minute",
			"default": 300,
			"minimum": 1,
			"maximum": 10000,
			"x-kind": "rate",
			"x-per": "minute",
			"x-unit": "order"
		}
	}
}
