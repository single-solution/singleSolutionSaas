{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "orders.customer_update@1",
	"description": "A customer status message is ready (customer_updates.delivery = event): a messaging product sends it. Identity references only — the rendered text is read with the website's sk_ key at GET /v1/customer-updates/{messageId}, so contact details never leave the merchant's database through the Event Hub.",
	"type": "object",
	"required": ["messageId", "orderId", "status", "channel", "lang"],
	"additionalProperties": false,
	"properties": {
		"messageId": { "type": "string", "minLength": 1, "maxLength": 64 },
		"orderId": { "type": "string", "minLength": 1, "maxLength": 64 },
		"number": { "type": "string", "minLength": 1, "maxLength": 64 },
		"status": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,39}$" },
		"channel": { "type": "string", "enum": ["email", "sms", "whatsapp"] },
		"lang": { "type": "string", "minLength": 2, "maxLength": 35 },
		"customerId": { "type": "string", "minLength": 1, "maxLength": 128 },
		"subject": { "type": "string", "minLength": 1, "maxLength": 255 }
	},
	"examples": [
		{
			"messageId": "msg_0123456789abcdefghjkmnpq",
			"orderId": "ord_0123456789abcdefghjkmnpq",
			"number": "000123",
			"status": "dispatched",
			"channel": "email",
			"lang": "en",
			"customerId": "cus_123"
		}
	]
}
