					"currency",
					"subtotal",
					"discount",
					"shipping",
					"tax",
					"total",
					"paid",
					"refunded",
					"balance_due",
					"payment_method",
					"delivery_method",
					"carrier",
					"tracking_number",
					"units",
					"lines",
					"serials",
					"risk_flags"
