{
	"type": "object",
	"title": "Inspection",
	"additionalProperties": false,
	"properties": {
		"checklists": {
			"type": "array",
			"title": "Checklists",
			"description": "What an inspector checks per unit. Items are pass/fail, a score from 0 to max, or a note; weights drive the score, critical items cap the tier, and photos_required photos must be uploaded before the inspection completes. The first checklist whose tiers and condition match the unit is used unless one is named.",
			"default": [
				{
					"key": "standard",
					"name": "Standard inspection",
					"tiers": [],
					"applies_when": "",
					"items": [
						{
							"key": "appearance",
							"label": "Appearance",
							"help": "Surfaces, finish and visible wear.",
							"kind": "score",
							"max": 5,
							"weight": 3,
							"required": true,
							"critical": false,
							"photos_required": 1
						},
						{
							"key": "function",
							"label": "Works as intended",
							"help": "",
							"kind": "pass_fail",
							"max": 1,
							"weight": 4,
							"required": true,
							"critical": true,
							"photos_required": 0
						},
						{
							"key": "completeness",
							"label": "Complete (parts and accessories)",
							"help": "",
							"kind": "pass_fail",
							"max": 1,
							"weight": 2,
							"required": true,
							"critical": false,
							"photos_required": 0
						},
						{
							"key": "notes",
							"label": "Notes",
							"help": "",
							"kind": "text",
							"max": 1,
							"weight": 0,
							"required": false,
							"critical": false,
							"photos_required": 0
						}
					]
				}
			],
			"minItems": 0,
			"maxItems": 20,
			"x-kind": "config",
			"x-plan": { "starter": { "max": 2 }, "pro": { "max": 20 } },
			"x-ui": { "widget": "list", "group": "Checklists", "order": 1 },
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": ["key", "name", "items"],
				"properties": {
					"key": { "type": "string", "title": "Key", "minLength": 1, "maxLength": 40, "pattern": "^[a-z][a-z0-9_]*$" },
					"name": { "type": "string", "title": "Name", "minLength": 1, "maxLength": 80 },
					"tiers": {
						"type": "array",
						"title": "For units of these tiers (empty = any)",
						"maxItems": 20,
						"uniqueItems": true,
						"items": { "type": "string", "minLength": 1, "maxLength": 40, "pattern": "^[a-z][a-z0-9_]*$" }
					},
					"applies_when": {
						"type": "string",
						"title": "Applies when (rules@1)",
						"description": "Condition over item and unit. Empty = always.",
						"maxLength": 2000
					},
					"items": {
						"type": "array",
						"title": "Checklist items",
						"minItems": 1,
						"maxItems": 50,
						"items": {
							"type": "object",
							"additionalProperties": false,
							"required": ["key", "label", "kind"],
							"properties": {
								"key": {
									"type": "string",
									"title": "Key",
									"minLength": 1,
									"maxLength": 40,
									"pattern": "^[a-z][a-z0-9_]*$"
								},
								"label": { "type": "string", "title": "Label", "minLength": 1, "maxLength": 120 },
								"help": { "type": "string", "title": "Help for the inspector", "maxLength": 500 },
								"kind": { "type": "string", "title": "Kind", "enum": ["pass_fail", "score", "text"] },
								"max": { "type": "integer", "title": "Highest score", "minimum": 1, "maximum": 10 },
								"weight": { "type": "integer", "title": "Weight in the score", "minimum": 0, "maximum": 100 },
								"required": { "type": "boolean", "title": "Required" },
								"critical": { "type": "boolean", "title": "Critical (a fail caps the tier)" },
								"photos_required": { "type": "integer", "title": "Photos required", "minimum": 0, "maximum": 10 }
							}
						}
					}
				}
			}
		},
		"thresholds": {
			"type": "array",
			"title": "Score → suggested tier",
			"description": "The best tier whose minimum score (0–100) the inspection reaches is suggested.",
			"default": [
				{ "tier": "new", "min_score": 100 },
				{ "tier": "excellent", "min_score": 90 },
				{ "tier": "good", "min_score": 70 },
				{ "tier": "fair", "min_score": 0 }
			],
			"minItems": 0,
			"maxItems": 20,
			"x-kind": "config",
			"x-ui": { "widget": "list", "group": "Scoring", "order": 2 },
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": ["tier", "min_score"],
				"properties": {
					"tier": { "type": "string", "title": "Tier key", "minLength": 1, "maxLength": 40, "pattern": "^[a-z][a-z0-9_]*$" },
					"min_score": { "type": "integer", "title": "Minimum score", "minimum": 0, "maximum": 100 }
				}
			}
		},
		"critical_fail_tier": {
			"type": "string",
			"title": "Tier after a critical fail",
			"description": "Empty = the tier of the lowest threshold.",
			"default": "",
			"maxLength": 40,
			"pattern": "^(?:[a-z][a-z0-9_]*)?$",
			"x-kind": "config",
			"x-ui": { "widget": "text", "group": "Scoring", "order": 3 }
		},
		"apply_suggestion": {
			"type": "boolean",
			"title": "Grade units with the suggested tier",
			"description": "On completion the unit takes the suggested tier unless the inspector names one. Off: only units without a tier take it.",
			"default": true,
			"x-kind": "flag",
			"x-ui": { "widget": "switch", "group": "Scoring", "order": 4 }
		},
		"max_photos_per_item": {
			"type": "integer",
			"title": "Photos per checklist item",
			"default": 4,
			"minimum": 1,
			"maximum": 10,
			"x-kind": "limit",
			"x-plan": { "starter": { "default": 2, "max": 4 }, "pro": { "default": 4, "max": 10 } },
			"x-ui": { "widget": "number", "group": "Photos", "order": 5 }
		},
		"max_photo_bytes": {
			"type": "integer",
			"title": "Largest photo (bytes)",
			"default": 8000000,
			"minimum": 100000,
			"maximum": 25000000,
			"x-kind": "limit",
			"x-ui": { "widget": "number", "group": "Photos", "order": 6 }
		},
		"allowed_types": {
			"type": "array",
			"title": "Photo types",
			"default": ["image/jpeg", "image/png", "image/webp"],
			"minItems": 1,
			"maxItems": 3,
			"uniqueItems": true,
			"items": { "type": "string", "enum": ["image/jpeg", "image/png", "image/webp"] },
			"x-kind": "config",
			"x-ui": { "widget": "tags", "group": "Photos", "order": 7 }
		},
		"upload_ttl_seconds": {
			"type": "integer",
			"title": "Upload link lifetime (seconds)",
			"default": 600,
			"minimum": 60,
			"maximum": 3600,
			"x-kind": "limit",
			"x-ui": { "widget": "number", "group": "Photos", "order": 8 }
		},
		"view_ttl_seconds": {
			"type": "integer",
			"title": "Photo view link lifetime (seconds)",
			"description": "Photos stay private in your bucket; reports carry presigned view links of this lifetime.",
			"default": 3600,
			"minimum": 60,
			"maximum": 86400,
			"x-kind": "limit",
			"x-ui": { "widget": "number", "group": "Photos", "order": 9 }
		},
		"public_base_url": {
			"type": "string",
			"title": "Public photo base URL (optional)",
			"description": "When your bucket or CDN serves objects publicly, photo links are this URL + the object key.",
			"default": "",
			"maxLength": 500,
			"pattern": "^(?:https://[^\\s?#]+)?$",
			"x-kind": "config",
			"x-ui": { "widget": "text", "group": "Photos", "order": 10 }
		},
		"report_link_days": {
			"type": "integer",
			"title": "Report link lifetime (days)",
			"default": 365,
			"minimum": 1,
			"maximum": 3650,
			"x-kind": "limit",
			"x-ui": { "widget": "number", "group": "Reports", "order": 11 }
		},
		"report_url_template": {
			"type": "string",
			"title": "Report page on your website",
			"description": "A page of yours with the drop-in report; {token} is replaced by the report token (e.g. https://shop.example.com/report?r={token}). Empty = tokens only.",
			"default": "",
			"maxLength": 500,
			"pattern": "^(?:https://[^\\s]*\\{token\\}[^\\s]*)?$",
			"x-kind": "config",
			"x-ui": { "widget": "text", "group": "Reports", "order": 12 }
		},
		"report_shows_inspector": {
			"type": "boolean",
			"title": "Show the inspector's name on reports",
			"default": false,
			"x-kind": "flag",
			"x-ui": { "widget": "switch", "group": "Reports", "order": 13 }
		},
		"report_shows_photos": {
			"type": "boolean",
			"title": "Show photos on reports",
			"default": true,
			"x-kind": "flag",
			"x-ui": { "widget": "switch", "group": "Reports", "order": 14 }
		}
	}
}
