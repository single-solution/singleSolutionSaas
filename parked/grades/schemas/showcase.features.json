{
	"type": "object",
	"title": "Showcase",
	"additionalProperties": false,
	"properties": {
		"entries": {
			"type": "array",
			"title": "Explainer per tier",
			"description": "Headline, copy, bullet points, a video link and images per tier. Tiers without an entry show their notes.",
			"default": [],
			"minItems": 0,
			"maxItems": 20,
			"x-kind": "config",
			"x-ui": { "widget": "list", "group": "Content", "order": 1 },
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": ["tier"],
				"properties": {
					"tier": { "type": "string", "title": "Tier key", "minLength": 1, "maxLength": 40, "pattern": "^[a-z][a-z0-9_]*$" },
					"headline": { "type": "string", "title": "Headline", "maxLength": 120 },
					"body": { "type": "string", "title": "Copy", "maxLength": 2000 },
					"bullets": {
						"type": "array",
						"title": "Bullet points",
						"maxItems": 8,
						"items": { "type": "string", "minLength": 1, "maxLength": 200 }
					},
					"video_url": {
						"type": "string",
						"title": "Video link (https)",
						"maxLength": 600,
						"pattern": "^(?:https://[^\\s]+)?$"
					},
					"images": {
						"type": "array",
						"title": "Images",
						"maxItems": 6,
						"items": {
							"type": "object",
							"additionalProperties": false,
							"required": ["url"],
							"properties": {
								"url": {
									"type": "string",
									"title": "Image URL (https)",
									"maxLength": 1000,
									"pattern": "^https://[^\\s]+$"
								},
								"alt": { "type": "string", "title": "Alternative text", "maxLength": 200 }
							}
						}
					}
				}
			}
		},
		"layout": {
			"type": "string",
			"title": "Layout",
			"description": "cards: one card per tier; compare: a side-by-side table; single: the selected tier only.",
			"default": "cards",
			"enum": ["cards", "compare", "single"],
			"x-kind": "config",
			"x-ui": { "widget": "select", "group": "Appearance", "order": 2 }
		},
		"show_warranty": {
			"type": "boolean",
			"title": "Show warranty per tier",
			"description": "Adds the warranty period when the warranty element is on.",
			"default": true,
			"x-kind": "flag",
			"x-ui": { "widget": "switch", "group": "Content", "order": 3 }
		},
		"include_tiers_without_entry": {
			"type": "boolean",
			"title": "Show tiers without an entry",
			"default": true,
			"x-kind": "flag",
			"x-ui": { "widget": "switch", "group": "Content", "order": 4 }
		},
		"cache_seconds": {
			"type": "integer",
			"title": "Browser cache (seconds)",
			"default": 600,
			"minimum": 0,
			"maximum": 86400,
			"x-kind": "config",
			"x-ui": { "widget": "number", "group": "Performance", "order": 5 }
		}
	}
}
