{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "grades.unit_inspected@1",
	"description": "An inspection of a graded unit completed: its weighted score (0–100), the tier the thresholds suggest and the tier the unit now has.",
	"type": "object",
	"required": ["inspectionId", "unitId", "itemId", "checklist", "score", "suggestedTier", "tier", "criticalFailed"],
	"additionalProperties": false,
	"properties": {
		"inspectionId": { "type": "string", "minLength": 1, "maxLength": 64 },
		"unitId": { "type": "string", "minLength": 1, "maxLength": 64 },
		"itemId": { "type": "string", "minLength": 1, "maxLength": 128 },
		"variantId": { "type": "string", "minLength": 1, "maxLength": 128 },
		"checklist": { "type": "string", "minLength": 1, "maxLength": 40 },
		"score": { "type": ["integer", "null"], "minimum": 0, "maximum": 100 },
		"suggestedTier": { "type": ["string", "null"], "maxLength": 40 },
		"tier": { "type": ["string", "null"], "maxLength": 40 },
		"criticalFailed": { "type": "boolean" }
	},
	"examples": [
		{
			"inspectionId": "ins_0mf2k3x1rabcdefghjkmnpqr",
			"unitId": "unt_0mf2k3x1rabcdefghjkmnpqr",
			"itemId": "itm_123",
			"checklist": "standard",
			"score": 93,
			"suggestedTier": "excellent",
			"tier": "excellent",
			"criticalFailed": false
		}
	]
}
