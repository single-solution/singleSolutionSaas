{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "grades.tier_assigned@1",
	"description": "The tier of an item, a variant or a graded unit changed (tier null = removed). source: api, dashboard, catalog (an item.*@1 attribute) or inspection.",
	"type": "object",
	"required": ["itemId", "tier", "source"],
	"additionalProperties": false,
	"properties": {
		"itemId": { "type": "string", "minLength": 1, "maxLength": 128 },
		"variantId": { "type": "string", "minLength": 1, "maxLength": 128 },
		"unitId": { "type": "string", "minLength": 1, "maxLength": 64 },
		"tier": { "type": ["string", "null"], "maxLength": 40 },
		"previousTier": { "type": "string", "minLength": 1, "maxLength": 40 },
		"source": { "type": "string", "enum": ["api", "dashboard", "catalog", "inspection"] }
	},
	"examples": [{ "itemId": "itm_123", "variantId": "var_9", "tier": "excellent", "previousTier": "good", "source": "api" }]
}
