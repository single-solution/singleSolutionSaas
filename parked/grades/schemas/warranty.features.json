{
	"type": "object",
	"title": "Warranty",
	"additionalProperties": false,
	"properties": {
		"terms": {
			"type": "array",
			"title": "Warranty per tier",
			"description": "Days of cover and the text shown for each tier. Text may use {days}, {period} and {tier}.",
			"default": [],
			"minItems": 0,
			"maxItems": 20,
			"x-kind": "config",
			"x-ui": { "widget": "list", "group": "Terms", "order": 1 },
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": ["tier", "days"],
				"properties": {
					"tier": { "type": "string", "title": "Tier key", "minLength": 1, "maxLength": 40, "pattern": "^[a-z][a-z0-9_]*$" },
					"days": { "type": "integer", "title": "Days of cover (0 = none)", "minimum": 0, "maximum": 3650 },
					"text": { "type": "string", "title": "Text", "maxLength": 1000 },
					"exclusions": {
						"type": "array",
						"title": "Not covered",
						"maxItems": 10,
						"items": { "type": "string", "minLength": 1, "maxLength": 200 }
					}
				}
			}
		},
		"default_days": {
			"type": "integer",
			"title": "Days for tiers without terms",
			"default": 0,
			"minimum": 0,
			"maximum": 3650,
			"x-kind": "config",
			"x-ui": { "widget": "number", "group": "Terms", "order": 2 }
		},
		"default_text": {
			"type": "string",
			"title": "Text for tiers without their own",
			"description": "Empty = the standard sentence of the language catalog.",
			"default": "",
			"maxLength": 1000,
			"x-kind": "config",
			"x-ui": { "widget": "textarea", "group": "Terms", "order": 3 }
		},
		"days_per_month": {
			"type": "integer",
			"title": "Days counted as a month",
			"description": "Periods of at least this many days are shown in months.",
			"default": 30,
			"minimum": 28,
			"maximum": 31,
			"x-kind": "config",
			"x-ui": { "widget": "number", "group": "Format", "order": 4 }
		},
		"hide_without_cover": {
			"type": "boolean",
			"title": "Hide tiers with no cover",
			"default": false,
			"x-kind": "flag",
			"x-ui": { "widget": "switch", "group": "Format", "order": 5 }
		},
		"cache_seconds": {
			"type": "integer",
			"title": "Browser cache (seconds)",
			"default": 600,
			"minimum": 0,
			"maximum": 86400,
			"x-kind": "config",
			"x-ui": { "widget": "number", "group": "Performance", "order": 6 }
		}
	}
}
