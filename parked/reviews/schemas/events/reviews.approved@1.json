{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "reviews.approved@1",
	"description": "A review became public (auto-moderation rule or a person); summary is the item's new approved-review rollup.",
	"type": "object",
	"required": ["reviewId", "itemId", "rating", "ratingScale", "verifiedPurchase", "decidedBy", "summary"],
	"additionalProperties": false,
	"properties": {
		"reviewId": { "type": "string", "minLength": 1, "maxLength": 64 },
		"itemId": { "type": "string", "minLength": 1, "maxLength": 128 },
		"rating": { "type": "integer", "minimum": 1, "maximum": 10 },
		"ratingScale": { "type": "integer", "minimum": 3, "maximum": 10 },
		"verifiedPurchase": { "type": "boolean" },
		"decidedBy": { "type": "string", "enum": ["rule", "default", "person"] },
		"ruleId": { "type": "string", "minLength": 1, "maxLength": 40 },
		"customerId": { "type": "string", "minLength": 1, "maxLength": 255 },
		"orderId": { "type": "string", "minLength": 1, "maxLength": 128 },
		"summary": {
			"type": "object",
			"required": ["count", "average"],
			"additionalProperties": false,
			"properties": {
				"count": { "type": "integer", "minimum": 0 },
				"average": { "type": "number", "minimum": 0, "maximum": 10 }
			}
		}
	},
	"examples": [
		{
			"reviewId": "rev_0mf2k3x1rabcdefghjkmnpqr",
			"itemId": "itm_123",
			"rating": 5,
			"ratingScale": 5,
			"verifiedPurchase": true,
			"decidedBy": "rule",
			"ruleId": "verified_clean",
			"customerId": "cus_123",
			"orderId": "ord_1001",
			"summary": { "count": 12, "average": 4.6 }
		}
	]
}
