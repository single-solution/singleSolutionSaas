{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "configurator.published@1",
	"description": "A configurator was published (or republished with a new version): pages and other products can refresh what they show.",
	"type": "object",
	"required": ["configuratorId", "version"],
	"additionalProperties": false,
	"properties": {
		"configuratorId": { "type": "string", "minLength": 1, "maxLength": 64 },
		"key": { "type": "string", "minLength": 1, "maxLength": 64 },
		"version": { "type": "integer", "minimum": 1 },
		"itemId": { "type": "string", "minLength": 1, "maxLength": 128 },
		"groups": { "type": "array", "maxItems": 30, "items": { "type": "string", "maxLength": 64 } }
	},
	"examples": [
		{ "configuratorId": "cfg_0abc", "key": "phone-x", "version": 3, "itemId": "itm_1", "groups": ["storage", "color"] }
	]
}
