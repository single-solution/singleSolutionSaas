{
	"type": "object",
	"title": "Configurator schema",
	"additionalProperties": false,
	"properties": {
		"max_configurators": {
			"type": "integer",
			"title": "Configurators per website",
			"description": "Active (draft or published) configurators; archived ones do not count.",
			"default": 25,
			"minimum": 1,
			"maximum": 5000,
			"x-kind": "limit",
			"x-plan": { "starter": { "default": 25, "max": 100 }, "pro": { "default": 500, "max": 5000 } },
			"x-ui": { "widget": "number", "group": "Limits", "order": 1 }
		},
		"max_groups": {
			"type": "integer",
			"title": "Option groups per configurator",
			"default": 12,
			"minimum": 1,
			"maximum": 30,
			"x-kind": "limit",
			"x-plan": { "starter": { "default": 12, "max": 12 }, "pro": { "default": 30, "max": 30 } },
			"x-ui": { "widget": "number", "group": "Limits", "order": 2 }
		},
		"max_options_per_group": {
			"type": "integer",
			"title": "Options per group",
			"default": 50,
			"minimum": 1,
			"maximum": 200,
			"x-kind": "limit",
			"x-plan": { "starter": { "default": 50, "max": 50 }, "pro": { "default": 200, "max": 200 } },
			"x-ui": { "widget": "number", "group": "Limits", "order": 3 }
		},
		"max_combinations": {
			"type": "integer",
			"title": "Combinations (variants) per configurator",
			"default": 2000,
			"minimum": 0,
			"maximum": 10000,
			"x-kind": "limit",
			"x-plan": { "starter": { "default": 2000, "max": 2000 }, "pro": { "default": 10000, "max": 10000 } },
			"x-ui": { "widget": "number", "group": "Limits", "order": 4 }
		},
		"max_rules": {
			"type": "integer",
			"title": "Exclusion rules per configurator",
			"default": 50,
			"minimum": 0,
			"maximum": 200,
			"x-kind": "limit",
			"x-plan": { "starter": { "default": 50, "max": 50 }, "pro": { "default": 200, "max": 200 } },
			"x-ui": { "widget": "number", "group": "Limits", "order": 5 }
		},
		"catalog_link": {
			"type": "boolean",
			"title": "Use catalog events",
			"description": "Store item.created / item.updated / item.deleted and inventory.changed events from the Event Hub in your database, so configurators can be linked to a catalog item (options, combinations, prices and stock from its variants). Off: configurators are standalone only.",
			"default": true,
			"x-kind": "flag",
			"x-ui": { "widget": "switch", "group": "Catalog", "order": 6 }
		}
	}
}
