{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "coupons.exhausted@1",
	"description": "Every use of a code (scope code) or of a coupon (scope coupon) is redeemed.",
	"type": "object",
	"required": ["couponId", "scope", "limit", "redeemed"],
	"additionalProperties": false,
	"properties": {
		"couponId": { "type": "string", "minLength": 1, "maxLength": 64 },
		"code": { "type": "string", "minLength": 1, "maxLength": 64 },
		"scope": { "type": "string", "enum": ["code", "coupon"] },
		"limit": { "type": "integer", "minimum": 1 },
		"redeemed": { "type": "integer", "minimum": 1 }
	},
	"examples": [{ "couponId": "cpn_0abc", "code": "VIP-2X9K", "scope": "code", "limit": 1, "redeemed": 1 }]
}
