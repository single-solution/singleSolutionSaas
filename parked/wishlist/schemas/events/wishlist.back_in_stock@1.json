{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "wishlist.back_in_stock@1",
	"description": "An item a customer saved (on a list where they opted in to signals) is available again. One event per customer and stock change. Wishlist sends no message itself: Alerts or the merchant's messaging can act on it. Carries the customer's login subject, and their e-mail only when price_drop_hook.include_email is on.",
	"type": "object",
	"required": ["customer", "itemId", "listIds"],
	"additionalProperties": false,
	"properties": {
		"customer": {
			"type": "object",
			"required": ["subject"],
			"additionalProperties": false,
			"properties": {
				"subject": { "type": "string", "minLength": 1, "maxLength": 256 },
				"email": { "type": "string", "minLength": 3, "maxLength": 320 }
			}
		},
		"itemId": { "type": "string", "minLength": 1, "maxLength": 128 },
		"variantId": { "type": "string", "minLength": 1, "maxLength": 128 },
		"locationId": { "type": "string", "minLength": 1, "maxLength": 128 },
		"title": { "type": "string", "maxLength": 200 },
		"url": { "type": "string", "maxLength": 2048 },
		"image": { "type": "string", "maxLength": 2048 },
		"available": { "type": "integer" },
		"listIds": {
			"type": "array",
			"minItems": 1,
			"maxItems": 100,
			"items": { "type": "string", "minLength": 1, "maxLength": 64 }
		}
	},
	"examples": [
		{
			"customer": { "subject": "cus_42" },
			"itemId": "itm_42",
			"title": "Linen shirt",
			"available": 5,
			"listIds": ["wl_0abc"]
		}
	]
}
