{
	"type": "object",
	"title": "Success page",
	"additionalProperties": false,
	"properties": {
		"prep_sla": {
			"type": "string",
			"title": "When the order is prepared",
			"description": "Your own timing text, e.g. \"Within one working day\". Empty: no timing is shown.",
			"default": "",
			"maxLength": 120,
			"x-kind": "config",
			"x-ui": { "widget": "text", "group": "Timing", "order": 1 }
		},
		"ship_sla": {
			"type": "string",
			"title": "When a shipped order arrives",
			"default": "",
			"maxLength": 120,
			"x-kind": "config",
			"x-ui": { "widget": "text", "group": "Timing", "order": 2 }
		},
		"pickup_sla": {
			"type": "string",
			"title": "When a pickup order is ready",
			"default": "",
			"maxLength": 120,
			"x-kind": "config",
			"x-ui": { "widget": "text", "group": "Timing", "order": 3 }
		},
		"confirm_sla": {
			"type": "string",
			"title": "When an order is confirmed",
			"default": "",
			"maxLength": 120,
			"x-kind": "config",
			"x-ui": { "widget": "text", "group": "Timing", "order": 4 }
		},
		"show_bank_details": {
			"type": "boolean",
			"title": "Show the bank details for unpaid transfers",
			"default": true,
			"x-kind": "flag",
			"x-ui": { "widget": "switch", "group": "Content", "order": 5 }
		},
		"continue_url": {
			"type": "string",
			"title": "Continue shopping link",
			"default": "/",
			"maxLength": 500,
			"pattern": "^(?:https://[^\\s]+|/[^\\s]*)$",
			"x-kind": "config",
			"x-ui": { "widget": "text", "group": "Content", "order": 6 }
		}
	}
