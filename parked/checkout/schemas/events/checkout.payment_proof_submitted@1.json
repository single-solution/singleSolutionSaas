{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "checkout.payment_proof_submitted@1",
	"description": "A shopper uploaded a bank-transfer proof for an unpaid order (the file is in the merchant's own storage; the event carries no link).",
	"type": "object",
	"required": ["orderId", "number", "proofId", "method", "amount"],
	"additionalProperties": false,
	"properties": {
		"orderId": { "type": "string", "minLength": 1, "maxLength": 64 },
		"number": { "type": "string", "minLength": 1, "maxLength": 64 },
		"proofId": { "type": "string", "minLength": 1, "maxLength": 64 },
		"method": { "type": "string", "enum": ["bank_transfer", "cod"] },
		"amount": {
			"type": "object",
			"required": ["amount", "currency"],
			"additionalProperties": false,
			"properties": {
				"amount": { "type": "integer", "minimum": 0 },
				"currency": { "type": "string", "pattern": "^[A-Z]{3}$" }
			}
		},
		"reference": { "type": "string", "maxLength": 120 }
	},
	"examples": [
		{
			"orderId": "ord_0mf2k3x1rabcdefghjkmnpqr",
			"number": "000042",
			"proofId": "prf_0mf2k3x1rabcdefghjkmnpqr",
			"method": "bank_transfer",
			"amount": { "amount": 12500, "currency": "EUR" },
			"reference": "TRX-889"
		}
	]
}
