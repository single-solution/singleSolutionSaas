{
	"type": "object",
	"title": "Checkout form",
	"additionalProperties": false,
	"properties": {
		"countries": {
			"type": "array",
			"title": "Countries you deliver to",
			"description": "ISO-3166-1 alpha-2 codes. Empty: any country.",
			"default": [],
			"maxItems": 250,
			"uniqueItems": true,
			"items": { "type": "string", "pattern": "^[A-Z]{2}$" },
			"x-kind": "config",
			"x-ui": { "widget": "tags", "group": "Countries", "order": 1 }
		},
		"default_country": {
			"type": "string",
			"title": "Default country",
			"default": "",
			"pattern": "^(?:[A-Z]{2})?$",
			"x-kind": "config",
			"x-ui": { "widget": "text", "group": "Countries", "order": 2 }
		},
		"contact_fields": {
			"type": "array",
			"title": "Contact fields",
			"description": "In order. kind: text, email, tel, textarea, select, checkbox. Labels come from the strings (checkout_form.field.<key>) unless you set one.",
			"default": [
				{ "key": "name", "kind": "text", "required": true, "autocomplete": "name", "max_length": 120 },
				{ "key": "email", "kind": "email", "required": false, "autocomplete": "email", "max_length": 254 },
				{ "key": "phone", "kind": "tel", "required": true, "autocomplete": "tel", "max_length": 32 }
			],
			"maxItems": 10,
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": ["key", "kind", "required", "autocomplete", "max_length"],
				"properties": {
					"key": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}$" },
					"kind": { "type": "string", "enum": ["text", "email", "tel", "textarea", "select", "checkbox", "postal"] },
					"required": { "type": "boolean" },
					"autocomplete": { "type": "string", "maxLength": 64, "pattern": "^[a-z0-9 -]*$" },
					"max_length": { "type": "integer", "minimum": 1, "maximum": 1000 },
					"options": { "type": "array", "maxItems": 50, "items": { "type": "string", "minLength": 1, "maxLength": 80 } },
					"label": { "type": "string", "maxLength": 80 }
				}
			},
			"x-kind": "config",
			"x-ui": { "widget": "list", "group": "Fields", "order": 3 }
		},
		"address_fields": {
			"type": "array",
			"title": "Address fields",
			"description": "The pool of address fields, in their default order. Country formats below pick and order them per country.",
			"default": [
				{ "key": "recipient_name", "kind": "text", "required": true, "autocomplete": "shipping name", "max_length": 120 },
				{ "key": "recipient_phone", "kind": "tel", "required": false, "autocomplete": "shipping tel", "max_length": 32 },
				{ "key": "line1", "kind": "text", "required": true, "autocomplete": "shipping address-line1", "max_length": 200 },
				{ "key": "line2", "kind": "text", "required": false, "autocomplete": "shipping address-line2", "max_length": 200 },
				{ "key": "area", "kind": "text", "required": false, "autocomplete": "shipping address-level3", "max_length": 120 },
				{ "key": "city", "kind": "text", "required": true, "autocomplete": "shipping address-level2", "max_length": 120 },
				{ "key": "region", "kind": "text", "required": false, "autocomplete": "shipping address-level1", "max_length": 120 },
				{
					"key": "postal_code",
					"kind": "postal",
					"required": false,
					"autocomplete": "shipping postal-code",
					"max_length": 20
				}
			],
			"maxItems": 15,
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": ["key", "kind", "required", "autocomplete", "max_length"],
				"properties": {
					"key": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}$" },
					"kind": { "type": "string", "enum": ["text", "email", "tel", "textarea", "select", "checkbox", "postal"] },
					"required": { "type": "boolean" },
					"autocomplete": { "type": "string", "maxLength": 64, "pattern": "^[a-z0-9 -]*$" },
					"max_length": { "type": "integer", "minimum": 1, "maximum": 1000 },
					"options": { "type": "array", "maxItems": 100, "items": { "type": "string", "minLength": 1, "maxLength": 80 } },
					"label": { "type": "string", "maxLength": 80 }
				}
			},
			"x-kind": "config",
			"x-ui": { "widget": "list", "group": "Address", "order": 4 }
		},
		"address_formats": {
			"type": "array",
			"title": "Address formats by country",
			"description": "Per country: which address fields appear and in what order, which are required, and the postal code template (# digit, A letter, ? either; alternatives separated by |).",
			"default": [],
			"maxItems": 250,
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": ["country", "fields"],
				"properties": {
					"country": { "type": "string", "pattern": "^[A-Z]{2}$" },
					"fields": {
						"type": "array",
						"maxItems": 15,
						"items": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}$" }
					},
					"required": {
						"type": "array",
						"maxItems": 15,
						"items": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}$" }
					},
					"postal_pattern": { "type": "string", "maxLength": 100, "pattern": "^[#A? A-Z0-9|-]*$" }
				}
			},
			"x-kind": "config",
			"x-ui": { "widget": "list", "group": "Address", "order": 5 }
		},
		"phone": {
			"type": "object",
			"title": "Phone validation",
			"description": "mode any: digit count only; e164: + and 7–15 digits after rewrites; patterns: one of the templates (# = digit). Rewrites turn a local prefix into an international one (prefix 0 → +44, say).",
			"default": { "mode": "any", "patterns": [], "rewrites": [], "min_digits": 6, "max_digits": 15 },
			"additionalProperties": false,
			"required": ["mode", "patterns", "rewrites", "min_digits", "max_digits"],
			"properties": {
				"mode": { "type": "string", "enum": ["any", "e164", "patterns"] },
				"patterns": {
					"type": "array",
					"maxItems": 20,
					"items": { "type": "string", "minLength": 1, "maxLength": 24, "pattern": "^\\+?[0-9#]+$" }
				},
				"rewrites": {
					"type": "array",
					"maxItems": 10,
					"items": {
						"type": "object",
						"additionalProperties": false,
						"required": ["prefix", "replace"],
						"properties": {
							"prefix": { "type": "string", "minLength": 1, "maxLength": 8, "pattern": "^\\+?[0-9]+$" },
							"replace": { "type": "string", "maxLength": 8, "pattern": "^\\+?[0-9]*$" }
						}
					}
				},
				"min_digits": { "type": "integer", "minimum": 3, "maximum": 15 },
				"max_digits": { "type": "integer", "minimum": 3, "maximum": 20 }
			},
			"x-kind": "config",
			"x-ui": { "widget": "object", "group": "Fields", "order": 6 }
		},
		"custom_fields": {
			"type": "array",
			"title": "Custom fields",
			"description": "Extra fields stored on the order (gift message, VAT number, delivery notes …).",
			"default": [],
			"maxItems": 10,
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": ["key", "kind", "required", "autocomplete", "max_length"],
				"properties": {
					"key": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}$" },
					"kind": { "type": "string", "enum": ["text", "email", "tel", "textarea", "select", "checkbox", "postal"] },
					"required": { "type": "boolean" },
					"autocomplete": { "type": "string", "maxLength": 64, "pattern": "^[a-z0-9 -]*$" },
					"max_length": { "type": "integer", "minimum": 1, "maximum": 1000 },
					"options": { "type": "array", "maxItems": 50, "items": { "type": "string", "minLength": 1, "maxLength": 80 } },
					"label": { "type": "string", "maxLength": 80 }
				}
			},
			"x-kind": "config",
			"x-plan": { "starter": { "default": [], "max": 3 }, "pro": { "default": [], "max": 10 } },
			"x-ui": { "widget": "list", "group": "Fields", "order": 7 }
		},
		"delivery_methods": {
			"type": "array",
			"title": "Delivery methods",
			"description": "kind ship (needs an address), pickup or digital. fee and free_over are integer minor units of the website currency (free_over 0 = never free).",
			"default": [
				{ "key": "standard", "kind": "ship", "fee": 0, "free_over": 0, "requires_address": true, "countries": [] },
				{ "key": "pickup", "kind": "pickup", "fee": 0, "free_over": 0, "requires_address": false, "countries": [] }
			],
			"minItems": 1,
			"maxItems": 20,
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": ["key", "kind", "fee", "free_over", "requires_address", "countries"],
				"properties": {
					"key": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}$" },
					"kind": { "type": "string", "enum": ["ship", "pickup", "digital"] },
					"fee": { "type": "integer", "minimum": 0, "maximum": 100000000 },
					"free_over": { "type": "integer", "minimum": 0, "maximum": 100000000000 },
					"requires_address": { "type": "boolean" },
					"countries": { "type": "array", "maxItems": 250, "items": { "type": "string", "pattern": "^[A-Z]{2}$" } },
					"label": { "type": "string", "maxLength": 80 }
				}
			},
			"x-kind": "config",
			"x-ui": { "widget": "list", "group": "Delivery", "order": 8 }
		},
		"pickup_locations": {
			"type": "array",
			"title": "Pickup locations",
			"default": [],
			"maxItems": 50,
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": ["key", "name"],
				"properties": {
					"key": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}$" },
					"name": { "type": "string", "minLength": 1, "maxLength": 120 },
					"address": { "type": "string", "maxLength": 300 }
				}
			},
			"x-kind": "config",
			"x-ui": { "widget": "list", "group": "Delivery", "order": 9 }
		},
		"save_addresses": {
			"type": "boolean",
			"title": "Offer to save addresses for signed-in shoppers",
			"default": true,
			"x-kind": "flag",
			"x-ui": { "widget": "switch", "group": "Address", "order": 10 }
		},
		"max_saved_addresses": {
			"type": "integer",
			"title": "Saved addresses per shopper",
			"default": 5,
			"minimum": 1,
			"maximum": 20,
			"x-kind": "limit",
			"x-ui": { "widget": "number", "group": "Address", "order": 11 }
		}
	}
}
