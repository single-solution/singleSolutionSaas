{
	"type": "object",
	"title": "Messages",
	"additionalProperties": false,
	"properties": {
		"customer_can_message": {
			"type": "boolean",
			"title": "Customers can write",
			"description": "Off: only staff write; customers read.",
			"default": true,
			"x-kind": "flag",
			"x-ui": { "widget": "switch", "group": "Conversation", "order": 1 }
		},
		"max_length": {
			"type": "integer",
			"title": "Message length",
			"default": 2000,
			"minimum": 50,
			"maximum": 10000,
			"x-kind": "limit",
			"x-ui": { "widget": "number", "group": "Conversation", "order": 2 }
		},
		"max_messages_per_claim": {
			"type": "integer",
			"title": "Messages per claim",
			"default": 200,
			"minimum": 1,
			"maximum": 2000,
			"x-kind": "limit",
			"x-ui": { "widget": "number", "group": "Conversation", "order": 3 }
		},
		"notify_customer": {
			"type": "boolean",
			"title": "Notify the customer of staff messages",
			"default": true,
			"x-kind": "flag",
			"x-ui": { "widget": "switch", "group": "Notifications", "order": 4 }
		},
		"notify_status_changes": {
			"type": "boolean",
			"title": "Notify the customer of status changes",
			"default": true,
			"x-kind": "flag",
			"x-ui": { "widget": "switch", "group": "Notifications", "order": 5 }
		},
		"staff_recipients": {
			"type": "array",
			"title": "Staff e-mail addresses",
			"description": "Told about new claims and customer messages.",
			"default": [],
			"maxItems": 10,
			"uniqueItems": true,
			"items": { "type": "string", "minLength": 3, "maxLength": 320, "pattern": "^[^\\s@]+@[^\\s@]+$" },
			"x-kind": "config",
			"x-ui": { "widget": "tags", "group": "Notifications", "order": 6 }
		},
		"channels": {
			"type": "array",
			"title": "Customer channels (in order of preference)",
			"default": ["email", "sms"],
			"minItems": 1,
			"maxItems": 3,
			"uniqueItems": true,
			"items": { "type": "string", "enum": ["email", "sms", "whatsapp"] },
			"x-kind": "config",
			"x-ui": { "widget": "tags", "group": "Notifications", "order": 7 }
		},
		"language": {
			"type": "string",
			"title": "Notification language (empty = the website's)",
			"default": "",
			"maxLength": 35,
			"pattern": "^(?:[a-z]{2,3}(?:-[A-Za-z0-9]+)*)?$",
			"x-kind": "config",
			"x-ui": { "widget": "text", "group": "Notifications", "order": 8 }
		}
	}
}
