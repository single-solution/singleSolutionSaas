{
	"type": "object",
	"title": "Queue",
	"additionalProperties": false,
	"properties": {
		"statuses": {
			"type": "array",
			"title": "Statuses",
			"description": "Every status a claim can have. Kind: open (being worked on, counts toward limits), resolved (an outcome), rejected (does not count as claimed) or closed (archived). Labels are shown to customers.",
			"default": [
				{ "key": "requested", "label": "Requested", "kind": "open" },
				{ "key": "approved", "label": "Approved", "kind": "open" },
				{ "key": "received", "label": "Received", "kind": "open" },
				{ "key": "rejected", "label": "Rejected", "kind": "rejected" },
				{ "key": "refunded", "label": "Refunded", "kind": "resolved" },
				{ "key": "replaced", "label": "Replaced", "kind": "resolved" },
				{ "key": "repaired", "label": "Repaired", "kind": "resolved" },
				{ "key": "closed", "label": "Closed", "kind": "closed" }
			],
			"minItems": 2,
			"maxItems": 30,
			"x-kind": "config",
			"x-ui": { "widget": "list", "group": "Statuses", "order": 1 },
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": ["key", "label", "kind"],
				"properties": {
					"key": { "type": "string", "title": "Key", "minLength": 1, "maxLength": 40, "pattern": "^[a-z][a-z0-9_]*$" },
					"label": { "type": "string", "title": "Label", "minLength": 1, "maxLength": 80 },
					"kind": { "type": "string", "title": "Kind", "enum": ["open", "resolved", "rejected", "closed"] },
					"description": { "type": "string", "title": "Customer explanation", "maxLength": 300 }
				}
			}
		},
		"initial_status": {
			"type": "string",
			"title": "Status of a new claim",
			"default": "requested",
			"minLength": 1,
			"maxLength": 40,
			"pattern": "^[a-z][a-z0-9_]*$",
			"x-kind": "config",
			"x-ui": { "widget": "text", "group": "Statuses", "order": 2 }
		},
		"transitions": {
			"type": "array",
			"title": "Transitions",
			"description": "Which status may follow which. Staff move claims only along these.",
			"default": [
				{ "from": "requested", "to": "approved" },
				{ "from": "requested", "to": "rejected" },
				{ "from": "approved", "to": "received" },
				{ "from": "approved", "to": "rejected" },
				{ "from": "received", "to": "refunded" },
				{ "from": "received", "to": "replaced" },
				{ "from": "received", "to": "repaired" },
				{ "from": "received", "to": "rejected" },
				{ "from": "rejected", "to": "closed" },
				{ "from": "refunded", "to": "closed" },
				{ "from": "replaced", "to": "closed" },
				{ "from": "repaired", "to": "closed" }
			],
			"minItems": 1,
			"maxItems": 200,
			"x-kind": "config",
			"x-ui": { "widget": "list", "group": "Statuses", "order": 3 },
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": ["from", "to"],
				"properties": {
					"from": { "type": "string", "title": "From", "minLength": 1, "maxLength": 40, "pattern": "^[a-z][a-z0-9_]*$" },
					"to": { "type": "string", "title": "To", "minLength": 1, "maxLength": 40, "pattern": "^[a-z][a-z0-9_]*$" }
				}
			}
		},
		"sla_hours": {
			"type": "integer",
			"title": "First response due (hours, 0 = none)",
			"default": 48,
			"minimum": 0,
			"maximum": 2160,
			"x-kind": "config",
			"x-ui": { "widget": "number", "group": "Service levels", "order": 4 }
		},
		"note_max_length": {
			"type": "integer",
			"title": "Note length",
			"default": 2000,
			"minimum": 50,
			"maximum": 10000,
			"x-kind": "limit",
			"x-ui": { "widget": "number", "group": "Limits", "order": 5 }
		},
		"max_notes_per_claim": {
			"type": "integer",
			"title": "Notes per claim",
			"default": 100,
			"minimum": 1,
			"maximum": 1000,
			"x-kind": "limit",
			"x-ui": { "widget": "number", "group": "Limits", "order": 6 }
		}
	}
}
