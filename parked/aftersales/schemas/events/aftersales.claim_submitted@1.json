{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "aftersales.claim_submitted@1",
	"description": "A customer (or the merchant's server) submitted a claim: its type and reason, the purchase and order it is for, the claimed lines and where it came from (identity, token or server).",
	"type": "object",
	"required": ["claimId", "reference", "type", "reason", "purchaseId", "status", "lines", "via"],
	"additionalProperties": false,
	"properties": {
		"claimId": { "type": "string", "minLength": 1, "maxLength": 64 },
		"reference": { "type": "string", "minLength": 1, "maxLength": 32 },
		"type": { "type": "string", "minLength": 1, "maxLength": 40 },
		"reason": { "type": "string", "minLength": 1, "maxLength": 40 },
		"purchaseId": { "type": "string", "minLength": 1, "maxLength": 64 },
		"orderId": { "type": "string", "minLength": 1, "maxLength": 128 },
		"status": { "type": "string", "minLength": 1, "maxLength": 40 },
		"via": { "type": "string", "enum": ["identity", "token", "server"] },
		"lines": {
			"type": "array",
			"minItems": 1,
			"maxItems": 100,
			"items": {
				"type": "object",
				"required": ["lineId", "itemId", "quantity"],
				"additionalProperties": false,
				"properties": {
					"lineId": { "type": "string", "minLength": 1, "maxLength": 64 },
					"itemId": { "type": "string", "minLength": 1, "maxLength": 128 },
					"variantId": { "type": "string", "minLength": 1, "maxLength": 128 },
					"quantity": { "type": "integer", "minimum": 1 }
				}
			}
		}
	},
	"examples": [
		{
			"claimId": "clm_0mf2k3x1rabcdefghjkmnpqr",
			"reference": "CL-ABCDEF",
			"type": "return",
			"reason": "defective",
			"purchaseId": "pur_0mf2k3x1rabcdefghjkmnpqr",
			"orderId": "ord_123",
			"status": "requested",
			"via": "identity",
			"lines": [{ "lineId": "l1", "itemId": "itm_123", "variantId": "var_9", "quantity": 1 }]
		}
	]
}
