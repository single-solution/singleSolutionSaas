{
	"type": "object",
	"title": "Adjustments",
	"additionalProperties": false,
	"properties": {
		"max_points": {
			"type": "integer",
			"title": "Maximum points per adjustment",
			"default": 10000,
			"minimum": 1,
			"maximum": 10000000,
			"x-kind": "limit",
			"x-plan": { "starter": { "default": 1000, "max": 10000 }, "pro": { "default": 10000, "max": 1000000 } },
			"x-ui": { "widget": "number", "group": "Limits", "order": 1 }
		},
		"reasons": {
			"type": "array",
			"title": "Reasons",
			"description": "Reason codes staff and merchants choose from.",
			"default": ["goodwill", "correction", "promotion", "migration"],
			"minItems": 1,
			"maxItems": 30,
			"uniqueItems": true,
			"items": { "type": "string", "minLength": 1, "maxLength": 40, "pattern": "^[a-z][a-z0-9_]*$" },
			"x-kind": "config",
			"x-ui": { "widget": "tags", "group": "Reasons", "order": 2 }
		},
		"require_note": {
			"type": "boolean",
			"title": "Require a note",
			"default": true,
			"x-kind": "flag",
			"x-ui": { "widget": "switch", "group": "Reasons", "order": 3 }
		},
		"allow_negative": {
			"type": "boolean",
			"title": "Debits may take the balance below zero",
			"default": false,
			"x-kind": "flag",
			"x-ui": { "widget": "switch", "group": "Limits", "order": 4 }
		}
	}
}
