{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "loyalty.redeemed@1",
	"description": "Points were redeemed at a checkout.",
	"type": "object",
	"required": ["customerId", "redemptionId", "points", "valueAmount", "currency", "balance"],
	"additionalProperties": false,
	"properties": {
		"customerId": { "type": "string", "minLength": 1, "maxLength": 128 },
		"redemptionId": { "type": "string", "minLength": 1, "maxLength": 64 },
		"points": { "type": "integer", "minimum": 1 },
		"valueAmount": { "type": "integer", "minimum": 0, "description": "Value in minor units of currency." },
		"currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
		"balance": { "type": "integer" },
		"orderId": { "type": "string", "minLength": 1, "maxLength": 128 }
	},
	"examples": [
		{
			"customerId": "cus_123",
			"redemptionId": "red_0abc",
			"points": 500,
			"valueAmount": 500,
			"currency": "USD",
			"balance": 370
		}
	]
}
