{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "loyalty.expiring@1",
	"description": "Points of a member expire soon (published once per member and expiry day, notice_days ahead).",
	"type": "object",
	"required": ["customerId", "points", "expiresAt", "balance"],
	"additionalProperties": false,
	"properties": {
		"customerId": { "type": "string", "minLength": 1, "maxLength": 128 },
		"points": { "type": "integer", "minimum": 1 },
		"expiresAt": { "type": "string", "format": "date-time" },
		"expiresOn": {
			"type": "string",
			"pattern": "^\\d{4}-\\d{2}-\\d{2}$",
			"description": "Local calendar day in the website time zone."
		},
		"balance": { "type": "integer" }
	},
	"examples": [
		{
			"customerId": "cus_123",
			"points": 300,
			"expiresAt": "2026-11-15T08:00:00.000Z",
			"expiresOn": "2026-11-15",
			"balance": 870
		}
	]
}
