{
	"type": "object",
	"title": "Referrals",
	"additionalProperties": false,
	"properties": {
		"referrer_points": {
			"type": "integer",
			"title": "Referrer reward (points)",
			"default": 500,
			"minimum": 0,
			"maximum": 1000000,
			"x-kind": "config",
			"x-ui": { "widget": "number", "group": "Rewards", "order": 1 }
		},
		"referee_points": {
			"type": "integer",
			"title": "Referee reward (points)",
			"default": 250,
			"minimum": 0,
			"maximum": 1000000,
			"x-kind": "config",
			"x-ui": { "widget": "number", "group": "Rewards", "order": 2 }
		},
		"min_order_amount": {
			"type": "integer",
			"title": "Minimum qualifying order (minor units)",
			"default": 0,
			"minimum": 0,
			"maximum": 1000000000,
			"x-kind": "config",
			"x-ui": { "widget": "number", "group": "Rewards", "order": 3 }
		},
		"code_prefix": {
			"type": "string",
			"title": "Code prefix",
			"default": "REF",
			"maxLength": 8,
			"pattern": "^[A-Z0-9]*$",
			"x-kind": "config",
			"x-ui": { "widget": "text", "group": "Codes", "order": 4 }
		},
		"code_length": {
			"type": "integer",
			"title": "Random code length",
			"default": 8,
			"minimum": 6,
			"maximum": 16,
			"x-kind": "config",
			"x-ui": { "widget": "number", "group": "Codes", "order": 5 }
		},
		"attribution_days": {
			"type": "integer",
			"title": "Attribution window (days)",
			"description": "The referee's first qualifying order must complete within this many days of attribution.",
			"default": 30,
			"minimum": 1,
			"maximum": 365,
			"x-kind": "config",
			"x-ui": { "widget": "number", "group": "Attribution", "order": 6 }
		},
		"source_prefix": {
			"type": "string",
			"title": "customer.created source prefix",
			"description": "customer.created@1 events whose data.source is '<prefix><CODE>' attribute the new customer to that code.",
			"default": "referral:",
			"maxLength": 32,
			"x-kind": "config",
			"x-ui": { "widget": "text", "group": "Attribution", "order": 7 }
		},
		"new_customers_only": {
			"type": "boolean",
			"title": "Only new customers can be referred",
			"default": true,
			"x-kind": "flag",
			"x-ui": { "widget": "switch", "group": "Fraud", "order": 8 }
		},
		"max_rewards_per_month": {
			"type": "integer",
			"title": "Referrer rewards per month (fraud cap)",
			"default": 10,
			"minimum": 0,
			"maximum": 10000,
			"x-kind": "limit",
			"x-plan": { "pro": { "default": 10, "max": 1000 } },
			"x-ui": { "widget": "number", "group": "Fraud", "order": 9 }
		},
		"max_rewards_lifetime": {
			"type": "integer",
			"title": "Referrer rewards in total (fraud cap)",
			"default": 100,
			"minimum": 0,
			"maximum": 1000000,
			"x-kind": "limit",
			"x-ui": { "widget": "number", "group": "Fraud", "order": 10 }
		}
	}
}
