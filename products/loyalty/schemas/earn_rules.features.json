{
	"type": "object",
	"title": "Earn rules",
	"additionalProperties": false,
	"properties": {
		"rules": {
			"type": "array",
			"title": "Earn rules",
			"description": "Each rule turns a trigger event into points: an optional rules@1 condition, a points formula, caps and exclusions. Rules are evaluated in order and their points add up.",
			"default": [
				{
					"id": "purchase",
					"name": "Points on completed orders",
					"trigger": "order.completed@1",
					"when": "",
					"formula": {
						"kind": "percent",
						"points": 0,
						"percent": 1,
						"per": 1,
						"field": ""
					},
					"caps": {
						"per_event": 0,
						"per_period": 0,
						"period": "month"
					},
					"exclusions": {
						"item_ids": [],
						"skus": [],
						"include_shipping": false,
						"include_tax": false,
						"subtract_discounts": true
					},
					"apply_tier_multiplier": true,
					"enabled": true
				}
			],
			"minItems": 0,
			"maxItems": 50,
			"x-kind": "config",
			"x-plan": {
				"starter": {
					"max": 3
				},
				"pro": {
					"max": 25
				}
			},
			"x-ui": {
				"widget": "list",
				"group": "Rules",
				"order": 1,
				"help": "Conditions use the rules@1 language: order.total >= 5000 and customer.orders == 0"
			},
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": ["id", "trigger", "formula"],
				"properties": {
					"id": {
						"type": "string",
						"title": "Rule id",
						"minLength": 1,
						"maxLength": 40,
						"pattern": "^[a-z][a-z0-9_]*$"
					},
					"name": {
						"type": "string",
						"title": "Name",
						"maxLength": 120
					},
					"trigger": {
						"type": "string",
						"title": "Trigger event",
						"description": "type@version of the event that earns: order.placed@1, order.completed@1, customer.created@1 or custom.<name>@<v>.",
						"maxLength": 120,
						"pattern": "^(?:order\\.placed|order\\.completed|customer\\.created|custom\\.[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)*)@[1-9][0-9]*$"
					},
					"when": {
						"type": "string",
						"title": "Condition (rules@1)",
						"description": "Empty = always. Context: event, order, customer, tier, now.",
						"maxLength": 2000
					},
					"formula": {
						"type": "object",
						"title": "Points formula",
						"additionalProperties": false,
						"required": ["kind"],
						"properties": {
							"kind": {
								"type": "string",
								"title": "Kind",
								"enum": ["fixed", "percent", "per_unit"]
							},
							"points": {
								"type": "integer",
								"title": "Points",
								"description": "fixed: points per event; per_unit: points per `per` units.",
								"minimum": 0,
								"maximum": 1000000
							},
							"percent": {
								"type": "number",
								"title": "Percent of the amount",
								"description": "percent: points = amount in minor units × percent / 100.",
								"minimum": 0,
								"maximum": 100
							},
							"per": {
								"type": "integer",
								"title": "Units per points",
								"minimum": 1,
								"maximum": 1000000
							},
							"field": {
								"type": "string",
								"title": "Amount or unit field",
								"description": "Context path read by percent/per_unit (default order.eligibleAmount / order.eligibleUnits), e.g. event.data.value.",
								"maxLength": 120,
								"pattern": "^(?:[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*)?$"
							}
						}
					},
					"caps": {
						"type": "object",
						"title": "Caps",
						"additionalProperties": false,
						"properties": {
							"per_event": {
								"type": "integer",
								"title": "Max points per event (0 = none)",
								"minimum": 0,
								"maximum": 10000000
							},
							"per_period": {
								"type": "integer",
								"title": "Max points per customer and period (0 = none)",
								"minimum": 0,
								"maximum": 100000000
							},
							"period": {
								"type": "string",
								"title": "Cap period",
								"enum": ["day", "week", "month", "year"]
							}
						}
					},
					"exclusions": {
						"type": "object",
						"title": "Exclusions",
						"additionalProperties": false,
						"properties": {
							"item_ids": {
								"type": "array",
								"title": "Excluded item ids",
								"maxItems": 500,
								"uniqueItems": true,
								"items": {
									"type": "string",
									"maxLength": 128
								}
							},
							"skus": {
								"type": "array",
								"title": "Excluded SKUs",
								"maxItems": 500,
								"uniqueItems": true,
								"items": {
									"type": "string",
									"maxLength": 100
								}
							},
							"include_shipping": {
								"type": "boolean",
								"title": "Count shipping"
							},
							"include_tax": {
								"type": "boolean",
								"title": "Count tax"
							},
							"subtract_discounts": {
								"type": "boolean",
								"title": "Subtract discounts"
							}
						}
					},
					"apply_tier_multiplier": {
						"type": "boolean",
						"title": "Apply the member's tier multiplier"
					},
					"enabled": {
						"type": "boolean",
						"title": "Enabled"
					}
				}
			}
		},
		"rounding": {
			"type": "string",
			"title": "Rounding",
			"description": "How fractional points are rounded (after multipliers, before caps).",
			"default": "floor",
			"enum": ["floor", "round", "ceil"],
			"x-kind": "config",
			"x-ui": {
				"widget": "select",
				"group": "Rules",
				"order": 2
			}
		},
		"time_zone": {
			"type": "string",
			"title": "Time zone",
			"description": "IANA zone used for cap periods, tier windows and expiry notices (the website's zone).",
			"default": "UTC",
			"minLength": 1,
			"maxLength": 64,
			"pattern": "^[A-Za-z_]+(?:/[A-Za-z0-9_+-]+)*$",
			"x-kind": "config",
			"x-ui": {
				"widget": "text",
				"group": "General",
				"order": 3
			}
		},
		"max_points_per_transaction": {
			"type": "integer",
			"title": "Maximum points per transaction",
			"description": "Upper bound for any single earn or manual credit.",
			"default": 100000,
			"minimum": 1,
			"maximum": 100000000,
			"x-kind": "limit",
			"x-plan": {
				"starter": {
					"default": 10000,
					"max": 50000
				},
				"pro": {
					"default": 100000,
					"max": 10000000
				}
			},
			"x-ui": {
				"widget": "number",
				"group": "Limits",
				"order": 4
			}
		}
	}
}
