	"components": {
		"securitySchemes": {
			"websiteKey": {
				"type": "http",
				"scheme": "bearer",
				"description": "pk_ (browser, domain-locked; customer data only with an SS-Identity wallet token) or sk_ (server) website key"
			},
			"portalSignature": {
				"type": "apiKey",
				"in": "header",
				"name": "SS-Signature",
				"description": "Portal-signed request (ss-request.v1)"
			},
			"session": {
				"type": "apiKey",
				"in": "cookie",
				"name": "ss_session",
				"description": "dashboard session from GET /sso?launch="
			}
		},
		"parameters": {
			"IdempotencyKey": {
				"name": "Idempotency-Key",
				"in": "header",
				"required": false,
				"schema": {
					"type": "string",
					"maxLength": 255
				},
				"description": "Optional. On routes that create records, a key already used for the same route within 24 h answers 409 duplicate_request."
			},
			"Cursor": {
				"name": "cursor",
				"in": "query",
				"schema": {
					"type": "string"
				}
			},
			"Limit": {
				"name": "limit",
				"in": "query",
				"schema": {
					"type": "integer",
					"minimum": 1,
					"maximum": 100,
					"default": 20
				}
			},
			"CustomerId": {
				"name": "customerId",
				"in": "path",
				"required": true,
				"schema": {
					"type": "string",
					"pattern": "^[A-Za-z0-9_.:@-]{1,128}$"
				}
			},
			"CustomerQuery": {
				"name": "customerId",
				"in": "query",
				"schema": {
					"type": "string",
					"pattern": "^[A-Za-z0-9_.:@-]{1,128}$"
				},
				"description": "sk_ keys only"
			},
			"RedemptionId": {
				"name": "id",
				"in": "path",
				"required": true,
				"schema": {
					"type": "string"
				}
			},
			"Identity": {
				"name": "SS-Identity",
				"in": "header",
				"schema": {
					"type": "string"
				},
				"description": "wallet token from POST /v1/wallet-tokens (pk_ keys)"
			}
		},
		"responses": {
			"Problem": {
				"description": "RFC 9457 problem",
				"content": {
					"application/problem+json": {
						"schema": {
							"$ref": "#/components/schemas/Problem"
