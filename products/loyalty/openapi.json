{
	"openapi": "3.1.0",
	"info": {
		"title": "Loyalty & Rewards API",
		"version": "1.0.0",
		"description": "Mode C API of Loyalty & Rewards (SSPS v1). All data lives in the merchant's own database. Money is integer minor units + ISO-4217 currency; times are ISO-8601 UTC. Errors are RFC 9457 problems (`type` ends with a stable code). POSTs that create point movements accept an optional `Idempotency-Key`: a key already used for the same route within 24 h answers 409 `duplicate_request`."
	},
	"servers": [
		{
			"url": "https://loyalty.example.com"
		}
	],
	"security": [
		{
			"websiteKey": []
		}
	],
	"tags": [
		{
			"name": "earn_rules"
		},
		{
			"name": "redeem"
		},
		{
			"name": "wallet"
		},
		{
			"name": "tiers"
		},
		{
			"name": "expiry"
		},
		{
			"name": "referrals"
		},
		{
			"name": "adjustments"
		},
		{
			"name": "standard"
		}
	],
	"paths": {
		"/v1/earnings": {
			"get": {
				"operationId": "listEarnings",
				"tags": ["earn_rules"],
				"summary": "Earn transactions (newest first, cursor pagination). sk_: all or ?customerId=; pk_: only the customer of the SS-Identity wallet token (empty without one).",
				"parameters": [
					{
						"$ref": "#/components/parameters/Cursor"
					},
					{
						"$ref": "#/components/parameters/Limit"
					},
					{
						"$ref": "#/components/parameters/CustomerQuery"
					},
					{
						"$ref": "#/components/parameters/Identity"
					}
				],
				"responses": {
					"200": {
						"description": "OK",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/TransactionPage"
								},
								"example": {
									"items": [
										{
											"id": "ptx_0mf2k3x1rabcdefghjkmnpqr",
											"customerId": "cus_123",
											"kind": "earn",
											"points": 120,
											"balanceAfter": 870,
											"reason": "earn_rules",
											"note": null,
											"occurredAt": "2026-10-01T09:00:00.000Z",
											"orderId": "ord_1001",
											"ruleIds": ["purchase"]
										}
									],
									"nextCursor": "MjAyNi0xMC0wMVQwOTowMDowMC4wMDBafHB0eF8w",
									"hasMore": true
								}
							}
						}
					},
					"default": {
						"$ref": "#/components/responses/Problem"
					}
				}
			},
			"post": {
				"operationId": "earnPoints",
				"tags": ["earn_rules"],
				"summary": "Credit points manually or from your server (a repeated Idempotency-Key answers 409; deduplicated on `reference` when given). sk_ only.",
				"parameters": [
					{
						"$ref": "#/components/parameters/IdempotencyKey"
					}
				],
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"$ref": "#/components/schemas/EarnInput"
							},
							"example": {
								"customerId": "cus_example",
								"points": 25,
								"reason": "welcome"
							}
						}
					}
				},
				"responses": {
					"201": {
						"description": "Credited",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Transaction"
								},
								"example": {
									"id": "ptx_0mf2k3x1rabcdefghjkmnpqr",
									"customerId": "cus_123",
									"kind": "earn",
									"points": 25,
									"balanceAfter": 870,
									"reason": "welcome",
									"note": null,
									"occurredAt": "2026-10-01T09:00:00.000Z",
									"orderId": null,
									"ruleIds": []
								}
							}
						}
					},
					"default": {
						"$ref": "#/components/responses/Problem"
					}
				}
			}
		},
		"/v1/members": {
			"get": {
				"operationId": "listMembers",
				"tags": ["earn_rules"],
				"summary": "Members by customer id (ascending), optionally by id prefix.",
				"parameters": [
					{
						"$ref": "#/components/parameters/Cursor"
					},
					{
						"$ref": "#/components/parameters/Limit"
					},
					{
						"name": "q",
						"in": "query",
						"schema": {
							"type": "string",
							"maxLength": 128
						},
						"description": "customer id prefix"
					}
				],
				"responses": {
					"200": {
						"description": "OK",
						"content": {
							"application/json": {
								"schema": {
									"type": "object",
									"required": ["items", "nextCursor", "hasMore"],
									"properties": {
										"items": {
											"type": "array",
											"items": {
												"$ref": "#/components/schemas/Member"
											}
										},
										"nextCursor": {
											"type": ["string", "null"]
										},
										"hasMore": {
											"type": "boolean"
										}
									}
								},
								"example": {
									"items": [
										{
											"customerId": "cus_123",
											"balance": 870,
											"lifetime": {
												"earned": 1670,
												"redeemed": 800,
												"spend": 245000
											},
											"tier": {
												"key": "silver",
												"name": "Silver",
												"multiplier": 1.25,
												"perks": {
													"free_shipping": false,
													"priority_support": false,
													"early_access": true
												},
												"since": "2026-06-01T10:00:00.000Z",
												"reviewAt": "2027-06-01T10:00:00.000Z",
												"basis": "points_earned",
												"metric": 1670,
												"next": {
													"key": "gold",
													"name": "Gold",
													"remaining": 3330
												}
											},
											"expiring": {
												"points": 300,
												"expiresAt": "2026-10-15T08:00:00.000Z",
												"expiresOn": "2026-10-15"
											},
											"orders": 7,
											"joinedAt": "2025-11-02T12:00:00.000Z",
											"referralCode": "REF7K2M9QPA",
											"referredBy": null
										}
									],
									"nextCursor": null,
									"hasMore": false
								}
							}
						}
					},
					"default": {
						"$ref": "#/components/responses/Problem"
					}
				}
			}
		},
		"/v1/members/{customerId}": {
			"parameters": [
				{
					"$ref": "#/components/parameters/CustomerId"
				}
			],
			"get": {
				"operationId": "getMember",
				"tags": ["earn_rules"],
				"summary": "A member by customer id (404 before their first points).",
				"responses": {
					"200": {
						"description": "OK",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Member"
								},
								"example": {
									"customerId": "cus_123",
									"balance": 870,
									"lifetime": {
										"earned": 1670,
										"redeemed": 800,
										"spend": 245000
									},
									"tier": {
										"key": "silver",
										"name": "Silver",
										"multiplier": 1.25,
										"perks": {
											"free_shipping": false,
											"priority_support": false,
											"early_access": true
										},
										"since": "2026-06-01T10:00:00.000Z",
										"reviewAt": "2027-06-01T10:00:00.000Z",
										"basis": "points_earned",
										"metric": 1670,
										"next": {
											"key": "gold",
											"name": "Gold",
											"remaining": 3330
										}
									},
									"expiring": {
										"points": 300,
										"expiresAt": "2026-10-15T08:00:00.000Z",
										"expiresOn": "2026-10-15"
									},
									"orders": 7,
									"joinedAt": "2025-11-02T12:00:00.000Z",
									"referralCode": "REF7K2M9QPA",
									"referredBy": null
								}
							}
						}
					},
					"default": {
						"$ref": "#/components/responses/Problem"
					}
				}
			}
		},
		"/v1/members/{customerId}/balance": {
			"parameters": [
				{
					"$ref": "#/components/parameters/CustomerId"
				}
			],
			"get": {
				"operationId": "getBalance",
				"tags": ["earn_rules"],
				"summary": "Balance, tier and points expiring soon (0 for unknown customers).",
				"responses": {
					"200": {
						"description": "OK",
						"content": {
							"application/json": {
								"schema": {
									"type": "object",
									"required": ["customerId", "balance"],
									"properties": {
										"customerId": {
											"type": "string"
										},
										"balance": {
											"type": "integer"
										},
										"tier": {
											"type": ["string", "null"]
										},
										"expiring": {
											"$ref": "#/components/schemas/Expiring"
										}
									}
								},
								"example": {
									"customerId": "cus_123",
									"balance": 870,
									"tier": "silver",
									"expiring": {
										"points": 300,
										"expiresAt": "2026-10-15T08:00:00.000Z",
										"expiresOn": "2026-10-15"
									}
								}
							}
						}
					},
					"default": {
						"$ref": "#/components/responses/Problem"
					}
				}
			}
		},
		"/v1/members/{customerId}/history": {
			"parameters": [
				{
					"$ref": "#/components/parameters/CustomerId"
				}
			],
			"get": {
				"operationId": "getHistory",
				"tags": ["earn_rules"],
				"summary": "The member's point transactions (newest first, cursor pagination).",
				"parameters": [
					{
						"$ref": "#/components/parameters/Cursor"
					},
					{
						"$ref": "#/components/parameters/Limit"
					}
				],
				"responses": {
					"200": {
						"description": "OK",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/TransactionPage"
								},
								"example": {
									"items": [
										{
											"id": "ptx_0mf2k3x1rabcdefghjkmnpqr",
											"customerId": "cus_123",
											"kind": "earn",
											"points": 120,
											"balanceAfter": 870,
											"reason": "earn_rules",
											"note": null,
											"occurredAt": "2026-10-01T09:00:00.000Z",
											"orderId": "ord_1001",
											"ruleIds": ["purchase"]
										},
										{
											"id": "ptx_1mf2k3x1rabcdefghjkmnpqr",
											"customerId": "cus_123",
											"kind": "redeem",
											"points": -500,
											"balanceAfter": 750,
											"reason": "checkout",
											"note": null,
											"occurredAt": "2026-10-01T09:00:00.000Z",
											"orderId": null,
											"ruleIds": []
										}
									],
									"nextCursor": null,
									"hasMore": false
								}
							}
						}
					},
					"default": {
						"$ref": "#/components/responses/Problem"
					}
				}
			}
		},
		"/v1/rules": {
			"get": {
				"operationId": "listRules",
				"tags": ["earn_rules"],
				"summary": "Effective earn rules of the website (from the signed entitlement) with condition diagnostics.",
				"responses": {
					"200": {
						"description": "OK",
						"content": {
							"application/json": {
								"schema": {
									"type": "object",
									"properties": {
										"timeZone": {
											"type": "string"
										},
										"rounding": {
											"type": "string"
										},
										"items": {
											"type": "array",
											"items": {
												"type": "object"
											}
										}
									}
								},
								"example": {
									"timeZone": "Asia/Karachi",
									"rounding": "floor",
									"items": [
										{
											"id": "purchase",
											"trigger": "order.completed@1",
											"when": "order.total >= 5000",
											"formula": {
												"kind": "percent",
												"percent": 1
											},
											"valid": true,
											"error": null
										}
									]
								}
							}
						}
					},
					"default": {
						"$ref": "#/components/responses/Problem"
					}
				}
			}
		},
		"/v1/rules:check": {
			"post": {
				"operationId": "checkRule",
				"tags": ["earn_rules"],
				"summary": "Check a rules@1 condition (errors with positions, unknown identifiers, paths read). No Idempotency-Key needed.",
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"type": "object",
								"required": ["source"],
								"properties": {
									"source": {
										"type": "string",
										"maxLength": 2000
									}
								}
							},
							"example": {
								"source": "order.total >= 5000 and customer.orders == 0"
							}
						}
					}
				},
				"responses": {
					"200": {
						"description": "OK",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/RuleCheck"
								},
								"example": {
									"ok": true,
									"errors": [],
									"warnings": [],
									"paths": ["customer.orders", "order.total"],
									"functions": []
								}
							}
						}
					},
					"default": {
						"$ref": "#/components/responses/Problem"
					}
				}
			}
		},
		"/v1/activities": {
			"post": {
				"operationId": "recordActivity",
				"tags": ["earn_rules"],
				"summary": "Send a custom event (custom.<name>@v) for a customer; rules triggered by it earn points (once per id / Idempotency-Key).",
				"parameters": [
					{
						"$ref": "#/components/parameters/IdempotencyKey"
					}
				],
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"$ref": "#/components/schemas/ActivityInput"
							},
							"example": {
								"id": "rev_991",
								"type": "custom.review_written@1",
								"customerId": "cus_123",
								"data": {
									"rating": 5
								}
							}
						}
					}
				},
				"responses": {
					"200": {
						"description": "OK",
						"content": {
							"application/json": {
								"schema": {
									"type": "object",
									"properties": {
										"earned": {
											"type": "integer"
										},
										"transaction": {
											"oneOf": [
												{
													"$ref": "#/components/schemas/Transaction"
												},
												{
													"type": "null"
												}
											]
										}
									}
								},
								"example": {
									"earned": 50,
									"transaction": {
										"id": "ptx_0mf2k3x1rabcdefghjkmnpqr",
										"customerId": "cus_123",
										"kind": "earn",
										"points": 50,
										"balanceAfter": 870,
										"reason": "earn_rules",
										"note": null,
										"occurredAt": "2026-10-01T09:00:00.000Z",
										"orderId": null,
										"ruleIds": ["reviews"]
									}
								}
							}
						}
					},
					"default": {
						"$ref": "#/components/responses/Problem"
					}
				}
			}
		},
		"/v1/redemptions:quote": {
			"post": {
				"operationId": "quoteRedemption",
				"tags": ["redeem"],
				"summary": "What the customer can redeem against an amount (min, max share, conversion). No Idempotency-Key needed.",
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"$ref": "#/components/schemas/QuoteInput"
							},
							"example": {
								"customerId": "cus_123",
								"amount": 10000,
								"currency": "USD",
								"discount": 0
							}
						}
					}
				},
				"responses": {
					"200": {
						"description": "OK",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Quote"
								},
								"example": {
									"customerId": "cus_123",
									"currency": "USD",
									"amount": 10000,
									"allowed": true,
									"reason": null,
									"balance": 870,
									"minPoints": 100,
									"maxPoints": 870,
									"maxValue": 870,
									"capValue": 2000,
									"pointValue": {
										"points": 1,
										"value": 1
									}
								}
							}
						}
					},
					"default": {
						"$ref": "#/components/responses/Problem"
					}
				}
			}
		},
		"/v1/redemptions": {
			"post": {
				"operationId": "redeemPoints",
				"tags": ["redeem"],
				"summary": "Redeem points at a checkout (a repeated Idempotency-Key answers 409; deduplicated on `reference`). The value is deducted by your checkout.",
				"parameters": [
					{
						"$ref": "#/components/parameters/IdempotencyKey"
					}
				],
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"$ref": "#/components/schemas/RedeemInput"
							},
							"example": {
								"customerId": "cus_123",
								"points": 500,
								"amount": 10000,
								"currency": "USD",
								"reference": "cart_42"
							}
						}
					}
				},
				"responses": {
					"201": {
						"description": "Redeemed",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Redemption"
								},
								"example": {
									"id": "red_0mf2k3x1rabcdefghjkmnpqr",
									"customerId": "cus_123",
									"status": "applied",
									"points": 500,
									"valueAmount": 500,
									"currency": "USD",
									"orderId": null,
									"reference": "cart_42",
									"balanceAfter": 370,
									"createdAt": "2026-10-01T09:00:00.000Z",
									"returnedAt": null
								}
							}
						}
					},
					"default": {
						"$ref": "#/components/responses/Problem"
					}
				}
			}
		},
		"/v1/redemptions/{id}": {
			"parameters": [
				{
					"$ref": "#/components/parameters/RedemptionId"
				}
			],
			"get": {
				"operationId": "getRedemption",
				"tags": ["redeem"],
				"responses": {
					"200": {
						"description": "OK",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Redemption"
								},
								"example": {
									"id": "red_0mf2k3x1rabcdefghjkmnpqr",
									"customerId": "cus_123",
									"status": "applied",
									"points": 500,
									"valueAmount": 500,
									"currency": "USD",
									"orderId": null,
									"reference": "cart_42",
									"balanceAfter": 370,
									"createdAt": "2026-10-01T09:00:00.000Z",
									"returnedAt": null
								}
							}
						}
					},
					"default": {
						"$ref": "#/components/responses/Problem"
					}
				}
			}
		},
		"/v1/redemptions/{id}/release": {
			"parameters": [
				{
					"$ref": "#/components/parameters/RedemptionId"
				}
			],
			"post": {
				"operationId": "releaseRedemption",
				"tags": ["redeem"],
				"summary": "Release an applied redemption (abandoned checkout): points return to their original lots, once.",
				"parameters": [
					{
						"$ref": "#/components/parameters/IdempotencyKey"
					}
				],
				"responses": {
					"200": {
						"description": "OK",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Redemption"
								},
								"example": {
									"id": "red_0mf2k3x1rabcdefghjkmnpqr",
									"customerId": "cus_123",
									"status": "released",
									"points": 500,
									"valueAmount": 500,
									"currency": "USD",
									"orderId": null,
									"reference": "cart_42",
									"balanceAfter": 370,
									"createdAt": "2026-10-01T09:00:00.000Z",
									"returnedAt": "2026-10-01T09:00:00.000Z"
								}
							}
						}
					},
					"default": {
						"$ref": "#/components/responses/Problem"
					}
				}
			}
		},
		"/v1/redemptions/{id}/confirm": {
			"parameters": [
				{
					"$ref": "#/components/parameters/RedemptionId"
				}
			],
			"post": {
				"operationId": "confirmRedemption",
				"tags": ["redeem"],
				"summary": "Attach the order to a redemption made before the order existed (cancellations then give the points back).",
				"parameters": [
					{
						"$ref": "#/components/parameters/IdempotencyKey"
					}
				],
