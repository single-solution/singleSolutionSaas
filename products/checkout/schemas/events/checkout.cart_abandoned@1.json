{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "checkout.cart_abandoned@1",
	"description": "An open cart with lines was not touched for cart.abandoned_after_hours (published once per cart), for Automation / Messaging reminders. Amounts in minor units of `currency`.",
	"type": "object",
	"required": ["cartId", "currency", "lineCount", "quantity", "subtotalAmount", "updatedAt"],
	"additionalProperties": false,
	"properties": {
		"cartId": { "type": "string", "minLength": 1, "maxLength": 64 },
		"subject": {
			"type": "string",
			"minLength": 1,
			"maxLength": 255,
			"description": "Identity subject of a signed-in shopper."
		},
		"currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
		"lineCount": { "type": "integer", "minimum": 1 },
		"quantity": { "type": "integer", "minimum": 1 },
		"subtotalAmount": { "type": "integer", "minimum": 0 },
		"itemIds": { "type": "array", "maxItems": 50, "items": { "type": "string", "minLength": 1, "maxLength": 128 } },
		"updatedAt": { "type": "string", "format": "date-time" }
	},
	"examples": [
		{
			"cartId": "crt_0mf2k3x1rabcdefghjkmnpqr",
			"currency": "EUR",
			"lineCount": 2,
			"quantity": 3,
			"subtotalAmount": 8900,
			"itemIds": ["itm_runner", "itm_socks"],
			"updatedAt": "2026-10-01T09:00:00.000Z"
		}
	]
}
