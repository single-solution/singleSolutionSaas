					}
				}
			}
		},
		"/v1/checkout-form:validate": {
			"post": {
				"operationId": "postV1CheckoutFormValidate",
				"summary": "Validate form values with the same rules as placement.",
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"type": "object"
							},
							"example": {
								"country": "DE",
								"contact": {
									"name": "Ada",
									"phone": "+4915112345678"
								},
								"deliveryMethod": "pickup"
							}
						}
					}
				},
				"responses": {
					"200": {
						"description": "OK",
