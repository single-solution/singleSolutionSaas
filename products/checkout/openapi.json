			}
		},
		"/v1/addresses/{id}": {
			"delete": {
				"operationId": "deleteV1AddressesId",
				"summary": "Forget a saved address.",
				"parameters": [
					{
						"name": "id",
						"in": "path",
						"required": true,
						"schema": {
							"type": "string"
						}
					}
