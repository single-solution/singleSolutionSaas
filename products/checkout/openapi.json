								}
							}
						}
					},
					"default": {
						"$ref": "#/components/responses/Problem"
					}
				}
			}
		},
		"/v1/addresses": {
			"get": {
				"operationId": "getV1Addresses",
				"summary": "Saved addresses of the signed-in shopper (server keys: ?customerId=).",
				"parameters": [
					{
						"name": "cursor",
						"in": "query",
						"schema": {
							"type": "string"
						}
					},
					{
						"name": "limit",
						"in": "query",
						"schema": {
							"type": "integer",
