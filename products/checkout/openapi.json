{
	"openapi": "3.1.0",
	"info": {
		"title": "Cart & Checkout API",
		"version": "1.0.0",
		"description": "Mode C API of Cart & Checkout (SSPS v1). Money is integer minor units of the website currency. Browser (pk_) keys take the shopper from SS-Identity; server (sk_) keys act for the merchant."
	},
	"servers": [
		{
			"url": "https://checkout.example.com"
		}
	],
	"security": [
		{
			"websiteKey": []
		}
	],
	"paths": {
		"/v1/carts": {
			"get": {
				"operationId": "getV1Carts",
				"summary": "List carts (server keys).",
				"x-ss-key-kind": "sk",
				"parameters": [
					{
						"name": "cursor",
						"in": "query",
						"schema": {
							"type": "string"
						}
					},
					{
						"name": "limit",
						"in": "query",
						"schema": {
							"type": "integer",
							"minimum": 1,
							"maximum": 100
						}
					}
				],
				"responses": {
					"200": {
						"description": "OK",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Page"
								}
							}
						}
					},
					"default": {
						"$ref": "#/components/responses/Problem"
					}
				}
			},
			"x-ss-certify": true,
			"post": {
				"operationId": "postV1Carts",
				"summary": "Create a cart (a signed-in shopper reuses their open cart). Server keys may name the owner (customerId).",
				"parameters": [
					{
						"name": "Idempotency-Key",
						"in": "header",
						"required": true,
						"schema": {
							"type": "string",
							"maxLength": 200
						}
					}
				],
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"type": "object"
							},
							"example": {
								"note": "Gift wrap please"
							}
						}
					}
				},
				"responses": {
					"201": {
						"description": "OK",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Cart"
								}
							}
						}
					},
					"default": {
						"$ref": "#/components/responses/Problem"
					}
				}
			}
		},
		"/v1/carts/{id}": {
			"get": {
				"operationId": "getV1CartsId",
				"summary": "Read a cart (guests by its id; a shopper’s cart only with their identity).",
				"parameters": [
					{
						"name": "id",
						"in": "path",
						"required": true,
						"schema": {
							"type": "string"
						}
					}
				],
				"responses": {
					"200": {
						"description": "OK",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Cart"
								}
							}
						}
					},
					"default": {
						"$ref": "#/components/responses/Problem"
					}
				}
			},
			"patch": {
				"operationId": "patchV1CartsId",
				"summary": "Change the cart note.",
				"parameters": [
					{
						"name": "id",
						"in": "path",
						"required": true,
						"schema": {
							"type": "string"
						}
					}
				],
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"type": "object"
							},
							"example": {
								"note": "Leave at the door"
							}
						}
					}
				},
				"responses": {
					"200": {
						"description": "OK",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Cart"
								}
							}
						}
					},
					"default": {
						"$ref": "#/components/responses/Problem"
					}
				}
			}
		},
		"/v1/carts/{id}/lines": {
			"post": {
				"operationId": "postV1CartsIdLines",
				"summary": "Add a line (priced on the server from the item record; quantity capped by the line limit and tracked stock).",
				"parameters": [
					{
						"name": "id",
						"in": "path",
						"required": true,
						"schema": {
							"type": "string"
						}
					},
					{
						"name": "Idempotency-Key",
						"in": "header",
						"required": false,
						"schema": {
							"type": "string",
							"maxLength": 200
						}
					}
				],
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"type": "object"
							},
							"example": {
								"itemId": "itm_socks",
								"variantId": "var_m",
								"quantity": 2
							}
						}
					}
				},
				"responses": {
					"200": {
						"description": "OK",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Cart"
								}
							}
						}
					},
					"default": {
						"$ref": "#/components/responses/Problem"
					}
				}
			}
		},
		"/v1/carts/{id}/lines/{lineId}": {
			"patch": {
				"operationId": "patchV1CartsIdLinesLineId",
				"summary": "Change a line quantity (0 removes) or note.",
				"parameters": [
					{
						"name": "id",
						"in": "path",
						"required": true,
						"schema": {
							"type": "string"
						}
					},
					{
						"name": "lineId",
						"in": "path",
						"required": true,
						"schema": {
							"type": "string"
						}
					}
				],
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"type": "object"
							},
							"example": {
								"quantity": 3
							}
						}
					}
				},
				"responses": {
					"200": {
						"description": "OK",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Cart"
								}
							}
						}
					},
					"default": {
						"$ref": "#/components/responses/Problem"
					}
				}
			},
			"delete": {
				"operationId": "deleteV1CartsIdLinesLineId",
				"summary": "Remove a line.",
				"parameters": [
					{
						"name": "id",
						"in": "path",
						"required": true,
						"schema": {
							"type": "string"
						}
					},
					{
						"name": "lineId",
						"in": "path",
						"required": true,
						"schema": {
							"type": "string"
						}
					}
				],
				"responses": {
					"200": {
						"description": "OK",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Cart"
								}
							}
						}
					},
					"default": {
						"$ref": "#/components/responses/Problem"
					}
				}
			}
		},
		"/v1/carts/{id}/reconcile": {
			"post": {
				"operationId": "postV1CartsIdReconcile",
				"summary": "Re-price the cart from the current items: price changes, stock caps, items gone (reported in changes).",
				"parameters": [
					{
						"name": "id",
						"in": "path",
						"required": true,
						"schema": {
							"type": "string"
						}
					}
				],
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"type": "object"
							},
							"example": {}
						}
					}
				},
				"responses": {
					"200": {
						"description": "OK",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Cart"
								}
							}
						}
					},
					"default": {
						"$ref": "#/components/responses/Problem"
					}
				}
			}
		},
		"/v1/carts/{id}/merge": {
			"post": {
				"operationId": "postV1CartsIdMerge",
				"summary": "Merge this guest cart into the signed-in shopper’s cart (SS-Identity required).",
				"parameters": [
					{
						"name": "id",
						"in": "path",
						"required": true,
						"schema": {
							"type": "string"
						}
					},
					{
						"name": "Idempotency-Key",
						"in": "header",
						"required": false,
						"schema": {
							"type": "string",
							"maxLength": 200
						}
					}
				],
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"type": "object"
							},
							"example": {}
						}
					}
				},
				"responses": {
					"200": {
						"description": "OK",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Cart"
								}
							}
						}
					},
					"default": {
						"$ref": "#/components/responses/Problem"
					}
				}
			}
		},
		"/v1/items": {
			"get": {
				"operationId": "getV1Items",
				"summary": "List the items Checkout sells from (server keys).",
				"x-ss-key-kind": "sk",
				"parameters": [
					{
						"name": "cursor",
						"in": "query",
						"schema": {
							"type": "string"
						}
					},
					{
						"name": "limit",
						"in": "query",
						"schema": {
							"type": "integer",
							"minimum": 1,
							"maximum": 100
						}
					}
				],
				"responses": {
					"200": {
						"description": "OK",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Page"
								}
							}
						}
					},
					"default": {
						"$ref": "#/components/responses/Problem"
					}
				}
			}
		},
		"/v1/items/{itemId}": {
			"get": {
				"operationId": "getV1ItemsItemId",
				"summary": "One item (browser keys see in-stock flags, not counts).",
				"parameters": [
					{
						"name": "itemId",
						"in": "path",
						"required": true,
						"schema": {
							"type": "string"
						}
					}
				],
				"responses": {
					"200": {
						"description": "OK",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Item"
								}
							}
						}
					},
					"default": {
						"$ref": "#/components/responses/Problem"
					}
				}
			},
			"put": {
				"operationId": "putV1ItemsItemId",
				"summary": "Create or replace an item from your server: title, currency, variants with price (minor units) and available stock (null = not tracked).",
				"x-ss-key-kind": "sk",
				"parameters": [
					{
						"name": "itemId",
						"in": "path",
						"required": true,
						"schema": {
							"type": "string"
						}
					}
				],
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"type": "object"
							},
							"example": {
								"title": "Wool socks",
								"currency": "EUR",
								"requiresShipping": true,
								"variants": [
									{
										"variantId": "var_m",
										"sku": "SOCK-M",
										"price": 1200,
										"available": 40
									}
								]
							}
						}
					}
				},
				"responses": {
					"200": {
						"description": "OK",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Item"
								}
							}
						}
					},
					"default": {
						"$ref": "#/components/responses/Problem"
					}
				}
			},
			"delete": {
				"operationId": "deleteV1ItemsItemId",
				"summary": "Remove an item.",
				"x-ss-key-kind": "sk",
				"parameters": [
					{
						"name": "itemId",
						"in": "path",
						"required": true,
						"schema": {
							"type": "string"
						}
					}
				],
				"responses": {
					"200": {
						"description": "OK",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Any"
								}
							}
						}
					},
					"default": {
						"$ref": "#/components/responses/Problem"
					}
				}
			}
		},
		"/v1/checkout-form": {
			"get": {
				"operationId": "getV1CheckoutForm",
				"summary": "The checkout form for a country (?country=XX): fields, order, required flags, labels, autocomplete, delivery methods.",
				"responses": {
					"200": {
						"description": "OK",
						"content": {
