		},
		"/v1/orders/{id}/cancel": {
			"post": {
				"operationId": "postV1OrdersIdCancel",
				"summary": "Cancel: shoppers while unconfirmed (when allowed), server keys any open order. Gives stock back; publishes order.cancelled@1.",
				"parameters": [
					{
