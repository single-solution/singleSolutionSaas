		"/v1/quotes": {
			"post": {
				"operationId": "postV1Quotes",
				"summary": "The server’s totals for a checkout: deals, coupon codes, delivery, payment surcharge, points; availability of every payment method.",
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"type": "object"
							},
							"example": {
								"cartId": "crt_0mf2k3x1rabcdefghjkmnpqr",
								"deliveryMethod": "standard",
								"paymentMethod": "cod",
								"codes": ["AUTUMN10"]
							}
						}
					}
				},
				"responses": {
					"200": {
						"description": "OK",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Quote"
								}
							}
						}
					},
					"default": {
						"$ref": "#/components/responses/Problem"
					}
				}
			}
		},
		"/v1/orders": {
			"post": {
				"operationId": "postV1Orders",
				"summary": "Place the order: atomic, idempotent (Idempotency-Key required), prices recomputed on the server, stock reserved, offers and points reserved in their products. Publishes order.placed@1.",
				"parameters": [
					{
						"name": "Idempotency-Key",
						"in": "header",
						"required": true,
						"schema": {
							"type": "string",
							"maxLength": 200
						}
					}
				],
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"type": "object"
							},
							"example": {
								"cartId": "crt_0mf2k3x1rabcdefghjkmnpqr",
								"country": "DE",
								"contact": {
									"name": "Ada Lovelace",
									"email": "ada@example.com",
									"phone": "+4915112345678"
								},
								"address": {
									"recipient_name": "Ada Lovelace",
									"line1": "Main street 1",
									"city": "Berlin",
									"postal_code": "10115"
								},
								"deliveryMethod": "standard",
								"paymentMethod": "bank_transfer",
								"codes": ["AUTUMN10"],
								"consents": ["terms"],
								"expectedTotal": 11745
							}
						}
					}
				},
				"responses": {
					"201": {
						"description": "OK",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Order"
								}
							}
						}
					},
					"default": {
						"$ref": "#/components/responses/Problem"
					}
				}
			},
			"get": {
				"operationId": "getV1Orders",
				"summary": "List orders, newest first (?status=, ?customerId=; server keys).",
				"x-ss-key-kind": "sk",
				"parameters": [
					{
						"name": "cursor",
						"in": "query",
						"schema": {
							"type": "string"
						}
					},
					{
						"name": "limit",
						"in": "query",
						"schema": {
							"type": "integer",
							"minimum": 1,
							"maximum": 100
						}
					}
				],
				"responses": {
					"200": {
						"description": "OK",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Page"
								}
							}
						}
					},
					"default": {
						"$ref": "#/components/responses/Problem"
					}
				}
			}
		},
		"/v1/orders/{id}": {
			"get": {
				"operationId": "getV1OrdersId",
				"summary": "One order (server keys, or the signed-in shopper who placed it).",
				"parameters": [
