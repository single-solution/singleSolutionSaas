{
	"type": "object",
	"title": "Category cards features",
	"additionalProperties": false,
	"properties": {
		"cards": {
			"type": "array",
			"title": "Cards",
			"description": "The cards: name, link, image (or logo) and an optional item count.",
			"default": [],
			"maxItems": 48,
			"items": {
				"type": "object",
				"properties": {
					"title": {
						"type": "string",
						"maxLength": 120
					},
					"href": {
						"type": "string",
						"maxLength": 2048,
						"pattern": "^(|https?://\\S+|/\\S*|\\?\\S*|#\\S*|mailto:\\S+|tel:\\S+)$"
					},
					"image": {
						"type": "string",
						"maxLength": 2048,
						"pattern": "^(|https://\\S+|/\\S*)$"
					},
					"count": {
						"type": "integer",
						"minimum": 0,
						"maximum": 100000000
					}
				},
				"required": ["title"],
				"additionalProperties": false
			},
			"x-kind": "config",
			"x-ui": {
				"group": "Content",
				"order": 1,
				"widget": "list"
			}
		},
		"source": {
			"type": "string",
			"title": "Data source",
			"description": "Use the cards above (page; page data overrides them when present) or a public JSON file of the same records (json).",
			"default": "page",
			"enum": ["page", "json"],
			"x-kind": "config",
			"x-ui": {
				"group": "Data",
				"order": 2,
				"widget": "select"
			}
		},
		"source_url": {
			"type": "string",
			"title": "JSON file URL",
			"description": "The public JSON file (json source): https, or a path on this website. api sources need no URL or key: the Loader passes the product client.",
			"default": "",
			"maxLength": 2048,
			"pattern": "^(|https://\\S+|/\\S*)$",
			"x-kind": "config",
			"x-ui": {
				"group": "Data",
				"order": 3,
				"widget": "text"
			}
		},
		"page_data_id": {
			"type": "string",
			"title": "Page data element id",
			"description": "Id of the <script type=\"application/json\"> holding cards.",
			"default": "ss-items",
			"maxLength": 64,
			"pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
			"x-kind": "config",
			"x-ui": {
				"group": "Data",
				"order": 4,
				"widget": "text",
				"advanced": true
			}
		},
		"max_cards": {
			"type": "integer",
			"title": "Cards shown",
			"description": "Most cards shown.",
			"default": 24,
			"minimum": 1,
			"maximum": 48,
			"x-kind": "limit",
			"x-ui": {
				"group": "Content",
				"order": 5,
				"widget": "number"
			}
		},
		"layout": {
			"type": "string",
			"title": "Layout",
			"description": "grid or a horizontally scrolling rail.",
			"default": "grid",
			"enum": ["grid", "rail"],
			"x-kind": "config",
			"x-ui": {
				"group": "Layout",
				"order": 6,
				"widget": "select"
			}
		},
		"columns": {
			"type": "integer",
			"title": "Columns (tablet and up)",
			"description": "Columns of the grid from 768 px.",
			"default": 4,
			"minimum": 1,
			"maximum": 8,
			"x-kind": "config",
			"x-ui": {
				"group": "Layout",
				"order": 7,
				"widget": "number"
			}
		},
		"show_names": {
			"type": "boolean",
			"title": "Show names",
			"description": "Show the name under the image (logos stay labelled for screen readers either way).",
			"default": true,
			"x-kind": "flag",
			"x-ui": {
				"group": "Layout",
				"order": 8,
				"widget": "switch"
			}
		},
		"show_counts": {
			"type": "boolean",
			"title": "Show counts",
			"description": "Show item counts.",
			"default": false,
			"x-kind": "flag",
			"x-ui": {
				"group": "Layout",
				"order": 9,
				"widget": "switch"
			}
		},
		"placement": {
			"type": "object",
			"title": "Placement",
			"description": "Where and when the element renders: the shared placement v1 (paths, selectors, page types, devices, referrers, schedule, consent, triggers, frequency incl. cooldown and dismiss memory, audience rule). The Loader enforces it.",
			"default": {
				"selectors": [
					{
						"selector": "[data-ss-slot=\"categories\"]",
						"position": "append"
					}
				]
			},
			"x-kind": "placement",
			"x-ui": {
				"group": "Placement",
				"order": 10
			}
		}
	}
}
