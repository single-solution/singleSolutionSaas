{
	"type": "object",
	"title": "Hero features",
	"additionalProperties": false,
	"properties": {
		"layout": {
			"type": "string",
			"title": "Layout",
			"description": "Text over the media, beside it (split) or centred.",
			"default": "overlay",
			"enum": ["overlay", "split", "centered"],
			"x-kind": "config",
			"x-ui": {
				"group": "Layout",
				"order": 1,
				"widget": "select"
			}
		},
		"height": {
			"type": "string",
			"title": "Height",
			"description": "Reserved height (no layout shift while media loads).",
			"default": "md",
			"enum": ["sm", "md", "lg"],
			"x-kind": "config",
			"x-ui": {
				"group": "Layout",
				"order": 2,
				"widget": "select"
			}
		},
		"cta_href": {
			"type": "string",
			"title": "Main button link",
			"description": "Where the main button goes (its text is the hero.cta string, per language). Empty: no button.",
			"default": "",
			"maxLength": 2048,
			"pattern": "^(|https?://\\S+|/\\S*|\\?\\S*|#\\S*|mailto:\\S+|tel:\\S+)$",
			"x-kind": "config",
			"x-ui": {
				"group": "Content",
				"order": 3,
				"widget": "text"
			}
		},
		"secondary_href": {
			"type": "string",
			"title": "Second button link",
			"description": "Where the second button goes (hero.secondary string). Empty: no button.",
			"default": "",
			"maxLength": 2048,
			"pattern": "^(|https?://\\S+|/\\S*|\\?\\S*|#\\S*|mailto:\\S+|tel:\\S+)$",
			"x-kind": "config",
			"x-ui": {
				"group": "Content",
				"order": 4,
				"widget": "text"
			}
		},
		"image": {
			"type": "object",
			"title": "Image",
			"description": "The hero image (the page’s likely LCP image): desktop and an optional mobile source, loaded eagerly with high priority unless switched off.",
			"default": {
				"src": "",
				"mobile_src": "",
				"priority": true
			},
			"properties": {
				"src": {
					"type": "string",
					"maxLength": 2048,
					"pattern": "^(|https://\\S+|/\\S*)$"
				},
				"mobile_src": {
					"type": "string",
					"maxLength": 2048,
					"pattern": "^(|https://\\S+|/\\S*)$"
				},
				"priority": {
					"type": "boolean"
				}
			},
			"additionalProperties": false,
			"x-kind": "config",
			"x-ui": {
				"group": "Media",
				"order": 5,
				"widget": "group"
			}
		},
		"video": {
			"type": "object",
			"title": "Background video",
			"description": "Optional muted background video. Never downloaded on Save-Data, on the listed slow connections, with reduced motion or below the minimum viewport width: the poster shows instead.",
			"default": {
				"src": "",
				"poster": "",
				"autoplay": true,
				"respect_save_data": true,
				"skip_connections": ["slow-2g", "2g", "3g"],
				"min_viewport_width": 0
			},
			"properties": {
				"src": {
					"type": "string",
					"maxLength": 2048,
					"pattern": "^(|https://\\S+|/\\S*)$"
				},
				"poster": {
					"type": "string",
					"maxLength": 2048,
					"pattern": "^(|https://\\S+|/\\S*)$"
				},
				"autoplay": {
					"type": "boolean"
				},
				"respect_save_data": {
					"type": "boolean"
				},
				"skip_connections": {
					"type": "array",
					"maxItems": 4,
					"uniqueItems": true,
					"items": {
						"type": "string",
						"enum": ["slow-2g", "2g", "3g", "4g"]
					}
				},
				"min_viewport_width": {
					"type": "integer",
					"minimum": 0,
					"maximum": 4000
				}
			},
			"additionalProperties": false,
			"x-kind": "config",
			"x-ui": {
				"group": "Media",
				"order": 6,
				"widget": "group"
			}
		},
		"placement": {
			"type": "object",
			"title": "Placement",
			"description": "Where and when the element renders: the shared placement v1 (paths, selectors, page types, devices, referrers, schedule, consent, triggers, frequency incl. cooldown and dismiss memory, audience rule). The Loader enforces it.",
			"default": {
				"selectors": [
					{
						"selector": "[data-ss-slot=\"hero\"]",
						"position": "append"
					}
				]
			},
			"x-kind": "placement",
			"x-ui": {
				"group": "Placement",
				"order": 7
			}
		}
	}
}
