{
	"type": "object",
	"title": "Filters features",
	"additionalProperties": false,
	"properties": {
		"source": {
			"type": "string",
			"title": "Data source",
			"description": "page: items embedded in the page (counts computed here); json: a public JSON file; api: the Catalog product (facet counts from GET /v1/items).",
			"default": "page",
			"enum": ["page", "json", "api"],
			"x-kind": "config",
			"x-ui": {
				"group": "Data",
				"order": 1,
				"widget": "select"
			}
		},
		"source_url": {
			"type": "string",
			"title": "Source URL",
			"description": "The public JSON file (json), or the Single Solution product API base (api). https, or a path on this website.",
			"default": "",
			"maxLength": 2048,
			"pattern": "^(|https://\\S+|/\\S*)$",
			"x-kind": "config",
			"x-ui": {
				"group": "Data",
				"order": 2,
				"widget": "text"
			}
		},
		"source_key": {
			"type": "string",
			"title": "Website browser key",
			"description": "The website's browser key (pk_…) for the product API. Never a secret sk_ key: this value is visible in the page.",
			"default": "",
			"maxLength": 1003,
			"pattern": "^(|pk_[A-Za-z0-9_.-]{8,1000})$",
			"x-kind": "config",
			"x-ui": {
				"group": "Data",
				"order": 3,
				"widget": "text"
			}
		},
		"page_data_id": {
			"type": "string",
			"title": "Page data element id",
			"description": "Id of the <script type=\"application/json\"> holding the data when the source is the page.",
			"default": "ss-items",
			"maxLength": 64,
			"pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
			"x-kind": "config",
			"x-ui": {
				"group": "Data",
				"order": 4,
				"widget": "text",
				"advanced": true
			}
		},
		"currency": {
			"type": "string",
			"title": "Default currency",
			"description": "ISO 4217 code for items without their own currency (empty: prices without a currency are not shown).",
			"default": "",
			"maxLength": 3,
			"pattern": "^([A-Z]{3})?$",
			"x-kind": "config",
			"x-ui": {
				"group": "Data",
				"order": 5,
				"widget": "text"
			}
		},
		"locale": {
			"type": "string",
			"title": "Locale",
			"description": "BCP 47 language tag for prices and sorting (empty: the page language).",
			"default": "",
			"maxLength": 35,
			"pattern": "^([A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*)?$",
			"x-kind": "config",
			"x-ui": {
				"group": "Data",
				"order": 6,
				"widget": "text",
				"advanced": true
			}
		},
		"fields": {
			"type": "object",
			"title": "Field mapping",
			"description": "Which JSON fields hold each item property; | separates alternatives (url|href), dots reach nested values (images.0.url). Empty fields use the defaults.",
			"default": {},
			"properties": {
				"id": {
					"type": "string",
					"maxLength": 200
				},
				"title": {
					"type": "string",
					"maxLength": 200
				},
				"href": {
					"type": "string",
					"maxLength": 200
				},
				"image": {
					"type": "string",
					"maxLength": 200
				},
				"image_alt": {
					"type": "string",
					"maxLength": 200
				},
				"price": {
					"type": "string",
					"maxLength": 200
				},
				"compare_at": {
					"type": "string",
					"maxLength": 200
				},
				"currency": {
					"type": "string",
					"maxLength": 200
				},
				"brand": {
					"type": "string",
					"maxLength": 200
				},
				"badges": {
					"type": "string",
					"maxLength": 200
				},
				"attributes": {
					"type": "string",
					"maxLength": 200
				},
				"variants": {
					"type": "string",
					"maxLength": 200
				},
				"collections": {
					"type": "string",
					"maxLength": 200
				},
				"in_stock": {
					"type": "string",
					"maxLength": 200
				},
				"rank": {
					"type": "string",
					"maxLength": 200
				},
				"created_at": {
					"type": "string",
					"maxLength": 200
				}
			},
			"additionalProperties": false,
			"x-kind": "config",
			"x-ui": {
				"group": "Data",
				"order": 7,
				"widget": "group",
				"advanced": true
			}
		},
		"facets": {
			"type": "array",
			"title": "Facets",
			"description": "Facets in display order: key (brand, collection, price, in_stock or an attribute key), label, type (values, range, toggle) and multi-select.",
			"default": [
				{
					"key": "brand",
					"type": "values",
					"multi": true
				},
				{
					"key": "price",
					"type": "range"
				}
			],
			"maxItems": 20,
			"items": {
				"type": "object",
				"properties": {
					"key": {
						"type": "string",
						"pattern": "^[a-z][a-z0-9_-]{0,63}$",
						"maxLength": 64
					},
					"label": {
						"type": "string",
						"maxLength": 80
					},
					"type": {
						"type": "string",
						"enum": ["values", "range", "toggle"]
					},
					"multi": {
						"type": "boolean"
					}
				},
				"required": ["key"],
				"additionalProperties": false
			},
			"x-kind": "config",
			"x-plan": {
				"starter": {
					"max": 6
				},
				"pro": {
					"max": 20
				}
			},
			"x-ui": {
				"group": "Facets",
				"order": 8,
				"widget": "list"
			}
		},
		"layout": {
			"type": "string",
			"title": "Layout",
			"description": "sidebar (always open), sheet (a button opens a panel; best on mobile) or top_bar (one disclosure per facet).",
			"default": "sidebar",
			"enum": ["sidebar", "sheet", "top_bar"],
			"x-kind": "config",
			"x-ui": {
				"group": "Layout",
				"order": 9,
				"widget": "select"
			}
		},
		"show_counts": {
			"type": "boolean",
			"title": "Show counts",
			"description": "Show how many items each value has.",
			"default": true,
			"x-kind": "flag",
			"x-ui": {
				"group": "Facets",
				"order": 10,
				"widget": "switch"
			}
		},
		"max_values": {
			"type": "integer",
			"title": "Values per facet",
			"description": "Most values listed per facet (most frequent first).",
			"default": 20,
			"minimum": 1,
			"maximum": 50,
			"x-kind": "limit",
			"x-ui": {
				"group": "Facets",
				"order": 11,
				"widget": "number"
			}
		},
		"param_prefix": {
			"type": "string",
			"title": "URL parameter prefix",
			"description": "Prefix for the URL parameters (must match the grid).",
			"default": "",
			"maxLength": 9,
			"pattern": "^([a-z][a-z0-9]{0,7}_)?$",
			"x-kind": "config",
			"x-ui": {
				"group": "Facets",
				"order": 12,
				"widget": "text",
				"advanced": true
			}
		},
		"placement": {
			"type": "object",
			"title": "Placement",
			"description": "Where and when the element renders (the shared placement v1: paths, selectors, page types, devices, schedule, consent, triggers, frequency incl. dismiss memory, audience rule). The Loader enforces it.",
			"default": {
				"selectors": [
					{
						"selector": "[data-ss-slot=\"filters\"]",
						"position": "append"
					}
				]
			},
			"properties": {
				"paths": {
					"type": "object",
					"properties": {
						"include": {
							"type": "array",
							"maxItems": 100,
							"uniqueItems": true,
							"items": {
								"type": "string",
								"maxLength": 500,
								"pattern": "^/\\S*$"
							}
						},
						"exclude": {
							"type": "array",
							"maxItems": 100,
							"uniqueItems": true,
							"items": {
								"type": "string",
								"maxLength": 500,
								"pattern": "^/\\S*$"
							}
						}
					},
					"additionalProperties": false
				},
				"selectors": {
					"type": "array",
					"maxItems": 20,
					"items": {
						"type": "object",
						"properties": {
							"selector": {
								"type": "string",
								"maxLength": 500
							},
							"position": {
								"type": "string",
								"enum": ["before", "after", "prepend", "append", "replace"]
							}
						},
						"required": ["selector"],
						"additionalProperties": false
					}
				},
				"pageTypes": {
					"type": "array",
					"maxItems": 50,
					"uniqueItems": true,
					"items": {
						"type": "string",
						"maxLength": 64,
						"pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$"
					}
				},
				"devices": {
					"type": "array",
					"maxItems": 3,
					"uniqueItems": true,
					"items": {
						"type": "string",
						"enum": ["mobile", "tablet", "desktop"]
					}
				},
				"referrers": {
					"type": "object",
					"properties": {
						"include": {
							"type": "array",
							"maxItems": 100,
							"uniqueItems": true,
							"items": {
								"type": "string",
								"maxLength": 253
							}
						},
						"exclude": {
							"type": "array",
							"maxItems": 100,
							"uniqueItems": true,
							"items": {
								"type": "string",
								"maxLength": 253
							}
						}
					},
					"additionalProperties": false
				},
				"schedule": {
					"type": "object",
					"properties": {
						"timezone": {
							"type": "string",
							"maxLength": 64
						},
						"from": {
							"type": "string",
							"format": "date-time"
						},
						"until": {
							"type": "string",
							"format": "date-time"
						},
						"windows": {
							"type": "array",
							"maxItems": 50,
							"items": {
								"type": "object",
								"properties": {
									"days": {
										"type": "array",
										"maxItems": 7,
										"uniqueItems": true,
										"items": {
											"type": "string",
											"enum": ["mon", "tue", "wed", "thu", "fri", "sat", "sun"]
										}
									},
									"start": {
										"type": "string",
										"pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
									},
									"end": {
										"type": "string",
										"pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
									}
								},
								"required": ["start", "end"],
								"additionalProperties": false
							}
						}
					},
					"required": ["timezone"],
					"additionalProperties": false
				},
				"consent": {
					"type": "array",
					"maxItems": 20,
					"uniqueItems": true,
					"items": {
						"type": "string",
						"maxLength": 64
					}
				},
				"triggers": {
					"type": "array",
					"maxItems": 10,
					"items": {
						"type": "object",
						"properties": {
							"type": {
								"type": "string",
								"enum": ["load", "idle", "scroll", "exit", "selector-click", "event"]
							},
							"delayMs": {
								"type": "integer",
								"minimum": 0,
								"maximum": 3600000
							},
							"afterMs": {
								"type": "integer",
								"minimum": 0,
								"maximum": 3600000
							},
							"percent": {
								"type": "integer",
								"minimum": 0,
								"maximum": 100
							},
							"selector": {
								"type": "string",
								"maxLength": 500
							},
							"event": {
								"type": "string",
								"maxLength": 120
							}
						},
						"required": ["type"],
						"additionalProperties": false
					}
				},
				"frequency": {
					"type": "object",
					"properties": {
						"maxPerSession": {
							"type": "integer",
							"minimum": 1,
							"maximum": 10000
						},
						"maxPerDay": {
							"type": "integer",
							"minimum": 1,
							"maximum": 10000
						},
						"maxPerVisitor": {
							"type": "integer",
							"minimum": 1,
							"maximum": 10000
						},
						"cooldown": {
							"type": "string",
							"format": "duration"
						},
						"dismissMemory": {
							"type": "string",
							"format": "duration"
						}
					},
					"additionalProperties": false
				},
				"audience": {
					"type": "string",
					"maxLength": 4000
				}
			},
			"additionalProperties": false,
			"x-kind": "config",
			"x-ui": {
				"group": "Placement",
				"order": 13,
				"widget": "placement"
			}
		}
	}
}
