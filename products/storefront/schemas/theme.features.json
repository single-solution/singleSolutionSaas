{
	"type": "object",
	"title": "Theme features",
	"additionalProperties": false,
	"properties": {
		"colors": {
			"type": "object",
			"title": "Colours",
			"description": "Colour tokens (any CSS colour). Pick pairs with at least 4.5:1 contrast (text on surface, on_primary on primary).",
			"default": {
				"primary": "#1f4fd1",
				"on_primary": "#ffffff",
				"text": "#15171a",
				"text_muted": "#4d5560",
				"surface": "#ffffff",
				"surface_2": "#f2f4f7",
				"border": "#d5d9e0",
				"focus": "#1f4fd1",
				"danger": "#b42318",
				"success": "#067647",
				"accent": "#1f4fd1",
				"on_accent": "#ffffff"
			},
			"properties": {
				"primary": {
					"type": "string",
					"maxLength": 120
				},
				"on_primary": {
					"type": "string",
					"maxLength": 120
				},
				"text": {
					"type": "string",
					"maxLength": 120
				},
				"text_muted": {
					"type": "string",
					"maxLength": 120
				},
				"surface": {
					"type": "string",
					"maxLength": 120
				},
				"surface_2": {
					"type": "string",
					"maxLength": 120
				},
				"border": {
					"type": "string",
					"maxLength": 120
				},
				"focus": {
					"type": "string",
					"maxLength": 120
				},
				"danger": {
					"type": "string",
					"maxLength": 120
				},
				"success": {
					"type": "string",
					"maxLength": 120
				},
				"accent": {
					"type": "string",
					"maxLength": 120
				},
				"on_accent": {
					"type": "string",
					"maxLength": 120
				}
			},
			"additionalProperties": false,
			"x-kind": "config",
			"x-ui": {
				"group": "Colours",
				"order": 1,
				"widget": "colors"
			}
		},
		"fonts": {
			"type": "object",
			"title": "Fonts",
			"description": "Font stacks, a bold weight, and an optional web font (https .woff2) with its family name.",
			"default": {
				"body": "16px/1.5 system-ui, sans-serif",
				"heading": "",
				"weight_bold": "600",
				"family": "",
				"url": ""
			},
			"properties": {
				"body": {
					"type": "string",
					"maxLength": 120
				},
				"heading": {
					"type": "string",
					"maxLength": 120
				},
				"weight_bold": {
					"type": "string",
					"maxLength": 4,
					"pattern": "^([1-9]00)?$"
				},
				"family": {
					"type": "string",
					"maxLength": 60,
					"pattern": "^[A-Za-z0-9 _-]*$"
				},
				"url": {
					"type": "string",
					"maxLength": 2048,
					"pattern": "^(|https://\\S+\\.woff2(\\?\\S*)?)$"
				}
			},
			"additionalProperties": false,
			"x-kind": "config",
			"x-ui": {
				"group": "Typography",
				"order": 2,
				"widget": "group"
			}
		},
		"radius": {
			"type": "object",
			"title": "Corner radius",
			"description": "Corner radii (CSS lengths).",
			"default": {
				"sm": "6px",
				"md": "10px",
				"lg": "16px",
				"full": "999px"
			},
			"properties": {
				"sm": {
					"type": "string",
					"maxLength": 20
				},
				"md": {
					"type": "string",
					"maxLength": 20
				},
				"lg": {
					"type": "string",
					"maxLength": 20
				},
				"full": {
					"type": "string",
					"maxLength": 20
				}
			},
			"additionalProperties": false,
			"x-kind": "config",
			"x-ui": {
				"group": "Shape",
				"order": 3,
				"widget": "group"
			}
		},
		"space_unit": {
			"type": "integer",
			"title": "Spacing unit",
			"description": "Pixels of one spacing step (--ss-space-1; others are multiples).",
			"default": 4,
			"minimum": 1,
			"maximum": 16,
			"x-kind": "config",
			"x-ui": {
				"group": "Shape",
				"order": 4,
				"widget": "number"
			}
		},
		"shadows": {
			"type": "object",
			"title": "Shadows",
			"description": "Shadow tokens (CSS box-shadow values).",
			"default": {
				"md": "0 2px 8px rgb(0 0 0 / 0.08)",
				"lg": "0 8px 24px rgb(0 0 0 / 0.12)"
			},
			"properties": {
				"md": {
					"type": "string",
					"maxLength": 120
				},
				"lg": {
					"type": "string",
					"maxLength": 120
				}
			},
			"additionalProperties": false,
			"x-kind": "config",
			"x-ui": {
				"group": "Shape",
				"order": 5,
				"widget": "group"
			}
		},
		"motion": {
			"type": "string",
			"title": "Motion",
			"description": "full; reduced (shorter, and none for visitors who ask for reduced motion); none.",
			"default": "full",
			"enum": ["full", "reduced", "none"],
			"x-kind": "config",
			"x-ui": {
				"group": "Motion",
				"order": 6,
				"widget": "select"
			}
		},
		"motion_ms": {
			"type": "integer",
			"title": "Transition duration",
			"description": "Milliseconds of transitions (--ss-motion-duration).",
			"default": 200,
			"minimum": 0,
			"maximum": 2000,
			"x-kind": "config",
			"x-ui": {
				"group": "Motion",
				"order": 7,
				"widget": "number"
			}
		},
		"motion_easing": {
			"type": "string",
			"title": "Easing",
			"description": "CSS easing of transitions.",
			"default": "ease-out",
			"maxLength": 60,
			"x-kind": "config",
			"x-ui": {
				"group": "Motion",
				"order": 8,
				"widget": "text"
			}
		},
		"placement": {
			"type": "object",
			"title": "Placement",
			"description": "Where and when the element renders: the shared placement v1 (paths, selectors, page types, devices, referrers, schedule, consent, triggers, frequency incl. cooldown and dismiss memory, audience rule). The Loader enforces it.",
			"default": {
				"selectors": [
					{
						"selector": "body",
						"position": "append"
					}
				],
				"triggers": [
					{
						"type": "load",
						"delayMs": 0
					}
				]
			},
			"x-kind": "placement",
			"x-ui": {
				"group": "Placement",
				"order": 9
			}
		}
	}
}
