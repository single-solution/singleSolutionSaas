{
	"type": "object",
	"title": "Search overlay features",
	"additionalProperties": false,
	"properties": {
		"source": {
			"type": "string",
			"title": "Data source",
			"description": "api: the Site Search product (GET /v1/search) or the Catalog (GET /v1/items) through the client the Loader passes when that product is active on the website; json or page: search the items locally.",
			"default": "page",
			"enum": ["page", "json", "api"],
			"x-kind": "config",
			"x-ui": {
				"group": "Data",
				"order": 1,
				"widget": "select"
			}
		},
		"source_url": {
			"type": "string",
			"title": "JSON file URL",
			"description": "The public JSON file (json source): https, or a path on this website. api sources need no URL or key: the Loader passes the product client.",
			"default": "",
			"maxLength": 2048,
			"pattern": "^(|https://\\S+|/\\S*)$",
			"x-kind": "config",
			"x-ui": {
				"group": "Data",
				"order": 2,
				"widget": "text"
			}
		},
		"page_data_id": {
			"type": "string",
			"title": "Page data element id",
			"description": "Id of the <script type=\"application/json\"> holding the data when the source is the page.",
			"default": "ss-items",
			"maxLength": 64,
			"pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
			"x-kind": "config",
			"x-ui": {
				"group": "Data",
				"order": 4,
				"widget": "text",
				"advanced": true
			}
		},
		"currency": {
			"type": "string",
			"title": "Default currency",
			"description": "ISO 4217 code for items without their own currency (empty: prices without a currency are not shown).",
			"default": "",
			"maxLength": 3,
			"pattern": "^([A-Z]{3})?$",
			"x-kind": "config",
			"x-ui": {
				"group": "Data",
				"order": 5,
				"widget": "text"
			}
		},
		"locale": {
			"type": "string",
			"title": "Locale",
			"description": "BCP 47 language tag for prices and sorting (empty: the page language).",
			"default": "",
			"maxLength": 35,
			"pattern": "^([A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*)?$",
			"x-kind": "config",
			"x-ui": {
				"group": "Data",
				"order": 6,
				"widget": "text",
				"advanced": true
			}
		},
		"fields": {
			"type": "object",
			"title": "Field mapping",
			"description": "Which JSON fields hold each item property; | separates alternatives (url|href), dots reach nested values (images.0.url). Empty fields use the defaults.",
			"default": {},
			"properties": {
				"id": {
					"type": "string",
					"maxLength": 200
				},
				"title": {
					"type": "string",
					"maxLength": 200
				},
				"href": {
					"type": "string",
					"maxLength": 200
				},
				"image": {
					"type": "string",
					"maxLength": 200
				},
				"image_alt": {
					"type": "string",
					"maxLength": 200
				},
				"price": {
					"type": "string",
					"maxLength": 200
				},
				"compare_at": {
					"type": "string",
					"maxLength": 200
				},
				"currency": {
					"type": "string",
					"maxLength": 200
				},
				"brand": {
					"type": "string",
					"maxLength": 200
				},
				"badges": {
					"type": "string",
					"maxLength": 200
				},
				"attributes": {
					"type": "string",
					"maxLength": 200
				},
				"variants": {
					"type": "string",
					"maxLength": 200
				},
				"collections": {
					"type": "string",
					"maxLength": 200
				},
				"in_stock": {
					"type": "string",
					"maxLength": 200
				},
				"rank": {
					"type": "string",
					"maxLength": 200
				},
				"created_at": {
					"type": "string",
					"maxLength": 200
				}
			},
			"additionalProperties": false,
			"x-kind": "config",
			"x-ui": {
				"group": "Data",
				"order": 7,
				"widget": "group",
				"advanced": true
			}
		},
		"api_path": {
			"type": "string",
			"title": "API path",
			"description": "/v1/search (Site Search) or /v1/items (Catalog).",
			"default": "/v1/search",
			"enum": ["/v1/search", "/v1/items"],
			"x-kind": "config",
			"x-ui": {
				"group": "Data",
				"order": 8,
				"widget": "select"
			}
		},
		"results_path": {
			"type": "string",
			"title": "Results page",
			"description": "The website’s own results page; Enter submits the query to it.",
			"default": "/search",
			"maxLength": 200,
			"pattern": "^(|https?://\\S+|/\\S*|\\?\\S*|#\\S*|mailto:\\S+|tel:\\S+)$",
			"x-kind": "config",
			"x-ui": {
				"group": "Search",
				"order": 9,
				"widget": "text"
			}
		},
		"param": {
			"type": "string",
			"title": "Query parameter",
			"description": "Name of the query parameter of the results page.",
			"default": "q",
			"maxLength": 16,
			"pattern": "^[a-z][a-z0-9_]{0,15}$",
			"x-kind": "config",
			"x-ui": {
				"group": "Search",
				"order": 10,
				"widget": "text"
			}
		},
		"min_chars": {
			"type": "integer",
			"title": "Characters before suggesting",
			"description": "Instant results start after this many characters.",
			"default": 2,
			"minimum": 1,
			"maximum": 10,
			"x-kind": "limit",
			"x-ui": {
				"group": "Search",
				"order": 11,
				"widget": "number"
			}
		},
		"max_results": {
			"type": "integer",
			"title": "Suggestions",
			"description": "Most instant results shown.",
			"default": 8,
			"minimum": 1,
			"maximum": 20,
			"x-kind": "limit",
			"x-ui": {
				"group": "Search",
				"order": 12,
				"widget": "number"
			}
		},
		"hotkey": {
			"type": "boolean",
			"title": "Slash opens search",
			"description": "The / key opens the search (outside text fields).",
			"default": true,
			"x-kind": "flag",
			"x-ui": {
				"group": "Search",
				"order": 13,
				"widget": "switch"
			}
		},
		"placement": {
			"type": "object",
			"title": "Placement",
			"description": "Where and when the element renders: the shared placement v1 (paths, selectors, page types, devices, referrers, schedule, consent, triggers, frequency incl. cooldown and dismiss memory, audience rule). The Loader enforces it.",
			"default": {
				"selectors": [
					{
						"selector": "[data-ss-slot=\"search\"]",
						"position": "append"
					}
				]
			},
			"x-kind": "placement",
			"x-ui": {
				"group": "Placement",
				"order": 14
			}
		}
	}
}
