{
	"name": "@ss/product-storefront",
	"version": "1.0.0",
	"description": "Storefront Blocks — SSPS v1 element pack: listing and layout blocks for any website.",
	"type": "module",
	"private": true,
	"license": "UNLICENSED",
	"exports": {
		"./headless/*": "./headless/*",
		"./ui/*": "./ui/*",
		"./pack": "./pack.js",
		"./package.json": "./package.json"
	},
	"engines": {
		"node": ">=22"
	},
	"prettier": "@ss/config/prettier.json",
	"scripts": {
		"dev": "ss dev",
		"build": "node scripts/build.js",
		"build:check": "node scripts/build.js --check",
		"check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm build:check && pnpm test",
		"test": "vitest run --coverage",
		"test:watch": "vitest",
		"lint": "eslint .",
		"typecheck": "tsc -p tsconfig.json",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"validate": "ss app validate .",
		"certify": "ss certify ."
	},
	"dependencies": {
		"@ss/contracts": "workspace:^"
	},
	"devDependencies": {
		"@ss/cli": "workspace:^",
		"@ss/config": "workspace:^",
		"@types/node": "^22.20.4",
		"@vitest/coverage-v8": "^3.2.7",
		"esbuild": "^0.28.2",
		"eslint": "^9.39.5",
		"jsdom": "^26.1.0",
		"prettier": "^3.9.9",
		"typescript": "~5.9.3",
		"vitest": "^3.2.7"
	}
}
