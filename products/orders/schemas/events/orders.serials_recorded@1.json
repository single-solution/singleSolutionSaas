{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "orders.serials_recorded@1",
	"description": "Serials were recorded on an order: every serial the order now holds, with its line's item (the shape After-sales reads for warranty and return claims).",
	"type": "object",
	"required": ["orderId", "serials"],
	"additionalProperties": false,
	"properties": {
		"orderId": {
			"type": "string",
			"minLength": 1,
			"maxLength": 64
		},
		"number": {
			"type": "string",
			"minLength": 1,
			"maxLength": 64
		},
		"serials": {
			"type": "array",
			"maxItems": 1000,
			"items": {
				"type": "object",
				"required": ["serial", "lineId"],
				"additionalProperties": false,
				"properties": {
					"serial": {
						"type": "string",
						"minLength": 1,
						"maxLength": 128
					},
					"lineId": {
						"type": "string",
						"minLength": 1,
						"maxLength": 16
					},
					"itemId": {
						"type": "string",
						"minLength": 1,
						"maxLength": 128
					},
					"variantId": {
						"type": "string",
						"minLength": 1,
						"maxLength": 128
					},
					"sku": {
						"type": "string",
						"minLength": 1,
						"maxLength": 100
					}
				}
			}
		}
	},
	"examples": [
		{
			"orderId": "ord_0123456789abcdefghjkmnpq",
			"number": "000123",
			"serials": [
				{
					"serial": "490154203237518",
					"lineId": "l1",
					"itemId": "itm_1",
					"variantId": "var_1",
					"sku": "PH-1"
				}
			]
		}
	]
}
