{
	"name": "@ss/product-orders",
	"version": "1.0.0",
	"description": "Order Manager (Ecommerce Helper) — SSPS v1 service product: order lifecycle as data, fulfilment and tracking, serials, invoices and print, bulk and CSV, risk, customer updates, payments ledger and inbound orders from any checkout.",
	"type": "module",
	"private": true,
	"license": "UNLICENSED",
	"exports": {
		"./platform": "./adapters/platform.js",
		"./routes": "./api/routes.js",
		"./package.json": "./package.json"
	},
	"engines": {
		"node": ">=22"
	},
	"prettier": "@ss/config/prettier.json",
	"scripts": {
		"dev": "next dev --port 3000",
		"prebuild": "ss app assets .",
		"build": "next build",
		"start": "next start --port 3000",
		"test": "vitest run --coverage",
		"validate": "ss app validate .",
		"check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
		"test:watch": "vitest",
		"lint": "eslint .",
		"typecheck": "tsc -p tsconfig.json",
		"format": "prettier --write .",
		"format:check": "prettier --check ."
	},
	"dependencies": {
		"@ss/app-kit": "workspace:^",
		"@ss/contracts": "workspace:^",
		"@ss/ui": "workspace:^",
		"mongodb": "^6.21.0",
		"next": "^16.3.7",
		"react": "^19.3.0",
		"react-dom": "^19.3.0"
	},
	"devDependencies": {
		"@ss/cli": "workspace:^",
		"@ss/config": "workspace:^",
		"@ss/protocol": "workspace:^",
		"@tailwindcss/postcss": "^4.3.3",
		"@types/node": "^22.20.4",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitest/coverage-v8": "^3.2.7",
		"eslint": "^9.39.5",
		"mongodb-memory-server": "^10.4.3",
		"prettier": "^3.9.9",
		"tailwindcss": "^4.3.3",
		"typescript": "~5.9.3",
		"vitest": "^3.2.7"
	}
}
