{
	"type": "object",
	"title": "Search analytics",
	"additionalProperties": false,
	"properties": {
		"store_queries": {
			"type": "boolean",
			"title": "Count queries",
			"description": "Daily counts per normalised query in your database; no visitor, session or IP is stored.",
			"default": true,
			"x-kind": "flag",
			"x-ui": { "group": "Collection", "order": 1, "widget": "switch" }
		},
		"track_clicks": {
			"type": "boolean",
			"title": "Count result clicks",
			"default": true,
			"x-kind": "flag",
			"x-ui": { "group": "Collection", "order": 2, "widget": "switch" }
		},
		"retention_days": {
			"type": "integer",
			"title": "Keep counts for (days)",
			"default": 90,
			"minimum": 1,
			"maximum": 400,
			"x-kind": "limit",
			"x-plan": { "starter": { "default": 90, "max": 90 }, "pro": { "default": 180, "max": 400 } },
			"x-ui": { "group": "Collection", "order": 3, "widget": "number" }
		},
		"top_limit": {
			"type": "integer",
			"title": "Queries listed in reports",
			"default": 50,
			"minimum": 1,
			"maximum": 200,
			"x-kind": "limit",
			"x-ui": { "group": "Reports", "order": 4, "widget": "number" }
		}
	}
}
