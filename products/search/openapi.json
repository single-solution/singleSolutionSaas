														"type": "string"
													},
													"reason": {
														"type": "string"
													},
													"errors": {
														"type": "array"
													}
												}
											}
										}
									}
								},
								"example": {
									"results": [
										{
											"index": 0,
											"status": "created",
											"id": "doc_0mf2k3x1rabcdefghjkmnpqr"
										}
									]
								}
							}
						}
					},
					"default": {
						"$ref": "#/components/responses/Problem"
					}
				},
				"x-ss-key-kind": "sk"
			}
		},
