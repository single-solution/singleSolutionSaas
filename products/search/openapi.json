{
	"openapi": "3.1.0",
	"info": {
		"title": "Site Search API",
		"version": "1.0.0",
		"description": "Mode C API of Site Search (SSPS v1). The index lives in the merchant's own database. Search runs on MongoDB Atlas Search when the database is on Atlas and the product-managed index is ready, else on the portable engine; both return the same shape. Prices are integer minor units. Times are ISO-8601 UTC. Errors are RFC 9457 problems (`type` ends with a stable code). Document writes refuse a repeated `Idempotency-Key` (same route, within 24 h) with 409 `duplicate_request`; the header is optional. `pk_` keys (browsers, domain-locked) search, get suggestions and count clicks, rate limited per website, never seeing or matching private fields; `sk_` keys (servers) do everything. Every search is metered (unit `query`). Events consumed: item.created@1, item.updated@1, item.deleted@1."
	},
	"servers": [
		{
			"url": "https://search.example.com"
		}
	],
	"security": [
		{
			"websiteKey": []
		}
	],
	"tags": [
		{
			"name": "index"
		},
		{
			"name": "sources"
		},
		{
			"name": "ranking"
		},
		{
			"name": "suggestions"
		},
		{
			"name": "analytics"
		},
		{
			"name": "dashboard"
		},
		{
			"name": "standard"
		}
	],
	"paths": {
		"/v1/search": {
			"get": {
				"operationId": "search",
				"tags": ["index"],
				"summary": "Search the index. pk_ (rate limited per website by index.search_rate_per_minute, public cache headers): private fields are never matched or returned; sk_: every field. Metered per query (unit `query`). Same response whatever engine ran (Atlas Search or the portable engine). Storefront Blocks' search overlay calls this with `q` and `limit`.",
				"parameters": [
					{
						"$ref": "#/components/parameters/Q"
					},
					{
						"$ref": "#/components/parameters/Limit"
					},
					{
						"$ref": "#/components/parameters/Cursor"
					},
					{
						"$ref": "#/components/parameters/Types"
					},
					{
						"$ref": "#/components/parameters/Track"
					}
				],
				"responses": {
					"200": {
						"description": "OK",
						"content": {
							"application/json": {
								"schema": {
									"type": "object",
									"required": [
										"query",
										"items",
										"total",
										"totalIsEstimate",
										"hasMore",
										"nextCursor",
										"engine",
										"relaxed"
									],
									"properties": {
										"query": {
											"type": "string"
										},
										"items": {
											"type": "array",
											"items": {
												"type": "object",
												"required": [
													"id",
													"type",
													"title",
													"description",
													"url",
													"image",
													"price",
													"currency",
													"fields"
												],
												"properties": {
													"id": {
														"type": "string"
													},
													"type": {
														"type": "string",
														"description": "document type key (index.document_types)"
													},
													"title": {
														"type": "string"
													},
													"description": {
														"type": "string"
													},
													"url": {
														"type": ["string", "null"]
													},
													"image": {
														"type": ["string", "null"]
													},
													"price": {
														"type": ["integer", "null"],
														"description": "integer minor units"
													},
													"currency": {
														"type": ["string", "null"],
														"description": "ISO 4217"
													},
													"fields": {
														"type": "object",
														"description": "pk_: display fields that are not private; sk_: every field"
													},
													"boost": {
														"type": "number",
														"description": "sk_ only"
													},
													"source": {
														"type": ["string", "null"],
														"description": "sk_ only: api | catalog | crawl:<key>"
													},
													"updatedAt": {
														"type": ["string", "null"],
														"description": "sk_ only"
													},
													"score": {
														"type": "number",
														"description": "explain only"
													}
												}
											}
										},
										"total": {
											"type": "integer",
											"description": "results reachable by paging (capped by index.max_results)"
										},
										"totalIsEstimate": {
											"type": "boolean",
											"description": "true when the engine's candidate cap was reached"
										},
										"hasMore": {
											"type": "boolean"
										},
										"nextCursor": {
											"type": ["string", "null"]
										},
										"engine": {
											"type": "string",
											"enum": ["atlas", "portable"]
										},
										"relaxed": {
											"type": "boolean",
											"description": "no document matched every word; documents matching some are shown (match_mode all_then_any)"
										}
									}
								},
								"example": {
									"query": "linen",
									"items": [
										{
											"id": "itm_0mf2k3x1rabcdefghjkmnpqr",
											"type": "item",
											"title": "Linen shirt",
											"description": "Breathable linen in five colours.",
											"url": "/items/itm_0mf2k3x1rabcdefghjkmnpqr",
											"image": "https://cdn.shop.example.com/linen.jpg",
											"price": 4900,
											"currency": "EUR",
											"fields": {
												"title": "Linen shirt",
												"brand": "Acme",
												"description": "Breathable linen in five colours.",
												"tags": ["summer"]
											}
										}
									],
									"total": 1,
									"totalIsEstimate": false,
									"hasMore": false,
									"nextCursor": null,
									"engine": "portable",
									"relaxed": false
								}
							}
						}
					},
					"default": {
						"$ref": "#/components/responses/Problem"
					}
				}
			}
		},
		"/v1/documents": {
