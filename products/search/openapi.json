					}
				},
				"x-ss-key-kind": "sk"
			},
			"post": {
				"operationId": "upsertDocument",
				"tags": ["index"],
				"summary": "Create (201) or replace (200) a document of any type. Needs the sources element with sources.api_upserts. Counts against index.max_documents (409 limit_reached) and the daily index.upserts_per_day quota (429 quota_exhausted).",
				"parameters": [
					{
						"$ref": "#/components/parameters/IdempotencyKey"
					}
				],
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"type": "object",
								"required": ["type"],
								"properties": {
									"id": {
										"type": "string",
										"pattern": "^[A-Za-z0-9][A-Za-z0-9._:~-]{0,127}$",
										"description": "generated (doc_…) when omitted; an existing id replaces the document"
									},
									"type": {
										"type": "string"
									},
									"url": {
										"type": ["string", "null"],
										"description": "https URL or site-relative path"
									},
									"image": {
										"type": ["string", "null"]
									},
									"price": {
										"type": ["integer", "null"],
										"minimum": 0
									},
									"currency": {
										"type": ["string", "null"],
										"pattern": "^[A-Z]{3}$"
									},
									"boost": {
										"type": "number",
										"minimum": 0,
										"maximum": 1000000
									},
									"fields": {
										"type": "object",
										"description": "the type's fields: strings, numbers, booleans, lists of those, or a flat attribute map; undeclared fields are ignored (listed in ignoredFields)"
									}
								}
							},
							"example": {
