	"components": {
		"securitySchemes": {
			"websiteKey": {
				"type": "http",
				"scheme": "bearer",
				"description": "pk_ (browser, domain-locked) or sk_ (server) website key"
			},
			"portalSignature": {
				"type": "apiKey",
				"in": "header",
				"name": "SS-Signature",
				"description": "Portal-signed request (ss-request.v1)"
			},
			"session": {
				"type": "apiKey",
				"in": "cookie",
				"name": "ss_session",
				"description": "dashboard session from GET /sso?launch="
			}
		},
		"parameters": {
			"IdempotencyKey": {
				"name": "Idempotency-Key",
				"in": "header",
				"required": false,
				"schema": {
					"type": "string",
					"maxLength": 255
				},
				"description": "Optional. On routes that create records, a key already used for the same route within 24 h answers 409 duplicate_request."
			},
			"Q": {
				"name": "q",
				"in": "query",
				"required": false,
				"schema": {
					"type": "string",
					"maxLength": 2000
				},
				"description": "The query as typed (normalised; a trailing space ends prefix matching of the last word)."
			},
			"Limit": {
				"name": "limit",
				"in": "query",
				"required": false,
				"schema": {
					"type": "integer",
					"minimum": 1,
					"maximum": 100
				},
				"description": "Page size (1 to index.max_page_size; default 10, 20 for documents)."
			},
			"Cursor": {
				"name": "cursor",
				"in": "query",
				"required": false,
				"schema": {
					"type": "string"
				},
				"description": "Opaque cursor from nextCursor."
			},
			"Types": {
				"name": "types",
				"in": "query",
				"required": false,
				"schema": {
					"type": "string"
				},
				"description": "Comma-separated document types (default: every type)."
			},
			"Track": {
				"name": "track",
				"in": "query",
				"required": false,
				"schema": {
					"type": "string"
				},
				"description": "`0` or `false`: do not count this search in analytics."
			},
			"FilterType": {
				"name": "type",
				"in": "query",
				"required": false,
				"schema": {
					"type": "string"
				},
				"description": "Only this document type."
			},
			"FilterSource": {
				"name": "source",
				"in": "query",
				"required": false,
				"schema": {
					"type": "string"
				},
				"description": "Only this source (api, catalog, crawl:<key>)."
			},
			"Id": {
				"name": "id",
				"in": "path",
				"required": true,
				"schema": {
					"type": "string"
				},
				"description": "Document id."
			},
			"SourceKey": {
				"name": "key",
				"in": "path",
				"required": true,
				"schema": {
					"type": "string"
				},
				"description": "Crawled source key."
			},
			"Refresh": {
				"name": "refresh",
				"in": "query",
				"required": false,
				"schema": {
					"type": "string",
					"enum": ["true", "false"]
				},
				"description": "`true`: probe Atlas Search now."
			},
			"Days": {
				"name": "days",
				"in": "query",
				"required": false,
				"schema": {
					"type": "integer",
					"minimum": 1,
					"maximum": 400
				},
				"description": "Window in days (1 to analytics.retention_days; default 30)."
			}
		},
		"responses": {
			"Problem": {
				"description": "RFC 9457 problem",
				"content": {
					"application/problem+json": {
						"schema": {
							"type": "object",
							"properties": {
								"type": {
									"type": "string"
								},
								"title": {
									"type": "string"
								},
								"status": {
									"type": "integer"
								},
								"detail": {
									"type": "string"
								},
								"instance": {
									"type": "string"
								},
								"requestId": {
									"type": "string"
								},
								"errors": {
									"type": "array",
									"items": {
										"type": "object",
										"properties": {
											"path": {
												"type": "string"
											},
											"code": {
												"type": "string"
											},
											"message": {
												"type": "string"
											}
										}
									}
								}
							}
						}
					}
				}
			}
		}
	}
}
