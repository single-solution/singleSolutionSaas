{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "coupons.released@1",
	"description": "A reservation or redemption gave its uses back: released by the checkout, expired, or undone by an order cancellation or refund. One event per code.",
	"type": "object",
	"required": ["reservationId", "couponId", "code", "reason", "wasRedeemed"],
	"additionalProperties": false,
	"properties": {
		"reservationId": { "type": "string", "minLength": 1, "maxLength": 64 },
		"couponId": { "type": "string", "minLength": 1, "maxLength": 64 },
		"code": { "type": "string", "minLength": 1, "maxLength": 64 },
		"orderId": { "type": "string", "minLength": 1, "maxLength": 128 },
		"reason": { "type": "string", "enum": ["released", "expired", "order_cancelled", "order_refunded"] },
		"wasRedeemed": { "type": "boolean" }
	},
	"examples": [
		{ "reservationId": "rsv_0abc", "couponId": "cpn_0abc", "code": "FALL-K7QM", "reason": "expired", "wasRedeemed": false }
	]
}
