{
	"type": "object",
	"title": "Stacking",
	"additionalProperties": false,
	"properties": {
		"max_coupons_per_cart": {
			"type": "integer",
			"title": "Maximum coupons per cart",
			"default": 2,
			"minimum": 1,
			"maximum": 10,
			"x-kind": "limit",
			"x-plan": { "starter": { "default": 2, "max": 3 }, "pro": { "default": 2, "max": 10 } },
			"x-ui": { "widget": "number", "group": "Policy", "order": 1 }
		},
		"classes": {
			"type": "array",
			"title": "Stacking classes",
			"description": "Applied in this order; a coupon combines with another when either class lists the other in combines_with.",
			"default": [
				{ "key": "item", "name": "Item discounts", "combines_with": ["order", "shipping"] },
				{ "key": "order", "name": "Order discounts", "combines_with": ["item", "shipping"] },
				{ "key": "shipping", "name": "Shipping", "combines_with": ["item", "order"] }
			],
			"minItems": 1,
			"maxItems": 10,
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": ["key"],
				"properties": {
					"key": { "type": "string", "title": "Key", "minLength": 1, "maxLength": 32, "pattern": "^[a-z][a-z0-9_]*$" },
					"name": { "type": "string", "title": "Name", "maxLength": 80 },
					"combines_with": {
						"type": "array",
						"title": "Combines with",
						"maxItems": 10,
						"uniqueItems": true,
						"items": { "type": "string", "maxLength": 32, "pattern": "^[a-z][a-z0-9_]*$" }
					}
				}
			},
			"x-kind": "config",
			"x-ui": { "widget": "list", "group": "Policy", "order": 2 }
		},
		"default_class": {
			"type": "string",
			"title": "Class of coupons without one",
			"default": "order",
			"minLength": 1,
			"maxLength": 32,
			"pattern": "^[a-z][a-z0-9_]*$",
			"x-kind": "config",
			"x-ui": { "widget": "text", "group": "Policy", "order": 3 }
		},
		"allow_same_class": {
			"type": "boolean",
			"title": "Allow two coupons of the same class",
			"default": false,
			"x-kind": "flag",
			"x-ui": { "widget": "switch", "group": "Policy", "order": 4 }
		},
		"strategy": {
			"type": "string",
			"title": "Selection strategy",
			"description": "in_order: codes in the order entered; best_discount: the most valuable codes first.",
			"default": "best_discount",
			"enum": ["in_order", "best_discount"],
			"x-kind": "config",
			"x-experiment": true,
			"x-ui": { "widget": "select", "group": "Policy", "order": 5 }
		},
		"default_with_loyalty": {
			"type": "boolean",
			"title": "Coupons allow loyalty points by default",
			"description": "Reported as loyaltyAllowed on quotes and reservations so the checkout (or the Loyalty product) can decide.",
			"default": true,
			"x-kind": "flag",
			"x-ui": { "widget": "switch", "group": "Other offers", "order": 6 }
		},
		"default_with_deals": {
			"type": "boolean",
			"title": "Coupons allow automatic deals by default",
			"description": "Reported as dealsAllowed on quotes and reservations.",
			"default": true,
			"x-kind": "flag",
			"x-ui": { "widget": "switch", "group": "Other offers", "order": 7 }
		}
	}
}
