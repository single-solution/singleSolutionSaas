{
	"type": "object",
	"title": "Coupon codes",
	"additionalProperties": false,
	"properties": {
		"time_zone": {
			"type": "string",
			"title": "Time zone",
			"description": "IANA zone used for validity windows (weekday and time-of-day) unless a coupon sets its own.",
			"default": "UTC",
			"minLength": 1,
			"maxLength": 64,
			"pattern": "^[A-Za-z_]+(?:/[A-Za-z0-9_+-]+)*$",
			"x-kind": "config",
			"x-ui": { "widget": "text", "group": "General", "order": 1 }
		},
		"alphabet": {
			"type": "string",
			"title": "Alphabet of generated codes",
			"description": "Characters `?` positions draw from (unique letters and digits). The default leaves out look-alikes (0/O, 1/I/L).",
			"default": "ABCDEFGHJKMNPQRSTUVWXYZ23456789",
			"minLength": 10,
			"maxLength": 64,
			"pattern": "^[A-Za-z0-9]+$",
			"x-kind": "config",
			"x-ui": { "widget": "text", "group": "Generation", "order": 2 }
		},
		"default_pattern": {
			"type": "string",
			"title": "Default code pattern",
			"description": "`?` = random character, `#` = random digit, letters, digits, `-` and `_` are kept as typed.",
			"default": "????-????",
			"minLength": 1,
			"maxLength": 64,
			"pattern": "^[A-Za-z0-9_?#-]+$",
			"x-kind": "config",
			"x-ui": { "widget": "text", "group": "Generation", "order": 3 }
		},
		"min_random_chars": {
			"type": "integer",
			"title": "Minimum random positions per generated code",
			"description": "Generated codes need at least this many `?` / `#` positions, so they cannot be guessed.",
			"default": 6,
			"minimum": 4,
			"maximum": 32,
			"x-kind": "limit",
			"x-ui": { "widget": "number", "group": "Generation", "order": 4 }
		},
		"case_sensitive": {
			"type": "boolean",
			"title": "Case-sensitive codes",
			"description": "Off: codes are matched case-insensitively (stored upper-case).",
			"default": false,
			"x-kind": "flag",
			"x-ui": { "widget": "switch", "group": "General", "order": 5 }
		},
		"min_code_length": {
			"type": "integer",
			"title": "Minimum code length",
			"default": 4,
			"minimum": 3,
			"maximum": 32,
			"x-kind": "limit",
			"x-ui": { "widget": "number", "group": "General", "order": 6 }
		},
		"max_code_length": {
			"type": "integer",
			"title": "Maximum code length",
			"default": 32,
			"minimum": 4,
			"maximum": 64,
			"x-kind": "limit",
			"x-ui": { "widget": "number", "group": "General", "order": 7 }
		},
		"max_active_coupons": {
			"type": "integer",
			"title": "Maximum coupons (not archived)",
			"default": 1000,
			"minimum": 1,
			"maximum": 1000000,
			"x-kind": "limit",
			"x-plan": { "starter": { "default": 100, "max": 500 }, "pro": { "default": 5000, "max": 1000000 } },
			"x-ui": { "widget": "number", "group": "Limits", "order": 8 }
		},
		"max_codes_per_batch": {
			"type": "integer",
			"title": "Maximum codes per bulk generation",
			"default": 1000,
			"minimum": 1,
			"maximum": 50000,
			"x-kind": "limit",
			"x-plan": { "starter": { "default": 1000, "max": 5000 }, "pro": { "default": 10000, "max": 50000 } },
			"x-ui": { "widget": "number", "group": "Limits", "order": 9 }
		},
		"auto_apply_param": {
			"type": "string",
			"title": "Auto-apply query parameter",
			"description": "Links like https://your-site/?coupon=CODE apply the code automatically (share links, QR codes, the apply box).",
			"default": "coupon",
			"minLength": 1,
			"maxLength": 32,
			"pattern": "^[a-z][a-z0-9_]*$",
			"x-kind": "config",
			"x-ui": { "widget": "text", "group": "Links", "order": 10 }
		}
	}
}
