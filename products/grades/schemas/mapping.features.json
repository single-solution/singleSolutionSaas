{
	"type": "object",
	"title": "Mapping",
	"additionalProperties": false,
	"properties": {
		"vocabularies": {
			"type": "array",
			"title": "External vocabularies",
			"description": "Each vocabulary maps your tiers to the values another system understands: structured data, shopping feeds, marketplaces. `allowed` lists the values the target accepts (empty = any); tiers without a mapping use `fallback`. Edit the shipped ones or add your own.",
			"default": [
				{
					"key": "schema_org",
					"name": "schema.org itemCondition",
					"target": "structured_data",
					"property": "itemCondition",
					"allowed": [
						"https://schema.org/NewCondition",
						"https://schema.org/RefurbishedCondition",
						"https://schema.org/UsedCondition",
						"https://schema.org/DamagedCondition"
					],
					"fallback": "https://schema.org/UsedCondition",
					"values": [{ "tier": "new", "value": "https://schema.org/NewCondition" }],
					"display": false
				},
				{
					"key": "shopping_feed",
					"name": "Shopping feed condition",
					"target": "feed",
					"property": "condition",
					"allowed": ["new", "refurbished", "used"],
					"fallback": "used",
					"values": [{ "tier": "new", "value": "new" }],
					"display": true
				}
			],
			"minItems": 0,
			"maxItems": 20,
			"x-kind": "config",
			"x-plan": { "starter": { "max": 4 }, "pro": { "max": 20 } },
			"x-ui": { "widget": "list", "group": "Vocabularies", "order": 1 },
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": ["key", "name", "target", "property"],
				"properties": {
					"key": { "type": "string", "title": "Key", "minLength": 1, "maxLength": 40, "pattern": "^[a-z][a-z0-9_]*$" },
					"name": { "type": "string", "title": "Name", "minLength": 1, "maxLength": 80 },
					"target": {
						"type": "string",
						"title": "Used for",
						"enum": ["structured_data", "feed", "marketplace", "other"]
					},
					"property": {
						"type": "string",
						"title": "Property or field name",
						"minLength": 1,
						"maxLength": 64,
						"pattern": "^[A-Za-z][A-Za-z0-9_:.-]*$"
					},
					"allowed": {
						"type": "array",
						"title": "Allowed values (empty = any)",
						"maxItems": 50,
						"uniqueItems": true,
						"items": { "type": "string", "minLength": 1, "maxLength": 200 }
					},
					"fallback": { "type": "string", "title": "Value for unmapped tiers", "maxLength": 200 },
					"values": {
						"type": "array",
						"title": "Tier → value",
						"maxItems": 20,
						"items": {
							"type": "object",
							"additionalProperties": false,
							"required": ["tier", "value"],
							"properties": {
								"tier": {
									"type": "string",
									"title": "Tier key",
									"minLength": 1,
									"maxLength": 40,
									"pattern": "^[a-z][a-z0-9_]*$"
								},
								"value": { "type": "string", "title": "Value", "minLength": 1, "maxLength": 200 }
							}
						}
					},
					"display": { "type": "boolean", "title": "Show in the drop-in condition block" }
				}
			}
		},
		"cache_seconds": {
			"type": "integer",
			"title": "Browser cache (seconds)",
			"default": 600,
			"minimum": 0,
			"maximum": 86400,
			"x-kind": "config",
			"x-ui": { "widget": "number", "group": "Performance", "order": 2 }
		}
	}
}
