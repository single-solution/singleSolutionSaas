				"x-ss-permission": "analytics.read",
				"security": [
					{
						"ticket": []
					}
				],
				"parameters": [],
				"responses": {
					"2XX": {
						"description": "Success (JSON)"
					},
					"default": {
						"description": "Problem (RFC 9457) with a stable code",
						"content": {
							"application/problem+json": {
								"schema": {
									"$ref": "#/components/schemas/Problem"
								}
							}
						}
					}
				}
			}
		},
