{
	"name": "@ss/product-growth",
	"version": "0.1.0",
	"description": "Growth: tracking pixels, cookie consent, conversion events, first-party analytics, notice bar and site-wide SEO (robots, verification, IndexNow, SEO checklist) for the merchant's website (PLAN 0.8.9).",
	"type": "module",
	"private": true,
	"license": "UNLICENSED",
	"exports": {
		"./product": "./adapters/product.js",
		"./routes": "./api/routes.js",
		"./package.json": "./package.json"
	},
	"engines": {
		"node": ">=22"
	},
	"prettier": "@ss/config/prettier.json",
	"scripts": {
		"dev": "ss app assets . && next dev --port 3000",
		"build": "ss app assets . && next build",
		"start": "next start --port 3000",
		"check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
		"test": "vitest run --coverage",
		"lint": "eslint .",
		"typecheck": "tsc -p tsconfig.json",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"validate": "ss app validate ."
	},
	"dependencies": {
		"@ss/app-kit": "workspace:^",
		"@ss/contracts": "workspace:^",
		"@ss/net": "workspace:^",
		"@ss/protocol": "workspace:^",
		"@ss/ui": "workspace:^",
		"mongodb": "^6.21.0",
		"next": "^16.3.7",
		"react": "^19.3.0",
		"react-dom": "^19.3.0"
	},
	"devDependencies": {
		"@ss/cli": "workspace:^",
		"@ss/config": "workspace:^",
		"@tailwindcss/postcss": "^4.3.3",
		"@types/node": "^22.20.4",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitest/coverage-v8": "^3.2.7",
		"eslint": "^9.39.5",
		"jsdom": "^26.1.0",
		"mongodb-memory-server": "^11.3.0",
		"prettier": "^3.9.9",
		"tailwindcss": "^4.3.3",
		"typescript": "~5.9.3",
		"vitest": "^3.2.7"
	}
}
