{
	"openapi": "3.1.0",
	"info": {
		"title": "Wishlist API",
		"version": "1.0.0",
		"description": "Mode C API of Wishlist (SSPS v1). Browser (pk_) calls act for the customer of the website's own login (SS-Identity) or for a guest (`guest` token in the body); server (sk_) calls act merchant-wide or for the customer they name (`customerId`). Every list lives in the merchant's own database."
	},
	"servers": [{ "url": "https://wishlist.example.com" }],
	"security": [{ "websiteKey": [] }],
	"paths": {
		"/v1/lists": {
			"get": {
				"operationId": "listLists",
				"summary": "Lists, newest first (cursor pagination)",
				"description": "pk_ + SS-Identity: the customer's own lists. sk_: every list of the website, or `customerId`'s. Guests read their lists with POST /v1/wishlist.",
				"x-ss-certify": true,
				"parameters": [
					{ "$ref": "#/components/parameters/customerId" },
					{ "$ref": "#/components/parameters/cursor" },
					{ "$ref": "#/components/parameters/limit" }
				],
				"responses": {
					"200": {
						"description": "A page of lists (without items)",
						"content": {
							"application/json": {
								"schema": { "$ref": "#/components/schemas/ListPage" },
								"example": {
									"items": [
										{
											"id": "wl_0123456789abcdefghjkmnpq",
											"name": "Wishlist",
											"isDefault": true,
											"itemCount": 2,
											"notify": false,
											"shared": false,
											"owner": { "kind": "customer", "id": "cus_42" },
											"createdAt": "2026-10-01T10:00:00.000Z",
											"updatedAt": "2026-10-01T10:05:00.000Z"
										}
									],
									"nextCursor": null,
									"hasMore": false
								}
							}
						}
					},
					"default": { "$ref": "#/components/responses/Problem" }
				}
			},
			"post": {
				"operationId": "createList",
				"summary": "Create a named list (the owner's first list becomes their default list)",
				"parameters": [{ "$ref": "#/components/parameters/idempotencyKey" }],
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"type": "object",
								"required": ["name"],
								"properties": {
									"name": { "type": "string", "maxLength": 120 },
									"customerId": { "type": "string", "description": "sk_ only: the customer the list is for" },
									"guest": { "type": "string", "description": "pk_ guests: the guest token" }
								}
							},
							"example": { "customerId": "cus_certify", "name": "Gift ideas" }
						}
					}
				},
				"responses": {
					"201": {
						"description": "Created",
						"content": {
							"application/json": {
								"schema": { "$ref": "#/components/schemas/ListWithItems" },
								"example": {
									"id": "wl_1123456789abcdefghjkmnpq",
									"name": "Gift ideas",
									"isDefault": false,
									"itemCount": 0,
									"notify": false,
									"shared": false,
									"owner": { "kind": "customer" },
									"createdAt": "2026-10-01T10:00:00.000Z",
									"updatedAt": "2026-10-01T10:00:00.000Z",
									"items": []
								}
							}
						}
					},
					"default": { "$ref": "#/components/responses/Problem" }
				}
			}
		},
		"/v1/lists/{id}": {
			"parameters": [{ "$ref": "#/components/parameters/listId" }],
			"get": {
				"operationId": "getList",
				"summary": "One list with its items (`default` = the owner's default list)",
				"parameters": [{ "$ref": "#/components/parameters/customerId" }],
				"responses": {
					"200": {
						"description": "OK",
						"content": {
							"application/json": {
								"schema": { "$ref": "#/components/schemas/ListWithItems" },
								"example": {
									"id": "wl_0123456789abcdefghjkmnpq",
									"name": "Wishlist",
									"isDefault": true,
									"itemCount": 1,
									"notify": true,
									"shared": false,
									"owner": { "kind": "customer" },
									"createdAt": "2026-10-01T10:00:00.000Z",
									"updatedAt": "2026-10-01T10:05:00.000Z",
									"items": [
										{
											"id": "wli_0123456789abcdefghjkmnpq",
											"itemId": "itm_42",
											"variantId": null,
											"title": "Linen shirt",
											"image": "https://cdn.example.com/linen.jpg",
											"url": "https://shop.example.com/p/linen-shirt",
											"price": { "amount": 4900, "currency": "EUR" },
											"savedPrice": { "amount": 4900, "currency": "EUR" },
											"inStock": true,
											"addedAt": "2026-10-01T10:05:00.000Z"
										}
									]
								}
							}
						}
					},
					"default": { "$ref": "#/components/responses/Problem" }
				}
			},
			"patch": {
				"operationId": "updateList",
				"summary": "Rename a list, or opt in / out of price-drop and back-in-stock signals (customers only)",
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"type": "object",
								"properties": {
									"name": { "type": "string", "maxLength": 120 },
									"notify": { "type": "boolean" },
									"customerId": { "type": "string" },
									"guest": { "type": "string" }
								}
							},
							"example": { "notify": true }
						}
					}
				},
				"responses": {
					"200": {
						"description": "Updated",
						"content": {
							"application/json": {
								"schema": { "$ref": "#/components/schemas/ListWithItems" },
								"example": {
									"id": "wl_0123456789abcdefghjkmnpq",
									"name": "Wishlist",
									"isDefault": true,
									"itemCount": 0,
									"notify": true,
									"shared": false,
									"owner": { "kind": "customer" },
									"createdAt": "2026-10-01T10:00:00.000Z",
									"updatedAt": "2026-10-01T10:06:00.000Z",
									"items": []
								}
							}
						}
					},
					"default": { "$ref": "#/components/responses/Problem" }
				}
			},
			"delete": {
				"operationId": "deleteList",
				"summary": "Delete a list (the oldest remaining list becomes the default list)",
				"requestBody": {
					"required": false,
					"content": {
						"application/json": {
							"schema": { "$ref": "#/components/schemas/Actor" },
							"example": { "guest": "wg1.eyJ3Ijoid2ViXzAxIn0.c2ln" }
						}
					}
				},
				"responses": {
					"200": {
						"description": "Deleted",
						"content": {
							"application/json": {
								"schema": {
									"type": "object",
									"required": ["id", "deleted"],
									"properties": { "id": { "type": "string" }, "deleted": { "type": "boolean" } }
								},
								"example": { "id": "wl_0123456789abcdefghjkmnpq", "deleted": true }
							}
						}
					},
					"default": { "$ref": "#/components/responses/Problem" }
				}
			}
		},
		"/v1/lists/{id}/items": {
			"parameters": [{ "$ref": "#/components/parameters/listId" }],
			"post": {
				"operationId": "addItem",
				"summary": "Save an item (`default` creates the owner's default list on first use)",
				"description": "Any kind of item: the merchant's id plus a snapshot. An item already on the list keeps its place and saved price (200); a new one answers 201. A full list evicts its oldest item or refuses (lists.when_full).",
				"parameters": [{ "$ref": "#/components/parameters/idempotencyKey" }],
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": { "$ref": "#/components/schemas/ItemInput" },
							"example": {
								"itemId": "itm_42",
								"title": "Linen shirt",
								"image": "https://cdn.example.com/linen.jpg",
								"url": "https://shop.example.com/p/linen-shirt",
								"price": { "amount": 4900, "currency": "EUR" }
							}
						}
					}
				},
				"responses": {
					"200": { "$ref": "#/components/responses/EntryChange" },
					"201": { "$ref": "#/components/responses/EntryChange" },
					"default": { "$ref": "#/components/responses/Problem" }
				}
			}
		},
		"/v1/lists/{id}/items/{entryId}": {
			"parameters": [
				{ "$ref": "#/components/parameters/listId" },
				{ "name": "entryId", "in": "path", "required": true, "schema": { "type": "string" } }
			],
			"delete": {
				"operationId": "removeItem",
				"summary": "Remove a saved item",
				"requestBody": {
					"required": false,
					"content": {
						"application/json": {
							"schema": { "$ref": "#/components/schemas/Actor" },
							"example": { "guest": "wg1.eyJ3Ijoid2ViXzAxIn0.c2ln" }
						}
					}
				},
				"responses": {
					"200": { "$ref": "#/components/responses/EntryChange" },
					"default": { "$ref": "#/components/responses/Problem" }
				}
			}
		},
		"/v1/guests": {
			"post": {
				"operationId": "createGuest",
				"summary": "A signed guest token for a visitor who is not signed in (no personal data)",
				"parameters": [{ "$ref": "#/components/parameters/idempotencyKey" }],
				"requestBody": {
					"required": false,
					"content": { "application/json": { "schema": { "type": "object" }, "example": {} } }
				},
				"responses": {
					"201": {
						"description": "Issued",
						"content": {
							"application/json": {
								"schema": { "$ref": "#/components/schemas/GuestToken" },
								"example": { "token": "wg1.eyJ3Ijoid2ViXzAxIn0.c2ln", "expiresAt": "2026-10-31T10:00:00.000Z" }
							}
						}
					},
					"default": { "$ref": "#/components/responses/Problem" }
				}
			}
		},
		"/v1/guests:merge": {
			"post": {
				"operationId": "mergeGuest",
				"summary": "Merge a guest's lists into the signed-in customer's lists (SS-Identity, or sk_ with customerId)",
				"parameters": [{ "$ref": "#/components/parameters/idempotencyKey" }],
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"type": "object",
								"required": ["guest"],
								"properties": { "guest": { "type": "string" }, "customerId": { "type": "string" } }
							},
							"example": { "guest": "wg1.eyJ3Ijoid2ViXzAxIn0.c2ln" }
						}
					}
				},
				"responses": {
					"200": {
						"description": "Merged (0 when nothing was left to merge)",
						"content": {
							"application/json": {
								"schema": {
									"type": "object",
									"required": ["merged", "lists"],
									"properties": { "merged": { "type": "integer" }, "lists": { "type": "integer" } }
								},
								"example": { "merged": 3, "lists": 0 }
							}
						}
					},
					"default": { "$ref": "#/components/responses/Problem" }
				}
			}
		},
		"/v1/shares": {
			"post": {
				"operationId": "createShare",
				"summary": "Create (or rotate) the read-only share link of a list",
				"parameters": [{ "$ref": "#/components/parameters/idempotencyKey" }],
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"type": "object",
								"required": ["listId"],
								"properties": {
									"listId": { "type": "string" },
									"customerId": { "type": "string" },
									"guest": { "type": "string" }
								}
							},
							"example": { "listId": "wl_0123456789abcdefghjkmnpq" }
						}
					}
				},
				"responses": {
					"201": {
						"description": "Created; earlier links of the list stop working",
						"content": {
							"application/json": {
								"schema": { "$ref": "#/components/schemas/Share" },
								"example": {
									"listId": "wl_0123456789abcdefghjkmnpq",
									"token": "0123456789abcdefghjkmnpqrs",
									"url": "https://shop.example.com/wishlist/shared?t=0123456789abcdefghjkmnpqrs",
									"createdAt": "2026-10-01T10:00:00.000Z",
									"expiresAt": null
								}
							}
						}
					},
					"default": { "$ref": "#/components/responses/Problem" }
				}
			}
		},
		"/v1/shares:revoke": {
			"post": {
				"operationId": "revokeShare",
				"summary": "Revoke the share link of a list (safe to repeat)",
				"parameters": [{ "$ref": "#/components/parameters/idempotencyKey" }],
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"type": "object",
								"required": ["listId"],
								"properties": {
									"listId": { "type": "string" },
									"customerId": { "type": "string" },
									"guest": { "type": "string" }
								}
							},
							"example": { "listId": "wl_0123456789abcdefghjkmnpq" }
						}
					}
				},
				"responses": {
					"200": {
						"description": "Revoked",
						"content": {
							"application/json": {
								"schema": {
									"type": "object",
									"required": ["listId", "shared"],
									"properties": { "listId": { "type": "string" }, "shared": { "type": "boolean" } }
								},
								"example": { "listId": "wl_0123456789abcdefghjkmnpq", "shared": false }
							}
						}
					},
					"default": { "$ref": "#/components/responses/Problem" }
				}
			}
		},
		"/v1/shares/{token}": {
			"get": {
				"operationId": "getShared",
				"summary": "The read-only view behind a share link (no owner, no ids of the list)",
				"parameters": [{ "name": "token", "in": "path", "required": true, "schema": { "type": "string" } }],
				"responses": {
					"200": {
						"description": "OK",
						"content": {
							"application/json": {
								"schema": { "$ref": "#/components/schemas/SharedList" },
								"example": {
									"name": "Birthday",
									"itemCount": 1,
									"items": [
										{
											"itemId": "itm_42",
											"variantId": null,
											"title": "Linen shirt",
											"image": null,
											"url": "https://shop.example.com/p/linen-shirt",
											"price": { "amount": 4900, "currency": "EUR" },
											"inStock": null
										}
									]
								}
							}
						}
					},
					"default": { "$ref": "#/components/responses/Problem" }
				}
			}
		},
		"/v1/notifications": {
			"get": {
				"operationId": "listNotifications",
				"summary": "Signals published for opted-in customers, newest first (server keys)",
				"x-ss-key-kind": "sk",
				"parameters": [{ "$ref": "#/components/parameters/cursor" }, { "$ref": "#/components/parameters/limit" }],
				"responses": {
					"200": {
						"description": "A page of signals",
						"content": {
							"application/json": {
								"schema": {
									"type": "object",
									"required": ["items", "hasMore"],
									"properties": {
										"items": { "type": "array", "items": { "$ref": "#/components/schemas/Notification" } },
										"nextCursor": { "type": ["string", "null"] },
										"hasMore": { "type": "boolean" }
									}
								},
								"example": {
									"items": [
										{
											"id": "wln_0123456789abcdefghjkmnpq",
											"kind": "price_dropped",
											"itemId": "itm_42",
											"variantId": null,
											"customer": { "subject": "cus_42" },
											"listIds": ["wl_0123456789abcdefghjkmnpq"],
											"eventId": "evt_0123456789abcdefghjkmnpq",
											"at": "2026-10-01T10:00:00.000Z"
										}
									],
									"nextCursor": null,
									"hasMore": false
								}
							}
						}
					},
					"default": { "$ref": "#/components/responses/Problem" }
				}
			}
		},
		"/v1/wishlist": {
			"post": {
				"operationId": "wishlistState",
				"summary": "Everything the widgets need in one call (no state change except guest tokens and merges)",
				"description": "A signed-in shopper who still holds a guest token gets the guest lists merged (`merged`, `dropGuest: true`); a new visitor gets a guest token when guest lists are on; a guest token past half its life is renewed.",
				"requestBody": {
					"required": false,
					"content": {
						"application/json": {
							"schema": { "$ref": "#/components/schemas/Actor" },
							"example": { "guest": "wg1.eyJ3Ijoid2ViXzAxIn0.c2ln" }
						}
					}
				},
				"responses": {
					"200": {
						"description": "OK",
						"content": {
							"application/json": {
								"schema": { "$ref": "#/components/schemas/WishlistState" },
								"example": {
									"owner": { "kind": "guest" },
									"guest": { "token": "wg1.eyJ3Ijoid2ViXzAxIn0.c2ln", "expiresAt": "2026-10-31T10:00:00.000Z" },
									"dropGuest": false,
									"merged": 0,
									"lists": [],
									"settings": {
										"maxLists": 5,
										"maxItems": 100,
										"guests": true,
										"storage": "local",
										"consentCategory": "preferences",
										"share": false,
										"notify": false,
										"manageLists": true,
										"layout": "grid",
										"announce": true
									}
								}
							}
						}
					},
					"default": { "$ref": "#/components/responses/Problem" }
				}
			}
		},
		"/v1/dashboard/overview": {
			"get": {
				"operationId": "dashboardOverview",
				"summary": "Dashboard counts and the most saved items (SSO session)",
				"security": [{ "session": [] }],
				"responses": {
					"200": {
						"description": "OK",
						"content": {
							"application/json": {
								"schema": { "type": "object" },
								"example": {
									"stats": { "lists": 3, "customerLists": 2, "guestLists": 1, "items": 7, "optedIn": 1, "shared": 1 },
									"topItems": [{ "itemId": "itm_42", "title": "Linen shirt", "saves": 2 }]
								}
							}
						}
					},
					"default": { "$ref": "#/components/responses/Problem" }
				}
			}
		},
		"/v1/session": {
			"get": {
				"operationId": "getSession",
				"summary": "The dashboard session (SSO launch)",
				"security": [{ "session": [] }],
				"responses": {
					"200": {
						"description": "OK",
						"content": {
							"application/json": {
								"schema": { "type": "object" },
								"example": { "kind": "merchant", "role": "owner", "scope": {}, "user": "usr_1", "actor": null }
							}
						}
					},
					"default": { "$ref": "#/components/responses/Problem" }
				}
			}
		}
	},
	"components": {
		"securitySchemes": {
			"websiteKey": {
				"type": "http",
				"scheme": "bearer",
				"description": "pk_ (browser, domain-locked) or sk_ (server) website key; browsers add the customer's login token as SS-Identity"
			},
			"session": { "type": "apiKey", "in": "cookie", "name": "ss_session" }
		},
		"parameters": {
			"listId": {
				"name": "id",
				"in": "path",
				"required": true,
				"description": "A list id, or `default` for the owner's default list",
				"schema": { "type": "string" }
			},
			"customerId": {
				"name": "customerId",
				"in": "query",
				"required": false,
				"description": "sk_ only: the customer to act for",
				"schema": { "type": "string" }
			},
			"cursor": { "name": "cursor", "in": "query", "required": false, "schema": { "type": "string" } },
			"limit": {
				"name": "limit",
				"in": "query",
				"required": false,
				"schema": { "type": "integer", "minimum": 1, "maximum": 100 }
			},
			"idempotencyKey": { "name": "Idempotency-Key", "in": "header", "required": true, "schema": { "type": "string" } }
		},
		"schemas": {
			"Money": {
				"type": "object",
				"required": ["amount", "currency"],
				"properties": {
					"amount": { "type": "integer", "minimum": 0 },
					"currency": { "type": "string", "pattern": "^[A-Z]{3}$" }
				}
			},
			"Actor": {
				"type": "object",
				"properties": {
					"guest": { "type": "string", "description": "pk_ guests: the guest token" },
					"customerId": { "type": "string", "description": "sk_ only" }
				}
			},
			"ItemInput": {
				"type": "object",
				"required": ["itemId"],
				"properties": {
					"itemId": { "type": "string", "maxLength": 128 },
					"variantId": { "type": ["string", "null"], "maxLength": 128 },
					"title": { "type": "string", "maxLength": 200 },
					"image": { "type": "string", "format": "uri" },
					"url": { "type": "string", "format": "uri" },
					"price": { "$ref": "#/components/schemas/Money" },
					"customerId": { "type": "string" },
					"guest": { "type": "string" }
				}
			},
			"Entry": {
				"type": "object",
				"required": ["id", "itemId", "addedAt"],
				"properties": {
					"id": { "type": "string" },
					"itemId": { "type": "string" },
					"variantId": { "type": ["string", "null"] },
					"title": { "type": ["string", "null"] },
					"image": { "type": ["string", "null"] },
					"url": { "type": ["string", "null"] },
					"price": { "oneOf": [{ "$ref": "#/components/schemas/Money" }, { "type": "null" }] },
					"savedPrice": { "oneOf": [{ "$ref": "#/components/schemas/Money" }, { "type": "null" }] },
					"inStock": { "type": ["boolean", "null"] },
					"addedAt": { "type": "string", "format": "date-time" }
				}
			},
			"List": {
				"type": "object",
				"required": ["id", "name", "isDefault", "itemCount", "notify", "shared", "owner", "createdAt", "updatedAt"],
				"properties": {
					"id": { "type": "string" },
					"name": { "type": "string" },
					"isDefault": { "type": "boolean" },
					"itemCount": { "type": "integer" },
					"notify": { "type": "boolean" },
					"shared": { "type": "boolean" },
					"owner": {
						"type": "object",
						"required": ["kind"],
						"properties": { "kind": { "type": "string", "enum": ["customer", "guest"] }, "id": { "type": "string" } }
					},
					"createdAt": { "type": "string", "format": "date-time" },
					"updatedAt": { "type": "string", "format": "date-time" }
				}
			},
			"ListWithItems": {
				"allOf": [
					{ "$ref": "#/components/schemas/List" },
					{
						"type": "object",
						"properties": { "items": { "type": "array", "items": { "$ref": "#/components/schemas/Entry" } } }
					}
				]
			},
			"ListPage": {
				"type": "object",
				"required": ["items", "hasMore"],
				"properties": {
					"items": { "type": "array", "items": { "$ref": "#/components/schemas/List" } },
					"nextCursor": { "type": ["string", "null"] },
					"hasMore": { "type": "boolean" }
				}
			},
			"GuestToken": {
				"type": "object",
				"required": ["token", "expiresAt"],
				"properties": { "token": { "type": "string" }, "expiresAt": { "type": "string", "format": "date-time" } }
			},
			"Share": {
				"type": "object",
				"required": ["listId", "token", "url", "createdAt", "expiresAt"],
				"properties": {
					"listId": { "type": "string" },
					"token": { "type": "string" },
					"url": { "type": ["string", "null"] },
					"createdAt": { "type": "string", "format": "date-time" },
					"expiresAt": { "type": ["string", "null"], "format": "date-time" }
				}
			},
			"SharedList": {
				"type": "object",
				"required": ["name", "itemCount", "items"],
				"properties": {
					"name": { "type": "string" },
					"itemCount": { "type": "integer" },
					"items": { "type": "array", "items": { "type": "object" } }
				}
			},
			"Notification": {
				"type": "object",
				"required": ["id", "kind", "itemId", "customer", "listIds", "eventId", "at"],
				"properties": {
					"id": { "type": "string" },
					"kind": { "type": "string", "enum": ["price_dropped", "back_in_stock"] },
					"itemId": { "type": "string" },
					"variantId": { "type": ["string", "null"] },
					"customer": { "type": "object", "properties": { "subject": { "type": "string" } } },
					"listIds": { "type": "array", "items": { "type": "string" } },
					"eventId": { "type": "string" },
					"at": { "type": "string", "format": "date-time" }
				}
			},
			"WishlistState": {
				"type": "object",
				"required": ["owner", "guest", "dropGuest", "merged", "lists", "settings"],
				"properties": {
					"owner": { "type": ["object", "null"] },
					"guest": { "oneOf": [{ "$ref": "#/components/schemas/GuestToken" }, { "type": "null" }] },
					"dropGuest": { "type": "boolean" },
					"merged": { "type": "integer" },
					"lists": { "type": "array", "items": { "$ref": "#/components/schemas/ListWithItems" } },
					"settings": { "type": "object" }
				}
			},
			"Problem": {
				"type": "object",
				"required": ["type", "title", "status"],
				"properties": {
					"type": { "type": "string" },
					"title": { "type": "string" },
					"status": { "type": "integer" },
					"detail": { "type": "string" },
					"instance": { "type": "string" },
					"requestId": { "type": "string" },
					"errors": { "type": "array", "items": { "type": "object" } }
				}
			}
		},
		"responses": {
			"EntryChange": {
				"description": "The change and the list after it",
				"content": {
					"application/json": {
						"schema": {
							"type": "object",
							"required": ["entryId", "list"],
							"properties": {
								"entryId": { "type": "string" },
								"added": { "type": "boolean" },
								"removed": { "type": "boolean" },
								"evicted": { "type": "array", "items": { "type": "string" } },
								"list": { "$ref": "#/components/schemas/ListWithItems" }
							}
						},
						"example": {
							"entryId": "wli_0123456789abcdefghjkmnpq",
							"added": true,
							"evicted": [],
							"list": {
								"id": "wl_0123456789abcdefghjkmnpq",
								"name": "Wishlist",
								"isDefault": true,
								"itemCount": 1,
								"notify": false,
								"shared": false,
								"owner": { "kind": "guest" },
								"createdAt": "2026-10-01T10:00:00.000Z",
								"updatedAt": "2026-10-01T10:05:00.000Z",
								"items": []
							}
						}
					}
				}
			},
			"Problem": {
				"description": "RFC 9457 problem details",
				"content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } }
			}
		}
	}
}
