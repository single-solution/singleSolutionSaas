{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "wishlist.price_dropped@1",
	"description": "An item a customer saved (on a list where they opted in to signals) dropped in price below what they saw when saving it, by at least the website's minimum. One event per customer and price change. Wishlist sends no message itself: Alerts or the merchant's messaging can act on it. Carries the customer's login subject, and their e-mail only when price_drop_hook.include_email is on.",
	"type": "object",
	"required": ["customer", "itemId", "price", "referencePrice", "listIds"],
	"additionalProperties": false,
	"properties": {
		"customer": {
			"type": "object",
			"required": ["subject"],
			"additionalProperties": false,
			"properties": {
				"subject": { "type": "string", "minLength": 1, "maxLength": 256 },
				"email": { "type": "string", "minLength": 3, "maxLength": 320 }
			}
		},
		"itemId": { "type": "string", "minLength": 1, "maxLength": 128 },
		"variantId": { "type": "string", "minLength": 1, "maxLength": 128 },
		"title": { "type": "string", "maxLength": 200 },
		"url": { "type": "string", "maxLength": 2048 },
		"image": { "type": "string", "maxLength": 2048 },
		"price": { "$ref": "#/$defs/money" },
		"referencePrice": { "$ref": "#/$defs/money" },
		"dropPercent": { "type": "integer", "minimum": 0, "maximum": 100 },
		"listIds": {
			"type": "array",
			"minItems": 1,
			"maxItems": 100,
			"items": { "type": "string", "minLength": 1, "maxLength": 64 }
		}
	},
	"$defs": {
		"money": {
			"type": "object",
			"required": ["amount", "currency"],
			"additionalProperties": false,
			"properties": {
				"amount": { "type": "integer", "minimum": 0 },
				"currency": { "type": "string", "pattern": "^[A-Z]{3}$" }
			}
		}
	},
	"examples": [
		{
			"customer": { "subject": "cus_42" },
			"itemId": "itm_42",
			"title": "Linen shirt",
			"url": "https://shop.example.com/p/linen-shirt",
			"price": { "amount": 3900, "currency": "EUR" },
			"referencePrice": { "amount": 4900, "currency": "EUR" },
			"dropPercent": 20,
			"listIds": ["wl_0abc"]
		}
	]
}
