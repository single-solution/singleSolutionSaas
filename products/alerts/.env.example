# SSPS product environment (names from @ss/app-kit API.md). `ss dev env` prints development values.

# ── Required ────────────────────────────────────────────────────────────────
# The Portal this product trusts (its URL). `ss dev` runs the local Portal emulator here.
PORTAL_URL=http://localhost:4400
# Product signing key: kid:seed (seed = base64url of 32 bytes, Ed25519). `ss dev env` prints one. Never commit a real one.
SIGNING_KEY=
# SHA-256 (hex) of the one-time registration token. The token itself is never stored.
REGISTRATION_TOKEN_HASH=
# The product's own small control DB (replay/nonce/entitlement caches, usage queue, event outbox, sessions).
# Required in production; empty = in-memory in development. Merchant data never goes here.
DATABASE_URI=

# ── Optional ────────────────────────────────────────────────────────────────
# App id assigned by the Portal at registration (default: the one recorded by the registration).
APP_ID=
# Control-DB pool per instance (default 5).
DATABASE_MAX_POOL_SIZE=
# Development only: comma-separated hosts/IPs outbound calls may reach (default loopback). Ignored in production.
OUTBOUND_DEV_ALLOW_HOSTS=
# Secret of unsubscribe / confirm links and contact hashes (≥ 32 chars). Empty = derived from SIGNING_KEY.
ALERTS_TOKEN_SECRET=
