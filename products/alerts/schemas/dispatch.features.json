{
	"type": "object",
	"title": "Dispatch",
	"additionalProperties": false,
	"properties": {
		"time_zone": {
			"type": "string",
			"title": "Time zone",
			"description": "IANA zone of quiet hours and frequency-cap days/weeks (the website's zone).",
			"default": "UTC",
			"minLength": 1,
			"maxLength": 64,
			"pattern": "^[A-Za-z_]+(?:/[A-Za-z0-9_+-]+)*$",
			"x-kind": "config",
			"x-ui": { "widget": "text", "group": "Timing", "order": 1 }
		},
		"quiet_hours_enabled": {
			"type": "boolean",
			"title": "Quiet hours",
			"description": "Hold alerts during the night (in the time zone above) and send them when quiet hours end.",
			"default": false,
			"x-kind": "flag",
			"x-ui": { "widget": "switch", "group": "Timing", "order": 2 }
		},
		"quiet_hours_start": {
			"type": "string",
			"title": "Quiet hours start (HH:MM)",
			"default": "21:00",
			"pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$",
			"x-kind": "config",
			"x-ui": { "widget": "time", "group": "Timing", "order": 3 }
		},
		"quiet_hours_end": {
			"type": "string",
			"title": "Quiet hours end (HH:MM)",
			"default": "08:00",
			"pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$",
			"x-kind": "config",
			"x-ui": { "widget": "time", "group": "Timing", "order": 4 }
		},
		"batch_window_minutes": {
			"type": "integer",
			"title": "Batching window (minutes)",
			"description": "Alerts for the same contact within this window go out as one digest message (0 = send each alert at once).",
			"default": 0,
			"minimum": 0,
			"maximum": 1440,
			"x-kind": "config",
			"x-ui": { "widget": "number", "group": "Timing", "order": 5 }
		},
		"max_per_contact_per_day": {
			"type": "integer",
			"title": "Messages per contact per day",
			"description": "0 = unlimited.",
			"default": 5,
			"minimum": 0,
			"maximum": 100,
			"x-kind": "limit",
			"x-ui": { "widget": "number", "group": "Frequency caps", "order": 6 }
		},
		"max_per_contact_per_week": {
			"type": "integer",
			"title": "Messages per contact per week",
			"description": "0 = unlimited.",
			"default": 20,
			"minimum": 0,
			"maximum": 500,
			"x-kind": "limit",
			"x-ui": { "widget": "number", "group": "Frequency caps", "order": 7 }
		},
		"cap_action": {
			"type": "string",
			"title": "When a cap is reached",
			"description": "defer: send when the period resets; drop: skip this alert (the subscription waits for the next change).",
			"default": "defer",
			"enum": ["defer", "drop"],
			"x-kind": "config",
			"x-ui": { "widget": "select", "group": "Frequency caps", "order": 8 }
		},
		"max_attempts": {
			"type": "integer",
			"title": "Delivery attempts",
			"default": 5,
			"minimum": 1,
			"maximum": 20,
			"x-kind": "limit",
			"x-ui": { "widget": "number", "group": "Delivery", "order": 9 }
		},
		"retry_base_minutes": {
			"type": "integer",
			"title": "First retry after (minutes)",
			"description": "Retries back off exponentially (×2 per attempt, at most one day).",
			"default": 2,
			"minimum": 1,
			"maximum": 60,
			"x-kind": "config",
			"x-ui": { "widget": "number", "group": "Delivery", "order": 10 }
		},
		"lease_seconds": {
			"type": "integer",
			"title": "Send lease (seconds)",
			"description": "How long an instance holds a claimed message before another may take it over.",
			"default": 120,
			"minimum": 30,
			"maximum": 900,
			"x-kind": "config",
			"x-ui": { "widget": "number", "group": "Delivery", "order": 11 }
		},
		"release_on_failure": {
			"type": "boolean",
			"title": "Re-arm subscriptions after a failed delivery",
			"description": "On: a subscription whose message finally failed waits for the next change. Off: it ends as failed.",
			"default": true,
			"x-kind": "flag",
			"x-ui": { "widget": "switch", "group": "Delivery", "order": 12 }
		},
		"inline_dispatch": {
			"type": "boolean",
			"title": "Send right after the trigger",
			"description": "Off: messages wait for the scheduled run (cron) only.",
			"default": true,
			"x-kind": "flag",
			"x-ui": { "widget": "switch", "group": "Delivery", "order": 13 }
		},
		"send_path": {
			"type": "string",
			"title": "Provider send path",
			"description": "Path under the messaging connector's base URL that accepts a message (POST, JSON).",
			"default": "/messages",
			"minLength": 1,
			"maxLength": 200,
			"pattern": "^/[A-Za-z0-9._~!$&'()*+,;=:@%/-]*$",
			"x-kind": "config",
			"x-ui": { "widget": "text", "group": "Delivery", "order": 14 }
		},
		"site_name": {
			"type": "string",
			"title": "Store name in messages",
			"description": "Empty = the website's domain.",
			"default": "",
			"maxLength": 120,
			"x-kind": "config",
			"x-ui": { "widget": "text", "group": "Messages", "order": 15 }
		},
		"item_url_template": {
			"type": "string",
			"title": "Item link when the page sent none",
			"description": "https URL with {itemId} / {variantId} placeholders (empty = no link).",
			"default": "",
			"maxLength": 500,
			"pattern": "^(?:https://.+)?$",
			"x-kind": "config",
			"x-ui": { "widget": "text", "group": "Messages", "order": 16 }
		},
		"templates": {
			"type": "array",
			"title": "Message templates",
			"description": "Overrides of the default templates per type, channel and language ('*' = any). Placeholders: {item} {site} {url} {price} {old_price} {drop_percent} {quantity} {unsubscribe_url}; digest: {count} {lines}; confirm: {confirm_url}.",
			"default": [],
			"maxItems": 100,
			"x-kind": "config",
			"x-plan": { "starter": { "max": 10 }, "pro": { "max": 100 } },
			"x-ui": { "widget": "list", "group": "Messages", "order": 17 },
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": ["type", "channel", "lang", "body"],
				"properties": {
					"type": {
						"type": "string",
						"title": "Type",
						"maxLength": 50,
						"pattern": "^(?:\\*|back_in_stock|price_drop|availability|digest|confirm|custom|custom:[a-z][a-z0-9_]*)$"
					},
					"channel": { "type": "string", "title": "Channel", "enum": ["*", "email", "sms", "whatsapp"] },
					"lang": {
						"type": "string",
						"title": "Language",
						"maxLength": 35,
						"pattern": "^(?:\\*|[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*)$"
					},
					"subject": { "type": "string", "title": "Subject (e-mail)", "maxLength": 200 },
					"body": { "type": "string", "title": "Body", "minLength": 1, "maxLength": 2000 }
				}
			}
		},
		"message_retention_days": {
			"type": "integer",
			"title": "Keep message records (days)",
			"default": 90,
			"minimum": 1,
			"maximum": 3650,
			"x-kind": "limit",
			"x-ui": { "widget": "number", "group": "Retention", "order": 18 }
		}
	}
}
