{
	"type": "object",
	"title": "Triggers",
	"additionalProperties": false,
	"properties": {
		"consume_inventory_events": {
			"type": "boolean",
			"title": "React to inventory.changed@1",
			"default": true,
			"x-kind": "flag",
			"x-ui": { "widget": "switch", "group": "Sources", "order": 1 }
		},
		"consume_price_events": {
			"type": "boolean",
			"title": "React to price.changed@1",
			"default": true,
			"x-kind": "flag",
			"x-ui": { "widget": "switch", "group": "Sources", "order": 2 }
		},
		"consume_custom_events": {
			"type": "boolean",
			"title": "React to custom.* events",
			"default": true,
			"x-kind": "flag",
			"x-ui": { "widget": "switch", "group": "Sources", "order": 3 }
		},
		"accept_customer_events": {
			"type": "boolean",
			"title": "Accept stock and price events sent from browsers",
			"description": "Off (recommended): inventory and price changes are trusted only from the merchant's servers (sk_ keys, merchant/staff actors), never from a shopper's browser.",
			"default": false,
			"x-kind": "flag",
			"x-ui": { "widget": "switch", "group": "Security", "order": 4 }
		},
		"in_stock_threshold": {
			"type": "integer",
			"title": "In stock above (units)",
			"description": "A target is available when its quantity is strictly greater than this (0 = any unit).",
			"default": 0,
			"minimum": 0,
			"maximum": 1000000,
			"x-kind": "config",
			"x-ui": { "widget": "number", "group": "Stock", "order": 5 }
		},
		"locations": {
			"type": "array",
			"title": "Tracked stock locations",
			"description": "Location ids whose stock counts (empty = every location; changes without a location always count).",
			"default": [],
			"maxItems": 100,
			"uniqueItems": true,
			"items": { "type": "string", "minLength": 1, "maxLength": 128 },
			"x-kind": "config",
			"x-ui": { "widget": "tags", "group": "Stock", "order": 6 }
		},
		"price_lists": {
			"type": "array",
			"title": "Tracked price lists",
			"description": "price.changed@1 priceListId values that count (empty = every list; changes without a list always count).",
			"default": [],
			"maxItems": 50,
			"uniqueItems": true,
			"items": { "type": "string", "minLength": 1, "maxLength": 128 },
			"x-kind": "config",
			"x-ui": { "widget": "tags", "group": "Price", "order": 7 }
		},
		"ignore_out_of_order": {
			"type": "boolean",
			"title": "Ignore changes older than the last one seen",
			"default": true,
			"x-kind": "flag",
			"x-ui": { "widget": "switch", "group": "Stock", "order": 8 }
		},
		"fanout_limit": {
			"type": "integer",
			"title": "Subscriptions claimed per trigger run",
			"description": "Larger waitlists continue in the scheduled run (every subscription is still told once).",
			"default": 200,
			"minimum": 1,
			"maximum": 5000,
			"x-kind": "limit",
			"x-plan": { "starter": { "default": 200, "max": 500 }, "pro": { "default": 500, "max": 5000 } },
			"x-ui": { "widget": "number", "group": "Limits", "order": 9 }
		},
		"max_batch_items": {
			"type": "integer",
			"title": "Changes per POST /v1/triggers:batch",
			"default": 100,
			"minimum": 1,
			"maximum": 500,
			"x-kind": "limit",
			"x-ui": { "widget": "number", "group": "Limits", "order": 10 }
		},
		"max_csv_rows": {
			"type": "integer",
			"title": "Rows per CSV import",
			"default": 1000,
			"minimum": 1,
			"maximum": 20000,
			"x-kind": "limit",
			"x-plan": { "starter": { "default": 1000, "max": 1000 }, "pro": { "default": 5000, "max": 20000 } },
			"x-ui": { "widget": "number", "group": "Limits", "order": 11 }
		}
	}
}
