{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "alerts.sent@1",
	"description": "An alert message was handed to the merchant's messaging provider (one message may carry several alerts when batching is on). Carries no contact address.",
	"type": "object",
	"required": ["messageId", "channel", "alerts"],
	"additionalProperties": false,
	"properties": {
		"messageId": { "type": "string", "minLength": 1, "maxLength": 64 },
		"channel": { "type": "string", "enum": ["email", "sms", "whatsapp"] },
		"kind": { "type": "string", "enum": ["alert", "confirm"] },
		"alerts": {
			"type": "array",
			"maxItems": 100,
			"items": {
				"type": "object",
				"required": ["subscriptionId", "type"],
				"additionalProperties": false,
				"properties": {
					"subscriptionId": { "type": "string", "minLength": 1, "maxLength": 64 },
					"type": { "type": "string", "minLength": 1, "maxLength": 50 },
					"itemId": { "type": "string", "minLength": 1, "maxLength": 128 },
					"variantId": { "type": "string", "minLength": 1, "maxLength": 128 },
					"customerId": { "type": "string", "minLength": 1, "maxLength": 128 }
				}
			}
		},
		"providerMessageId": { "type": "string", "maxLength": 256 }
	},
	"examples": [
		{
			"messageId": "alm_0abc",
			"channel": "email",
			"kind": "alert",
			"alerts": [{ "subscriptionId": "als_0abc", "type": "back_in_stock", "itemId": "itm_42" }]
		}
	]
}
