{
	"type": "object",
	"title": "Related items",
	"additionalProperties": false,
	"properties": {
		"strategy": {
			"type": "string",
			"title": "Strategy",
			"default": "provided",
			"enum": ["provided", "same_brand", "same_category"],
			"x-kind": "config",
			"x-ui": {
				"widget": "select",
				"group": "Selection",
				"order": 1
			}
		},
		"count": {
			"type": "integer",
			"title": "Items",
			"default": 4,
			"minimum": 1,
			"maximum": 24,
			"x-kind": "limit",
			"x-plan": {
				"standard": {
					"default": 4,
					"max": 24
				}
			},
			"x-ui": {
				"widget": "number",
				"group": "Selection",
				"order": 2
			}
		},
		"layout": {
			"type": "string",
			"title": "Layout",
			"default": "rail",
			"enum": ["rail", "grid"],
			"x-kind": "config",
			"x-ui": {
				"widget": "select",
				"group": "Display",
				"order": 3
			}
		},
		"show_price": {
			"type": "boolean",
			"title": "Prices",
			"default": true,
			"x-kind": "flag",
			"x-ui": {
				"widget": "switch",
				"group": "Display",
				"order": 4
			}
		},
		"list_url": {
			"type": "string",
			"title": "Related list URL",
			"default": "",
			"maxLength": 1000,
			"x-kind": "config",
			"description": "Optional https JSON list ({ items: [...] } or an array). Placeholders: {id}, {brand}, {category}.",
			"pattern": "^(?:$|https://)",
			"x-ui": {
				"widget": "text",
				"group": "Data source",
				"order": 5
			}
		},
		"source_url": {
			"type": "string",
			"title": "JSON source URL",
			"description": "Optional public https JSON document of the item, read when the page lacks data. Placeholders: {id} (the page item id), {path}, and the hosted page route parameters.",
			"default": "",
			"maxLength": 1000,
			"pattern": "^(?:$|https://)",
			"x-kind": "config",
			"x-ui": {
				"widget": "url",
				"group": "Data source",
				"order": 6,
				"placeholder": "https://example.com/items/{id}.json",
				"advanced": true
			}
		},
		"source_fields": {
			"type": "object",
			"title": "JSON field mapping",
			"description": "Dot path of each item field in the JSON source (e.g. data.product.name); `root` selects the item object. Unmapped fields are read from same-named properties.",
			"default": {},
			"additionalProperties": false,
			"properties": {
				"root": {
					"type": "string",
					"maxLength": 200,
					"pattern": "^[A-Za-z0-9_$.-]*$"
				},
				"id": {
					"type": "string",
					"maxLength": 200,
					"pattern": "^[A-Za-z0-9_$.-]*$"
				},
				"title": {
					"type": "string",
					"maxLength": 200,
					"pattern": "^[A-Za-z0-9_$.-]*$"
				},
				"subtitle": {
					"type": "string",
					"maxLength": 200,
					"pattern": "^[A-Za-z0-9_$.-]*$"
				},
				"brand": {
					"type": "string",
					"maxLength": 200,
					"pattern": "^[A-Za-z0-9_$.-]*$"
				},
				"description": {
					"type": "string",
					"maxLength": 200,
					"pattern": "^[A-Za-z0-9_$.-]*$"
				},
				"url": {
					"type": "string",
					"maxLength": 200,
					"pattern": "^[A-Za-z0-9_$.-]*$"
				},
				"sku": {
					"type": "string",
					"maxLength": 200,
					"pattern": "^[A-Za-z0-9_$.-]*$"
				},
				"gtin": {
					"type": "string",
					"maxLength": 200,
					"pattern": "^[A-Za-z0-9_$.-]*$"
				},
				"mpn": {
					"type": "string",
					"maxLength": 200,
					"pattern": "^[A-Za-z0-9_$.-]*$"
				},
				"category": {
					"type": "string",
					"maxLength": 200,
					"pattern": "^[A-Za-z0-9_$.-]*$"
				},
				"condition": {
					"type": "string",
					"maxLength": 200,
					"pattern": "^[A-Za-z0-9_$.-]*$"
				},
				"availability": {
					"type": "string",
					"maxLength": 200,
					"pattern": "^[A-Za-z0-9_$.-]*$"
				},
				"stock": {
					"type": "string",
					"maxLength": 200,
					"pattern": "^[A-Za-z0-9_$.-]*$"
				},
				"price": {
					"type": "string",
					"maxLength": 200,
					"pattern": "^[A-Za-z0-9_$.-]*$"
				},
				"compareAtPrice": {
					"type": "string",
					"maxLength": 200,
					"pattern": "^[A-Za-z0-9_$.-]*$"
				},
				"currency": {
					"type": "string",
					"maxLength": 200,
					"pattern": "^[A-Za-z0-9_$.-]*$"
				},
				"images": {
					"type": "string",
					"maxLength": 200,
					"pattern": "^[A-Za-z0-9_$.-]*$"
				},
				"ratingValue": {
					"type": "string",
					"maxLength": 200,
					"pattern": "^[A-Za-z0-9_$.-]*$"
				},
				"ratingCount": {
					"type": "string",
					"maxLength": 200,
					"pattern": "^[A-Za-z0-9_$.-]*$"
				},
				"faq": {
					"type": "string",
					"maxLength": 200,
					"pattern": "^[A-Za-z0-9_$.-]*$"
				},
				"related": {
					"type": "string",
					"maxLength": 200,
					"pattern": "^[A-Za-z0-9_$.-]*$"
				},
				"attributes": {
					"type": "string",
					"maxLength": 200,
					"pattern": "^[A-Za-z0-9_$.-]*$"
				}
			},
			"x-kind": "config",
			"x-ui": {
				"widget": "mapping",
				"group": "Data source",
				"order": 7,
				"advanced": true
			}
		},
		"placement": {
			"type": "object",
			"title": "Placement",
			"description": "Where and when the element renders: the shared placement v1 (paths, selectors, page types, devices, referrers, schedule, consent, triggers, frequency incl. cooldown and dismiss memory, audience rule). The Loader enforces it.",
			"default": {
				"selectors": [
					{
						"selector": "[data-ss-slot=\"related\"]",
						"position": "append"
					}
				]
			},
			"x-kind": "placement",
			"x-ui": {
				"group": "Placement",
				"order": 8
			}
		}
	}
}
