{
	"type": "object",
	"title": "Price block",
	"additionalProperties": false,
	"properties": {
		"savings": {
			"type": "string",
			"title": "Savings display",
			"default": "percent",
			"enum": ["none", "amount", "percent", "both"],
			"x-kind": "config",
			"x-ui": {
				"widget": "select",
				"group": "Display",
				"order": 1
			}
		},
		"currency_display": {
			"type": "string",
			"title": "Currency display",
			"default": "symbol",
			"enum": ["symbol", "narrowSymbol", "code", "name"],
			"x-kind": "config",
			"x-ui": {
				"widget": "select",
				"group": "Display",
				"order": 2
			}
		},
		"fraction_digits": {
			"type": "integer",
			"title": "Fraction digits (-1 = the currency’s own)",
			"default": -1,
			"minimum": -1,
			"maximum": 4,
			"x-kind": "config",
			"x-ui": {
				"widget": "number",
				"group": "Display",
				"order": 3
			}
		},
		"locale": {
			"type": "string",
			"title": "Locale (empty = the page language)",
			"default": "",
			"maxLength": 35,
			"x-kind": "config",
			"pattern": "^(?:$|[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*)$",
			"x-ui": {
				"widget": "text",
				"group": "Display",
				"order": 4
			}
		},
		"show_availability": {
			"type": "boolean",
			"title": "Availability",
			"default": true,
			"x-kind": "flag",
			"x-ui": {
				"widget": "switch",
				"group": "Copy",
				"order": 5
			}
		},
		"show_taxes": {
			"type": "boolean",
			"title": "Taxes note",
			"default": false,
			"x-kind": "flag",
			"x-ui": {
				"widget": "switch",
				"group": "Copy",
				"order": 6
			}
		},
		"show_financing": {
			"type": "boolean",
			"title": "Financing note",
			"default": false,
			"x-kind": "flag",
			"x-ui": {
				"widget": "switch",
				"group": "Copy",
				"order": 7
			}
		},
		"update_event": {
			"type": "string",
			"title": "Variant event",
			"default": "",
			"maxLength": 120,
			"x-kind": "config",
			"description": "Element event carrying the selected variant ({ price, compareAtPrice?, currency?, availability? }), e.g. widget.variant_selected.",
			"pattern": "^(?:$|[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*(?:@[0-9]+)?)$",
			"x-ui": {
				"widget": "text",
				"group": "Variants",
				"order": 8
			}
		},
		"source_url": {
			"type": "string",
			"title": "JSON source URL",
			"description": "Optional public https JSON document of the item, read when the page lacks data. Placeholders: {id} (the page item id), {path}, and the hosted page route parameters.",
			"default": "",
			"maxLength": 1000,
			"pattern": "^(?:$|https://)",
			"x-kind": "config",
			"x-ui": {
				"widget": "url",
				"group": "Data source",
				"order": 9,
				"placeholder": "https://example.com/items/{id}.json",
				"advanced": true
			}
		},
		"source_fields": {
			"type": "object",
			"title": "JSON field mapping",
			"description": "Dot path of each item field in the JSON source (e.g. data.product.name); `root` selects the item object. Unmapped fields are read from same-named properties.",
			"default": {},
			"additionalProperties": false,
			"properties": {
				"root": {
					"type": "string",
					"maxLength": 200,
					"pattern": "^[A-Za-z0-9_$.-]*$"
				},
				"id": {
					"type": "string",
					"maxLength": 200,
					"pattern": "^[A-Za-z0-9_$.-]*$"
				},
				"title": {
					"type": "string",
					"maxLength": 200,
					"pattern": "^[A-Za-z0-9_$.-]*$"
				},
				"subtitle": {
					"type": "string",
					"maxLength": 200,
					"pattern": "^[A-Za-z0-9_$.-]*$"
				},
				"brand": {
					"type": "string",
					"maxLength": 200,
					"pattern": "^[A-Za-z0-9_$.-]*$"
				},
				"description": {
					"type": "string",
					"maxLength": 200,
					"pattern": "^[A-Za-z0-9_$.-]*$"
				},
				"url": {
					"type": "string",
					"maxLength": 200,
					"pattern": "^[A-Za-z0-9_$.-]*$"
				},
				"sku": {
					"type": "string",
					"maxLength": 200,
					"pattern": "^[A-Za-z0-9_$.-]*$"
				},
				"gtin": {
					"type": "string",
					"maxLength": 200,
					"pattern": "^[A-Za-z0-9_$.-]*$"
				},
				"mpn": {
					"type": "string",
					"maxLength": 200,
					"pattern": "^[A-Za-z0-9_$.-]*$"
				},
				"category": {
					"type": "string",
					"maxLength": 200,
					"pattern": "^[A-Za-z0-9_$.-]*$"
				},
				"condition": {
					"type": "string",
					"maxLength": 200,
					"pattern": "^[A-Za-z0-9_$.-]*$"
				},
				"availability": {
					"type": "string",
					"maxLength": 200,
					"pattern": "^[A-Za-z0-9_$.-]*$"
				},
				"stock": {
					"type": "string",
					"maxLength": 200,
					"pattern": "^[A-Za-z0-9_$.-]*$"
				},
				"price": {
					"type": "string",
					"maxLength": 200,
					"pattern": "^[A-Za-z0-9_$.-]*$"
				},
				"compareAtPrice": {
					"type": "string",
					"maxLength": 200,
					"pattern": "^[A-Za-z0-9_$.-]*$"
				},
				"currency": {
					"type": "string",
					"maxLength": 200,
					"pattern": "^[A-Za-z0-9_$.-]*$"
				},
				"images": {
					"type": "string",
					"maxLength": 200,
					"pattern": "^[A-Za-z0-9_$.-]*$"
				},
				"ratingValue": {
					"type": "string",
					"maxLength": 200,
					"pattern": "^[A-Za-z0-9_$.-]*$"
				},
				"ratingCount": {
					"type": "string",
					"maxLength": 200,
					"pattern": "^[A-Za-z0-9_$.-]*$"
				},
				"faq": {
					"type": "string",
					"maxLength": 200,
					"pattern": "^[A-Za-z0-9_$.-]*$"
				},
				"related": {
					"type": "string",
					"maxLength": 200,
					"pattern": "^[A-Za-z0-9_$.-]*$"
				},
				"attributes": {
					"type": "string",
					"maxLength": 200,
					"pattern": "^[A-Za-z0-9_$.-]*$"
				}
			},
			"x-kind": "config",
			"x-ui": {
				"widget": "mapping",
				"group": "Data source",
				"order": 10,
				"advanced": true
			}
		},
		"placement": {
			"type": "object",
			"title": "Placement",
			"description": "Where and when the element renders: the shared placement v1 (paths, selectors, page types, devices, referrers, schedule, consent, triggers, frequency incl. cooldown and dismiss memory, audience rule). The Loader enforces it.",
			"default": {
				"selectors": [
					{
						"selector": "[data-ss-slot=\"price\"]",
						"position": "append"
					}
				]
			},
			"x-kind": "placement",
			"x-ui": {
				"group": "Placement",
				"order": 11
			}
		}
	}
}
