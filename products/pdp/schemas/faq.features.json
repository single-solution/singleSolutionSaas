{
	"type": "object",
	"title": "FAQ",
	"additionalProperties": false,
	"properties": {
		"source": {
			"type": "string",
			"title": "Questions from",
			"default": "both",
			"enum": ["item", "manual", "both"],
			"x-kind": "config",
			"x-ui": {
				"widget": "select",
				"group": "Content",
				"order": 1
			}
		},
		"entries": {
			"type": "array",
			"title": "Questions",
			"description": "Questions shown on every item page (after the item’s own).",
			"default": [],
			"maxItems": 50,
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": ["question", "answer"],
				"properties": {
					"question": {
						"type": "string",
						"minLength": 1,
						"maxLength": 300
					},
					"answer": {
						"type": "string",
						"minLength": 1,
						"maxLength": 3000
					}
				}
			},
			"x-kind": "config",
			"x-ui": {
				"widget": "list",
				"group": "Content",
				"order": 2
			}
		},
		"count": {
			"type": "integer",
			"title": "Maximum questions",
			"default": 10,
			"minimum": 1,
			"maximum": 50,
			"x-kind": "limit",
			"x-ui": {
				"widget": "number",
				"group": "Content",
				"order": 3
			}
		},
		"open_first": {
			"type": "boolean",
			"title": "First question open",
			"default": false,
			"x-kind": "flag",
			"x-ui": {
				"widget": "switch",
				"group": "Display",
				"order": 4
			}
		},
		"structured_data": {
			"type": "boolean",
			"title": "FAQPage structured data",
			"default": true,
			"x-kind": "flag",
			"x-ui": {
				"widget": "switch",
				"group": "Display",
				"order": 5
			}
		},
		"source_url": {
			"type": "string",
			"title": "JSON source URL",
			"description": "Optional public https JSON document of the item, read when the page lacks data. Placeholders: {id} (the page item id), {path}, and the hosted page route parameters.",
			"default": "",
			"maxLength": 1000,
			"pattern": "^(?:$|https://)",
			"x-kind": "config",
			"x-ui": {
				"widget": "url",
				"group": "Data source",
				"order": 6,
				"placeholder": "https://example.com/items/{id}.json",
				"advanced": true
			}
		},
		"source_fields": {
			"type": "object",
			"title": "JSON field mapping",
			"description": "Dot path of each item field in the JSON source (e.g. data.product.name); `root` selects the item object. Unmapped fields are read from same-named properties.",
			"default": {},
			"additionalProperties": false,
			"properties": {
				"root": {
					"type": "string",
					"maxLength": 200,
					"pattern": "^[A-Za-z0-9_$.-]*$"
				},
				"id": {
					"type": "string",
					"maxLength": 200,
					"pattern": "^[A-Za-z0-9_$.-]*$"
				},
				"title": {
					"type": "string",
					"maxLength": 200,
					"pattern": "^[A-Za-z0-9_$.-]*$"
				},
				"subtitle": {
					"type": "string",
					"maxLength": 200,
					"pattern": "^[A-Za-z0-9_$.-]*$"
				},
				"brand": {
					"type": "string",
					"maxLength": 200,
					"pattern": "^[A-Za-z0-9_$.-]*$"
				},
				"description": {
					"type": "string",
					"maxLength": 200,
					"pattern": "^[A-Za-z0-9_$.-]*$"
				},
				"url": {
					"type": "string",
					"maxLength": 200,
					"pattern": "^[A-Za-z0-9_$.-]*$"
				},
				"sku": {
					"type": "string",
					"maxLength": 200,
					"pattern": "^[A-Za-z0-9_$.-]*$"
				},
				"gtin": {
					"type": "string",
					"maxLength": 200,
					"pattern": "^[A-Za-z0-9_$.-]*$"
				},
				"mpn": {
					"type": "string",
					"maxLength": 200,
					"pattern": "^[A-Za-z0-9_$.-]*$"
				},
				"category": {
					"type": "string",
					"maxLength": 200,
					"pattern": "^[A-Za-z0-9_$.-]*$"
				},
				"condition": {
					"type": "string",
					"maxLength": 200,
					"pattern": "^[A-Za-z0-9_$.-]*$"
				},
				"availability": {
					"type": "string",
					"maxLength": 200,
					"pattern": "^[A-Za-z0-9_$.-]*$"
				},
				"stock": {
					"type": "string",
					"maxLength": 200,
					"pattern": "^[A-Za-z0-9_$.-]*$"
				},
				"price": {
					"type": "string",
					"maxLength": 200,
					"pattern": "^[A-Za-z0-9_$.-]*$"
				},
				"compareAtPrice": {
					"type": "string",
					"maxLength": 200,
					"pattern": "^[A-Za-z0-9_$.-]*$"
				},
				"currency": {
					"type": "string",
					"maxLength": 200,
					"pattern": "^[A-Za-z0-9_$.-]*$"
				},
				"images": {
					"type": "string",
					"maxLength": 200,
					"pattern": "^[A-Za-z0-9_$.-]*$"
				},
				"ratingValue": {
					"type": "string",
					"maxLength": 200,
					"pattern": "^[A-Za-z0-9_$.-]*$"
				},
				"ratingCount": {
					"type": "string",
					"maxLength": 200,
					"pattern": "^[A-Za-z0-9_$.-]*$"
				},
				"faq": {
					"type": "string",
					"maxLength": 200,
					"pattern": "^[A-Za-z0-9_$.-]*$"
				},
				"related": {
					"type": "string",
					"maxLength": 200,
					"pattern": "^[A-Za-z0-9_$.-]*$"
				},
				"attributes": {
					"type": "string",
					"maxLength": 200,
					"pattern": "^[A-Za-z0-9_$.-]*$"
				}
			},
			"x-kind": "config",
			"x-ui": {
				"widget": "mapping",
				"group": "Data source",
				"order": 7,
				"advanced": true
			}
		},
		"placement": {
			"type": "object",
			"title": "Placement",
			"description": "Where and when the element renders: the shared placement v1 (paths, selectors, page types, devices, referrers, schedule, consent, triggers, frequency incl. cooldown and dismiss memory, audience rule). The Loader enforces it.",
			"default": {
				"selectors": [
					{
						"selector": "[data-ss-slot=\"faq\"]",
						"position": "append"
					}
				]
			},
			"x-kind": "placement",
			"x-ui": {
				"group": "Placement",
				"order": 8
			}
		}
	}
}
