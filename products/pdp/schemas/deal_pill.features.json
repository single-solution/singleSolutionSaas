{
	"type": "object",
	"title": "Deal pill",
	"additionalProperties": false,
	"properties": {
		"target": {
			"type": "string",
			"title": "Element of the other product",
			"default": "badges",
			"maxLength": 40,
			"x-kind": "config",
			"description": "Key of the other product’s element this block hosts (it renders nothing while that product is not active).",
			"pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$",
			"x-ui": {
				"widget": "text",
				"group": "Embed",
				"order": 1
			}
		},
		"refresh": {
			"type": "boolean",
			"title": "Refresh it for this item",
			"default": true,
			"x-kind": "flag",
			"x-ui": {
				"widget": "switch",
				"group": "Embed",
				"order": 2
			}
		},
		"placement": {
			"type": "object",
			"title": "Placement",
			"description": "Where the element renders (the shared placement v1 subset a feature form can edit: paths, selectors, page types, devices, consent, frequency).",
			"default": {
				"selectors": [
					{
						"selector": "[data-ss-slot=\"deals\"]",
						"position": "append"
					}
				]
			},
			"additionalProperties": false,
			"properties": {
				"paths": {
					"type": "object",
					"additionalProperties": false,
					"properties": {
						"include": {
							"type": "array",
							"maxItems": 100,
							"uniqueItems": true,
							"items": {
								"type": "string",
								"minLength": 1,
								"maxLength": 500,
								"pattern": "^/[^\\s]*$"
							}
						},
						"exclude": {
							"type": "array",
							"maxItems": 100,
							"uniqueItems": true,
							"items": {
								"type": "string",
								"minLength": 1,
								"maxLength": 500,
								"pattern": "^/[^\\s]*$"
							}
						}
					}
				},
				"selectors": {
					"type": "array",
					"maxItems": 20,
					"items": {
						"type": "object",
						"required": ["selector"],
						"additionalProperties": false,
						"properties": {
							"selector": {
								"type": "string",
								"minLength": 1,
								"maxLength": 500
							},
							"position": {
								"type": "string",
								"enum": ["before", "after", "prepend", "append", "replace"]
							}
						}
					}
				},
				"pageTypes": {
					"type": "array",
					"maxItems": 50,
					"uniqueItems": true,
					"items": {
						"type": "string",
						"minLength": 2,
						"maxLength": 40,
						"pattern": "^[a-z][a-z0-9]*(?:[-_][a-z0-9]+)*$"
					}
				},
				"devices": {
					"type": "array",
					"minItems": 1,
					"uniqueItems": true,
					"items": {
						"type": "string",
						"enum": ["mobile", "tablet", "desktop"]
					}
				},
				"consent": {
					"type": "array",
					"maxItems": 20,
					"uniqueItems": true,
					"items": {
						"type": "string",
						"minLength": 2,
						"maxLength": 40,
						"pattern": "^[a-z][a-z0-9]*(?:[-_][a-z0-9]+)*$"
					}
				},
				"frequency": {
					"type": "object",
					"additionalProperties": false,
					"properties": {
						"maxPerSession": {
							"type": "integer",
							"minimum": 1,
							"maximum": 10000
						},
						"maxPerDay": {
							"type": "integer",
							"minimum": 1,
							"maximum": 10000
						},
						"maxPerVisitor": {
							"type": "integer",
							"minimum": 1,
							"maximum": 10000
						}
					}
				}
			},
			"x-kind": "config",
			"x-ui": {
				"widget": "placement",
				"group": "Placement",
				"order": 3
			}
		}
	}
}
