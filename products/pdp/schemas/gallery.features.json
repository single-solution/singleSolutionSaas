{
	"type": "object",
	"title": "Gallery",
	"additionalProperties": false,
	"properties": {
		"layout": {
			"type": "string",
			"title": "Layout",
			"default": "carousel",
			"enum": ["carousel", "grid", "stacked"],
			"x-kind": "config",
			"x-experiment": true,
			"x-ui": {
				"widget": "select",
				"group": "Layout",
				"order": 1
			}
		},
		"aspect_ratio": {
			"type": "string",
			"title": "Aspect ratio",
			"default": "1:1",
			"enum": ["1:1", "4:3", "3:4", "4:5", "16:9", "auto"],
			"x-kind": "config",
			"x-ui": {
				"widget": "select",
				"group": "Layout",
				"order": 2
			}
		},
		"thumbnails": {
			"type": "boolean",
			"title": "Thumbnails",
			"default": true,
			"x-kind": "flag",
			"x-ui": {
				"widget": "switch",
				"group": "Layout",
				"order": 3
			}
		},
		"max_images": {
			"type": "integer",
			"title": "Maximum images",
			"default": 12,
			"minimum": 1,
			"maximum": 50,
			"x-kind": "limit",
			"x-plan": {
				"standard": {
					"default": 12,
					"max": 50
				}
			},
			"x-ui": {
				"widget": "number",
				"group": "Layout",
				"order": 4
			}
		},
		"zoom": {
			"type": "boolean",
			"title": "Zoom",
			"default": true,
			"x-kind": "flag",
			"x-ui": {
				"widget": "switch",
				"group": "Media",
				"order": 5
			}
		},
		"video": {
			"type": "boolean",
			"title": "Videos",
			"default": true,
			"x-kind": "flag",
			"x-ui": {
				"widget": "switch",
				"group": "Media",
				"order": 6
			}
		},
		"lazy": {
			"type": "string",
			"title": "Loading strategy",
			"default": "first_eager",
			"enum": ["first_eager", "all_lazy", "all_eager"],
			"x-kind": "config",
			"description": "first_eager: the priority image loads at once with high priority, the others when needed.",
			"x-ui": {
				"widget": "select",
				"group": "Performance",
				"order": 7
			}
		},
		"priority_index": {
			"type": "integer",
			"title": "Priority image (0 = first)",
			"default": 0,
			"minimum": 0,
			"maximum": 49,
			"x-kind": "limit",
			"x-ui": {
				"widget": "number",
				"group": "Performance",
				"order": 8
			}
		},
		"source_url": {
			"type": "string",
			"title": "JSON source URL",
			"description": "Optional public https JSON document of the item, read when the page lacks data. Placeholders: {id} (the page item id), {path}, and the hosted page route parameters.",
			"default": "",
			"maxLength": 1000,
			"pattern": "^(?:$|https://)",
			"x-kind": "config",
			"x-ui": {
				"widget": "url",
				"group": "Data source",
				"order": 9,
				"placeholder": "https://example.com/items/{id}.json",
				"advanced": true
			}
		},
		"source_fields": {
			"type": "object",
			"title": "JSON field mapping",
			"description": "Dot path of each item field in the JSON source (e.g. data.product.name); `root` selects the item object. Unmapped fields are read from same-named properties.",
			"default": {},
			"additionalProperties": false,
			"properties": {
				"root": {
					"type": "string",
					"maxLength": 200,
					"pattern": "^[A-Za-z0-9_$.-]*$"
				},
				"id": {
					"type": "string",
					"maxLength": 200,
					"pattern": "^[A-Za-z0-9_$.-]*$"
				},
				"title": {
					"type": "string",
					"maxLength": 200,
					"pattern": "^[A-Za-z0-9_$.-]*$"
				},
				"subtitle": {
					"type": "string",
					"maxLength": 200,
					"pattern": "^[A-Za-z0-9_$.-]*$"
				},
				"brand": {
					"type": "string",
					"maxLength": 200,
					"pattern": "^[A-Za-z0-9_$.-]*$"
				},
				"description": {
					"type": "string",
					"maxLength": 200,
					"pattern": "^[A-Za-z0-9_$.-]*$"
				},
				"url": {
					"type": "string",
					"maxLength": 200,
					"pattern": "^[A-Za-z0-9_$.-]*$"
				},
				"sku": {
					"type": "string",
					"maxLength": 200,
					"pattern": "^[A-Za-z0-9_$.-]*$"
				},
				"gtin": {
					"type": "string",
					"maxLength": 200,
					"pattern": "^[A-Za-z0-9_$.-]*$"
				},
				"mpn": {
					"type": "string",
					"maxLength": 200,
					"pattern": "^[A-Za-z0-9_$.-]*$"
				},
				"category": {
					"type": "string",
					"maxLength": 200,
					"pattern": "^[A-Za-z0-9_$.-]*$"
				},
				"condition": {
					"type": "string",
					"maxLength": 200,
					"pattern": "^[A-Za-z0-9_$.-]*$"
				},
				"availability": {
					"type": "string",
					"maxLength": 200,
					"pattern": "^[A-Za-z0-9_$.-]*$"
				},
				"stock": {
					"type": "string",
					"maxLength": 200,
					"pattern": "^[A-Za-z0-9_$.-]*$"
				},
				"price": {
					"type": "string",
					"maxLength": 200,
					"pattern": "^[A-Za-z0-9_$.-]*$"
				},
				"compareAtPrice": {
					"type": "string",
					"maxLength": 200,
					"pattern": "^[A-Za-z0-9_$.-]*$"
				},
				"currency": {
					"type": "string",
					"maxLength": 200,
					"pattern": "^[A-Za-z0-9_$.-]*$"
				},
				"images": {
					"type": "string",
					"maxLength": 200,
					"pattern": "^[A-Za-z0-9_$.-]*$"
				},
				"ratingValue": {
					"type": "string",
					"maxLength": 200,
					"pattern": "^[A-Za-z0-9_$.-]*$"
				},
				"ratingCount": {
					"type": "string",
					"maxLength": 200,
					"pattern": "^[A-Za-z0-9_$.-]*$"
				},
				"faq": {
					"type": "string",
					"maxLength": 200,
					"pattern": "^[A-Za-z0-9_$.-]*$"
				},
				"related": {
					"type": "string",
					"maxLength": 200,
					"pattern": "^[A-Za-z0-9_$.-]*$"
				},
				"attributes": {
					"type": "string",
					"maxLength": 200,
					"pattern": "^[A-Za-z0-9_$.-]*$"
				}
			},
			"x-kind": "config",
			"x-ui": {
				"widget": "mapping",
				"group": "Data source",
				"order": 10,
				"advanced": true
			}
		},
		"placement": {
			"type": "object",
			"title": "Placement",
			"description": "Where the element renders (the shared placement v1 subset a feature form can edit: paths, selectors, page types, devices, consent, frequency).",
			"default": {
				"selectors": [
					{
						"selector": "[data-ss-slot=\"gallery\"]",
						"position": "append"
					}
				]
			},
			"additionalProperties": false,
			"properties": {
				"paths": {
					"type": "object",
					"additionalProperties": false,
					"properties": {
						"include": {
							"type": "array",
							"maxItems": 100,
							"uniqueItems": true,
							"items": {
								"type": "string",
								"minLength": 1,
								"maxLength": 500,
								"pattern": "^/[^\\s]*$"
							}
						},
						"exclude": {
							"type": "array",
							"maxItems": 100,
							"uniqueItems": true,
							"items": {
								"type": "string",
								"minLength": 1,
								"maxLength": 500,
								"pattern": "^/[^\\s]*$"
							}
						}
					}
				},
				"selectors": {
					"type": "array",
					"maxItems": 20,
					"items": {
						"type": "object",
						"required": ["selector"],
						"additionalProperties": false,
						"properties": {
							"selector": {
								"type": "string",
								"minLength": 1,
								"maxLength": 500
							},
							"position": {
								"type": "string",
								"enum": ["before", "after", "prepend", "append", "replace"]
							}
						}
					}
				},
				"pageTypes": {
					"type": "array",
					"maxItems": 50,
					"uniqueItems": true,
					"items": {
						"type": "string",
						"minLength": 2,
						"maxLength": 40,
						"pattern": "^[a-z][a-z0-9]*(?:[-_][a-z0-9]+)*$"
					}
				},
				"devices": {
					"type": "array",
					"minItems": 1,
					"uniqueItems": true,
					"items": {
						"type": "string",
						"enum": ["mobile", "tablet", "desktop"]
					}
				},
				"consent": {
					"type": "array",
					"maxItems": 20,
					"uniqueItems": true,
					"items": {
						"type": "string",
						"minLength": 2,
						"maxLength": 40,
						"pattern": "^[a-z][a-z0-9]*(?:[-_][a-z0-9]+)*$"
					}
				},
				"frequency": {
					"type": "object",
					"additionalProperties": false,
					"properties": {
						"maxPerSession": {
							"type": "integer",
							"minimum": 1,
							"maximum": 10000
						},
						"maxPerDay": {
							"type": "integer",
							"minimum": 1,
							"maximum": 10000
						},
						"maxPerVisitor": {
							"type": "integer",
							"minimum": 1,
							"maximum": 10000
						}
					}
				}
			},
			"x-kind": "config",
			"x-ui": {
				"widget": "placement",
				"group": "Placement",
				"order": 11
			}
		}
	}
}
