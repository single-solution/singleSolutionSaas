{
	"type": "object",
	"title": "Sticky buy bar",
	"additionalProperties": false,
	"properties": {
		"devices": {
			"type": "array",
			"title": "Devices",
			"default": ["mobile"],
			"minItems": 1,
			"uniqueItems": true,
			"items": {
				"type": "string",
				"enum": ["mobile", "tablet", "desktop"]
			},
			"x-kind": "config",
			"x-ui": {
				"widget": "checkboxes",
				"group": "Show rules",
				"order": 1
			}
		},
		"mode": {
			"type": "string",
			"title": "Show",
			"default": "after_cta",
			"enum": ["after_cta", "after_scroll", "always"],
			"x-kind": "config",
			"description": "after_cta: once the page’s own buy button scrolled out of view.",
			"x-experiment": true,
			"x-ui": {
				"widget": "select",
				"group": "Show rules",
				"order": 2
			}
		},
		"scroll_percent": {
			"type": "integer",
			"title": "Scroll depth (%) for after_scroll",
			"default": 30,
			"minimum": 0,
			"maximum": 100,
			"x-kind": "config",
			"x-ui": {
				"widget": "number",
				"group": "Show rules",
				"order": 3
			}
		},
		"hide_unavailable": {
			"type": "boolean",
			"title": "Hide while unavailable",
			"default": true,
			"x-kind": "flag",
			"x-ui": {
				"widget": "switch",
				"group": "Show rules",
				"order": 4
			}
		},
		"cta_selector": {
			"type": "string",
			"title": "Page buy button (CSS selector)",
			"default": "[data-ss-buy]",
			"maxLength": 200,
			"x-kind": "config",
			"x-ui": {
				"widget": "text",
				"group": "Action",
				"order": 5
			}
		},
		"action": {
			"type": "string",
			"title": "Button action",
			"default": "click",
			"enum": ["click", "scroll"],
			"x-kind": "config",
			"description": "click: presses the page’s buy button; scroll: brings it into view.",
			"x-ui": {
				"widget": "select",
				"group": "Action",
				"order": 6
			}
		},
		"show_price": {
			"type": "boolean",
			"title": "Price",
			"default": true,
			"x-kind": "flag",
			"x-ui": {
				"widget": "switch",
				"group": "Display",
				"order": 7
			}
		},
		"currency_display": {
			"type": "string",
			"title": "Currency display",
			"default": "symbol",
			"enum": ["symbol", "narrowSymbol", "code", "name"],
			"x-kind": "config",
			"x-ui": {
				"widget": "select",
				"group": "Display",
				"order": 8
			}
		},
		"locale": {
			"type": "string",
			"title": "Locale (empty = the page language)",
			"default": "",
			"maxLength": 35,
			"x-kind": "config",
			"pattern": "^(?:$|[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*)$",
			"x-ui": {
				"widget": "text",
				"group": "Display",
				"order": 9
			}
		},
		"dismissible": {
			"type": "boolean",
			"title": "Can be hidden",
			"default": false,
			"x-kind": "flag",
			"x-ui": {
				"widget": "switch",
				"group": "Display",
				"order": 10
			}
		},
		"source_url": {
			"type": "string",
			"title": "JSON source URL",
			"description": "Optional public https JSON document of the item, read when the page lacks data. Placeholders: {id} (the page item id), {path}, and the hosted page route parameters.",
			"default": "",
			"maxLength": 1000,
			"pattern": "^(?:$|https://)",
			"x-kind": "config",
			"x-ui": {
				"widget": "url",
				"group": "Data source",
				"order": 11,
				"placeholder": "https://example.com/items/{id}.json",
				"advanced": true
			}
		},
		"source_fields": {
			"type": "object",
			"title": "JSON field mapping",
			"description": "Dot path of each item field in the JSON source (e.g. data.product.name); `root` selects the item object. Unmapped fields are read from same-named properties.",
			"default": {},
			"additionalProperties": false,
			"properties": {
				"root": {
					"type": "string",
					"maxLength": 200,
					"pattern": "^[A-Za-z0-9_$.-]*$"
				},
				"id": {
					"type": "string",
					"maxLength": 200,
					"pattern": "^[A-Za-z0-9_$.-]*$"
				},
				"title": {
					"type": "string",
					"maxLength": 200,
					"pattern": "^[A-Za-z0-9_$.-]*$"
				},
				"subtitle": {
					"type": "string",
					"maxLength": 200,
					"pattern": "^[A-Za-z0-9_$.-]*$"
				},
				"brand": {
					"type": "string",
					"maxLength": 200,
					"pattern": "^[A-Za-z0-9_$.-]*$"
				},
				"description": {
					"type": "string",
					"maxLength": 200,
					"pattern": "^[A-Za-z0-9_$.-]*$"
				},
				"url": {
					"type": "string",
					"maxLength": 200,
					"pattern": "^[A-Za-z0-9_$.-]*$"
				},
				"sku": {
					"type": "string",
					"maxLength": 200,
					"pattern": "^[A-Za-z0-9_$.-]*$"
				},
				"gtin": {
					"type": "string",
					"maxLength": 200,
					"pattern": "^[A-Za-z0-9_$.-]*$"
				},
				"mpn": {
					"type": "string",
					"maxLength": 200,
					"pattern": "^[A-Za-z0-9_$.-]*$"
				},
				"category": {
					"type": "string",
					"maxLength": 200,
					"pattern": "^[A-Za-z0-9_$.-]*$"
				},
				"condition": {
					"type": "string",
					"maxLength": 200,
					"pattern": "^[A-Za-z0-9_$.-]*$"
				},
				"availability": {
					"type": "string",
					"maxLength": 200,
					"pattern": "^[A-Za-z0-9_$.-]*$"
				},
				"stock": {
					"type": "string",
					"maxLength": 200,
					"pattern": "^[A-Za-z0-9_$.-]*$"
				},
				"price": {
					"type": "string",
					"maxLength": 200,
					"pattern": "^[A-Za-z0-9_$.-]*$"
				},
				"compareAtPrice": {
					"type": "string",
					"maxLength": 200,
					"pattern": "^[A-Za-z0-9_$.-]*$"
				},
				"currency": {
					"type": "string",
					"maxLength": 200,
					"pattern": "^[A-Za-z0-9_$.-]*$"
				},
				"images": {
					"type": "string",
					"maxLength": 200,
					"pattern": "^[A-Za-z0-9_$.-]*$"
				},
				"ratingValue": {
					"type": "string",
					"maxLength": 200,
					"pattern": "^[A-Za-z0-9_$.-]*$"
				},
				"ratingCount": {
					"type": "string",
					"maxLength": 200,
					"pattern": "^[A-Za-z0-9_$.-]*$"
				},
				"faq": {
					"type": "string",
					"maxLength": 200,
					"pattern": "^[A-Za-z0-9_$.-]*$"
				},
				"related": {
					"type": "string",
					"maxLength": 200,
					"pattern": "^[A-Za-z0-9_$.-]*$"
				},
				"attributes": {
					"type": "string",
					"maxLength": 200,
					"pattern": "^[A-Za-z0-9_$.-]*$"
				}
			},
			"x-kind": "config",
			"x-ui": {
				"widget": "mapping",
				"group": "Data source",
				"order": 12,
				"advanced": true
			}
		},
		"placement": {
			"type": "object",
			"title": "Placement",
			"description": "Where the element renders (the shared placement v1 subset a feature form can edit: paths, selectors, page types, devices, consent, frequency).",
			"default": {
				"selectors": [
					{
						"selector": "[data-ss-buy]",
						"position": "after"
					}
				]
			},
			"additionalProperties": false,
			"properties": {
				"paths": {
					"type": "object",
					"additionalProperties": false,
					"properties": {
						"include": {
							"type": "array",
							"maxItems": 100,
							"uniqueItems": true,
							"items": {
								"type": "string",
								"minLength": 1,
								"maxLength": 500,
								"pattern": "^/[^\\s]*$"
							}
						},
						"exclude": {
							"type": "array",
							"maxItems": 100,
							"uniqueItems": true,
							"items": {
								"type": "string",
								"minLength": 1,
								"maxLength": 500,
								"pattern": "^/[^\\s]*$"
							}
						}
					}
				},
				"selectors": {
					"type": "array",
					"maxItems": 20,
					"items": {
						"type": "object",
						"required": ["selector"],
						"additionalProperties": false,
						"properties": {
							"selector": {
								"type": "string",
								"minLength": 1,
								"maxLength": 500
							},
							"position": {
								"type": "string",
								"enum": ["before", "after", "prepend", "append", "replace"]
							}
						}
					}
				},
				"pageTypes": {
					"type": "array",
					"maxItems": 50,
					"uniqueItems": true,
					"items": {
						"type": "string",
						"minLength": 2,
						"maxLength": 40,
						"pattern": "^[a-z][a-z0-9]*(?:[-_][a-z0-9]+)*$"
					}
				},
				"devices": {
					"type": "array",
					"minItems": 1,
					"uniqueItems": true,
					"items": {
						"type": "string",
						"enum": ["mobile", "tablet", "desktop"]
					}
				},
				"consent": {
					"type": "array",
					"maxItems": 20,
					"uniqueItems": true,
					"items": {
						"type": "string",
						"minLength": 2,
						"maxLength": 40,
						"pattern": "^[a-z][a-z0-9]*(?:[-_][a-z0-9]+)*$"
					}
				},
				"frequency": {
					"type": "object",
					"additionalProperties": false,
					"properties": {
						"maxPerSession": {
							"type": "integer",
							"minimum": 1,
							"maximum": 10000
						},
						"maxPerDay": {
							"type": "integer",
							"minimum": 1,
							"maximum": 10000
						},
						"maxPerVisitor": {
							"type": "integer",
							"minimum": 1,
							"maximum": 10000
						}
					}
				}
			},
			"x-kind": "config",
			"x-ui": {
				"widget": "placement",
				"group": "Placement",
				"order": 13
			}
		}
	}
}
