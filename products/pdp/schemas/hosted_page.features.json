{
	"type": "object",
	"title": "Hosted page",
	"additionalProperties": false,
	"properties": {
		"route_pattern": {
			"type": "string",
			"title": "Route pattern",
			"default": "/p/{slug}",
			"maxLength": 200,
			"x-kind": "config",
			"description": "Path of the page: literal segments, {name} parameters and *; the parameters fill the JSON source URL.",
			"pattern": "^/[A-Za-z0-9_.~{}*/-]*$",
			"x-ui": {
				"widget": "text",
				"group": "Route",
				"order": 1
			}
		},
		"slots": {
			"type": "array",
			"title": "Slots",
			"description": "Named places ([data-ss-slot=\"…\"]) for the other elements, in order.",
			"default": ["gallery", "price", "deals", "configurator", "alerts", "grade", "share", "reviews", "faq", "related"],
			"maxItems": 20,
			"uniqueItems": true,
			"items": {
				"type": "string",
				"pattern": "^[a-z][a-z0-9-]{0,39}$"
			},
			"x-kind": "config",
			"x-ui": {
				"widget": "list",
				"group": "Layout",
				"order": 2
			}
		},
		"show_image": {
			"type": "boolean",
			"title": "Primary image",
			"default": true,
			"x-kind": "flag",
			"x-ui": {
				"widget": "switch",
				"group": "Layout",
				"order": 3
			}
		},
		"show_attributes": {
			"type": "boolean",
			"title": "Attributes",
			"default": true,
			"x-kind": "flag",
			"x-ui": {
				"widget": "switch",
				"group": "Layout",
				"order": 4
			}
		},
		"set_title": {
			"type": "boolean",
			"title": "Document title",
			"default": true,
			"x-kind": "flag",
			"x-ui": {
				"widget": "switch",
				"group": "Metadata",
				"order": 5
			}
		},
		"set_description": {
			"type": "boolean",
			"title": "Meta description",
			"default": true,
			"x-kind": "flag",
			"x-ui": {
				"widget": "switch",
				"group": "Metadata",
				"order": 6
			}
		},
		"canonical_url": {
			"type": "string",
			"title": "Canonical URL template (empty = the page)",
			"default": "",
			"maxLength": 1000,
			"x-kind": "config",
			"pattern": "^(?:$|https://)",
			"x-ui": {
				"widget": "text",
				"group": "Metadata",
				"order": 7
			}
		},
		"robots": {
			"type": "string",
			"title": "Search engines",
			"default": "index",
			"enum": ["index", "noindex"],
			"x-kind": "config",
			"x-ui": {
				"widget": "select",
				"group": "Metadata",
				"order": 8
			}
		},
		"source_url": {
			"type": "string",
			"title": "JSON source URL",
			"description": "Optional public https JSON document of the item, read when the page lacks data. Placeholders: {id} (the page item id), {path}, and the hosted page route parameters.",
			"default": "",
			"maxLength": 1000,
			"pattern": "^(?:$|https://)",
			"x-kind": "config",
			"x-ui": {
				"widget": "url",
				"group": "Data source",
				"order": 9,
				"placeholder": "https://example.com/items/{id}.json",
				"advanced": true
			}
		},
		"source_fields": {
			"type": "object",
			"title": "JSON field mapping",
			"description": "Dot path of each item field in the JSON source (e.g. data.product.name); `root` selects the item object. Unmapped fields are read from same-named properties.",
			"default": {},
			"additionalProperties": false,
			"properties": {
				"root": {
					"type": "string",
					"maxLength": 200,
					"pattern": "^[A-Za-z0-9_$.-]*$"
				},
				"id": {
					"type": "string",
					"maxLength": 200,
					"pattern": "^[A-Za-z0-9_$.-]*$"
				},
				"title": {
					"type": "string",
					"maxLength": 200,
					"pattern": "^[A-Za-z0-9_$.-]*$"
				},
				"subtitle": {
					"type": "string",
					"maxLength": 200,
					"pattern": "^[A-Za-z0-9_$.-]*$"
				},
				"brand": {
					"type": "string",
					"maxLength": 200,
					"pattern": "^[A-Za-z0-9_$.-]*$"
				},
				"description": {
					"type": "string",
					"maxLength": 200,
					"pattern": "^[A-Za-z0-9_$.-]*$"
				},
				"url": {
					"type": "string",
					"maxLength": 200,
					"pattern": "^[A-Za-z0-9_$.-]*$"
				},
				"sku": {
					"type": "string",
					"maxLength": 200,
					"pattern": "^[A-Za-z0-9_$.-]*$"
				},
				"gtin": {
					"type": "string",
					"maxLength": 200,
					"pattern": "^[A-Za-z0-9_$.-]*$"
				},
				"mpn": {
					"type": "string",
					"maxLength": 200,
					"pattern": "^[A-Za-z0-9_$.-]*$"
				},
				"category": {
					"type": "string",
					"maxLength": 200,
					"pattern": "^[A-Za-z0-9_$.-]*$"
				},
				"condition": {
					"type": "string",
					"maxLength": 200,
					"pattern": "^[A-Za-z0-9_$.-]*$"
				},
				"availability": {
					"type": "string",
					"maxLength": 200,
					"pattern": "^[A-Za-z0-9_$.-]*$"
				},
				"stock": {
					"type": "string",
					"maxLength": 200,
					"pattern": "^[A-Za-z0-9_$.-]*$"
				},
				"price": {
					"type": "string",
					"maxLength": 200,
					"pattern": "^[A-Za-z0-9_$.-]*$"
				},
				"compareAtPrice": {
					"type": "string",
					"maxLength": 200,
					"pattern": "^[A-Za-z0-9_$.-]*$"
				},
				"currency": {
					"type": "string",
					"maxLength": 200,
					"pattern": "^[A-Za-z0-9_$.-]*$"
				},
				"images": {
					"type": "string",
					"maxLength": 200,
					"pattern": "^[A-Za-z0-9_$.-]*$"
				},
				"ratingValue": {
					"type": "string",
					"maxLength": 200,
					"pattern": "^[A-Za-z0-9_$.-]*$"
				},
				"ratingCount": {
					"type": "string",
					"maxLength": 200,
					"pattern": "^[A-Za-z0-9_$.-]*$"
				},
				"faq": {
					"type": "string",
					"maxLength": 200,
					"pattern": "^[A-Za-z0-9_$.-]*$"
				},
				"related": {
					"type": "string",
					"maxLength": 200,
					"pattern": "^[A-Za-z0-9_$.-]*$"
				},
				"attributes": {
					"type": "string",
					"maxLength": 200,
					"pattern": "^[A-Za-z0-9_$.-]*$"
				}
			},
			"x-kind": "config",
			"x-ui": {
				"widget": "mapping",
				"group": "Data source",
				"order": 10,
				"advanced": true
			}
		},
		"placement": {
			"type": "object",
			"title": "Placement",
			"description": "Where the element renders (the shared placement v1 subset a feature form can edit: paths, selectors, page types, devices, consent, frequency).",
			"default": {
				"paths": {
					"include": ["/p/*"]
				}
			},
			"additionalProperties": false,
			"properties": {
				"paths": {
					"type": "object",
					"additionalProperties": false,
					"properties": {
						"include": {
							"type": "array",
							"maxItems": 100,
							"uniqueItems": true,
							"items": {
								"type": "string",
								"minLength": 1,
								"maxLength": 500,
								"pattern": "^/[^\\s]*$"
							}
						},
						"exclude": {
							"type": "array",
							"maxItems": 100,
							"uniqueItems": true,
							"items": {
								"type": "string",
								"minLength": 1,
								"maxLength": 500,
								"pattern": "^/[^\\s]*$"
							}
						}
					}
				},
				"selectors": {
					"type": "array",
					"maxItems": 20,
					"items": {
						"type": "object",
						"required": ["selector"],
						"additionalProperties": false,
						"properties": {
							"selector": {
								"type": "string",
								"minLength": 1,
								"maxLength": 500
							},
							"position": {
								"type": "string",
								"enum": ["before", "after", "prepend", "append", "replace"]
							}
						}
					}
				},
				"pageTypes": {
					"type": "array",
					"maxItems": 50,
					"uniqueItems": true,
					"items": {
						"type": "string",
						"minLength": 2,
						"maxLength": 40,
						"pattern": "^[a-z][a-z0-9]*(?:[-_][a-z0-9]+)*$"
					}
				},
				"devices": {
					"type": "array",
					"minItems": 1,
					"uniqueItems": true,
					"items": {
						"type": "string",
						"enum": ["mobile", "tablet", "desktop"]
					}
				},
				"consent": {
					"type": "array",
					"maxItems": 20,
					"uniqueItems": true,
					"items": {
						"type": "string",
						"minLength": 2,
						"maxLength": 40,
						"pattern": "^[a-z][a-z0-9]*(?:[-_][a-z0-9]+)*$"
					}
				},
				"frequency": {
					"type": "object",
					"additionalProperties": false,
					"properties": {
						"maxPerSession": {
							"type": "integer",
							"minimum": 1,
							"maximum": 10000
						},
						"maxPerDay": {
							"type": "integer",
							"minimum": 1,
							"maximum": 10000
						},
						"maxPerVisitor": {
							"type": "integer",
							"minimum": 1,
							"maximum": 10000
						}
					}
				}
			},
			"x-kind": "config",
			"x-ui": {
				"widget": "placement",
				"group": "Placement",
				"order": 11
			}
		}
	}
}
