{
	"type": "object",
	"title": "Moderation",
	"additionalProperties": false,
	"properties": {
		"rules": {
			"type": "array",
			"title": "Auto-moderation rules",
			"description": "Evaluated in order after the content checks; the first matching rule decides. Conditions use rules@1 over review, customer, item, flags and now.",
			"default": [
				{
					"id": "verified_clean",
					"name": "Approve clean reviews from verified buyers",
					"when": "review.verified and len(flags) == 0",
					"action": "approve",
					"reason": "",
					"enabled": true
				}
			],
			"minItems": 0,
			"maxItems": 50,
			"x-kind": "config",
			"x-plan": { "starter": { "max": 3 }, "pro": { "max": 25 } },
			"x-ui": { "widget": "list", "group": "Rules", "order": 1, "help": "review.rating >= 4 and review.length >= 40" },
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": ["id", "action"],
				"properties": {
					"id": { "type": "string", "title": "Rule id", "minLength": 1, "maxLength": 40, "pattern": "^[a-z][a-z0-9_]*$" },
					"name": { "type": "string", "title": "Name", "maxLength": 120 },
					"when": { "type": "string", "title": "Condition (rules@1)", "description": "Empty = always.", "maxLength": 2000 },
					"action": { "type": "string", "title": "Action", "enum": ["approve", "reject", "queue"] },
					"reason": {
						"type": "string",
						"title": "Rejection reason",
						"description": "Reason code recorded when the action is reject.",
						"maxLength": 40,
						"pattern": "^(?:[a-z][a-z0-9_]*)?$"
					},
					"enabled": { "type": "boolean", "title": "Enabled" }
				}
			}
		},
		"default_action": {
			"type": "string",
			"title": "When no rule matches",
			"default": "queue",
			"enum": ["queue", "approve"],
			"x-kind": "config",
			"x-ui": { "widget": "select", "group": "Rules", "order": 2 }
		},
		"auto_approve_unverified": {
			"type": "boolean",
			"title": "Rules may approve unverified reviews",
			"description": "Off: reviews without a verified purchase always wait for a person.",
			"default": false,
			"x-kind": "flag",
			"x-ui": { "widget": "switch", "group": "Rules", "order": 3 }
		},
		"blocked_terms": {
			"type": "array",
			"title": "Blocked words and phrases",
			"description": "Your own list, any language; matched case-insensitively on whole words.",
			"default": [],
			"maxItems": 1000,
			"uniqueItems": true,
			"items": { "type": "string", "minLength": 1, "maxLength": 80 },
			"x-kind": "config",
			"x-ui": { "widget": "tags", "group": "Content checks", "order": 4 }
		},
		"blocked_term_action": {
			"type": "string",
			"title": "On a blocked word",
			"default": "queue",
			"enum": ["queue", "reject"],
			"x-kind": "config",
			"x-ui": { "widget": "select", "group": "Content checks", "order": 5 }
		},
		"max_links": {
			"type": "integer",
			"title": "Links allowed in a review",
			"default": 0,
			"minimum": 0,
			"maximum": 20,
			"x-kind": "limit",
			"x-ui": { "widget": "number", "group": "Content checks", "order": 6 }
		},
		"link_action": {
			"type": "string",
			"title": "On too many links",
			"default": "queue",
			"enum": ["queue", "reject"],
			"x-kind": "config",
			"x-ui": { "widget": "select", "group": "Content checks", "order": 7 }
		},
		"queue_shorter_than": {
			"type": "integer",
			"title": "Queue reviews shorter than (characters, 0 = off)",
			"default": 0,
			"minimum": 0,
			"maximum": 2000,
			"x-kind": "config",
			"x-ui": { "widget": "number", "group": "Content checks", "order": 8 }
		},
		"rejection_reasons": {
			"type": "array",
			"title": "Rejection reasons",
			"default": ["spam", "offensive", "off_topic", "personal_data", "not_genuine", "other"],
			"minItems": 1,
			"maxItems": 30,
			"uniqueItems": true,
			"items": { "type": "string", "minLength": 1, "maxLength": 40, "pattern": "^[a-z][a-z0-9_]*$" },
			"x-kind": "config",
			"x-ui": { "widget": "tags", "group": "Manual", "order": 9 }
		},
		"replies_enabled": {
			"type": "boolean",
			"title": "Public merchant replies",
			"default": true,
			"x-kind": "flag",
			"x-ui": { "widget": "switch", "group": "Manual", "order": 10 }
		},
		"reply_max_length": {
			"type": "integer",
			"title": "Reply length (characters)",
			"default": 1000,
			"minimum": 50,
			"maximum": 5000,
			"x-kind": "limit",
			"x-ui": { "widget": "number", "group": "Manual", "order": 11 }
		}
	}
}
