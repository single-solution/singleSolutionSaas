{
	"type": "object",
	"title": "Request flow",
	"additionalProperties": false,
	"properties": {
		"review_url": {
			"type": "string",
			"title": "Review page URL",
			"description": "Your page where customers write the review. Placeholders: {token} (signed link token, required), {orderId}, {requestId}. Requests are not sent while this is empty.",
			"default": "",
			"maxLength": 500,
			"pattern": "^(?:https://[^\\s]+)?$",
			"x-kind": "config",
			"x-ui": {
				"widget": "text",
				"group": "Link",
				"order": 1,
				"help": "https://shop.example.com/review?t={token}"
			}
		},
		"channels": {
			"type": "array",
			"title": "Channels (in order of preference)",
			"description": "The first channel the customer has a contact for is used; the message goes through your messaging connector.",
			"default": ["email"],
			"minItems": 1,
			"maxItems": 3,
			"uniqueItems": true,
			"items": {
				"type": "string",
				"enum": ["email", "sms", "whatsapp"]
			},
			"x-kind": "config",
			"x-ui": {
				"widget": "tags",
				"group": "Delivery",
				"order": 2
			}
		},
		"reminders": {
			"type": "array",
			"title": "Reminders (days after the first request)",
			"description": "Each entry sends one reminder that many days after the first request while items are still unreviewed.",
			"default": [7],
			"minItems": 0,
			"maxItems": 5,
			"items": {
				"type": "integer",
				"minimum": 1,
				"maximum": 365
			},
			"x-kind": "config",
			"x-plan": {
				"starter": {
					"max": 1
				},
				"pro": {
					"max": 5
				}
			},
			"x-ui": {
				"widget": "list",
				"group": "Delivery",
				"order": 3
			}
		},
		"quiet_hours": {
			"type": "object",
			"title": "Quiet hours (website time zone)",
			"description": "No messages are sent between start and end (HH:MM, may cross midnight); start = end disables quiet hours.",
			"default": {
				"start": "21:00",
				"end": "08:00"
			},
			"additionalProperties": false,
			"properties": {
				"start": {
					"type": "string",
					"title": "Start",
					"pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
				},
				"end": {
					"type": "string",
					"title": "End",
					"pattern": "^(?:(?:[01][0-9]|2[0-3]):[0-5][0-9]|24:00)$"
				}
			},
			"x-kind": "config",
			"x-ui": {
				"widget": "group",
				"group": "Delivery",
				"order": 4
			}
		},
		"request_template": {
			"type": "string",
			"title": "Request template id",
			"description": "Template id passed to your messaging provider for the first request (the rendered text is sent too).",
			"default": "review_request",
			"minLength": 1,
			"maxLength": 100,
			"pattern": "^[A-Za-z0-9_.:-]+$",
			"x-kind": "config",
			"x-ui": {
				"widget": "text",
				"group": "Templates",
				"order": 5
			}
		},
		"reminder_template": {
			"type": "string",
			"title": "Reminder template id",
			"default": "review_reminder",
			"minLength": 1,
			"maxLength": 100,
			"pattern": "^[A-Za-z0-9_.:-]+$",
			"x-kind": "config",
			"x-ui": {
				"widget": "text",
				"group": "Templates",
				"order": 6
			}
		},
		"language": {
			"type": "string",
			"title": "Message language",
			"description": "String catalog language of the rendered message text (falls back to en).",
			"default": "en",
			"pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$",
			"maxLength": 20,
			"x-kind": "config",
			"x-ui": {
				"widget": "text",
				"group": "Templates",
				"order": 7
			}
		},
		"max_attempts": {
			"type": "integer",
			"title": "Delivery attempts per message",
			"default": 3,
			"minimum": 1,
			"maximum": 10,
			"x-kind": "limit",
			"x-ui": {
				"widget": "number",
				"group": "Delivery",
				"order": 8
			}
		},
		"max_per_run": {
			"type": "integer",
			"title": "Messages per website and run",
			"default": 500,
			"minimum": 1,
			"maximum": 5000,
			"x-kind": "limit",
			"x-plan": {
				"starter": {
					"default": 200,
					"max": 500
				},
				"pro": {
					"default": 500,
					"max": 5000
				}
			},
			"x-ui": {
				"widget": "number",
				"group": "Limits",
				"order": 9
			}
		}
	}
}
