{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "reviews.submitted@1",
	"description": "A review was submitted (storefront, review link or API); status is the moderation outcome at submission.",
	"type": "object",
	"required": [
		"reviewId",
		"itemId",
		"rating",
		"ratingScale",
		"status",
		"verifiedPurchase",
		"source",
		"hasPhotos",
		"submittedAt"
	],
	"additionalProperties": false,
	"properties": {
		"reviewId": { "type": "string", "minLength": 1, "maxLength": 64 },
		"itemId": { "type": "string", "minLength": 1, "maxLength": 128 },
		"rating": { "type": "integer", "minimum": 1, "maximum": 10 },
		"ratingScale": { "type": "integer", "minimum": 3, "maximum": 10 },
		"status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
		"verifiedPurchase": { "type": "boolean" },
		"source": { "type": "string", "enum": ["storefront", "request_link", "api"] },
		"hasPhotos": { "type": "boolean" },
		"customerId": { "type": "string", "minLength": 1, "maxLength": 255 },
		"orderId": { "type": "string", "minLength": 1, "maxLength": 128 },
		"requestId": { "type": "string", "minLength": 1, "maxLength": 64 },
		"submittedAt": { "type": "string", "format": "date-time" }
	},
	"examples": [
		{
			"reviewId": "rev_0mf2k3x1rabcdefghjkmnpqr",
			"itemId": "itm_123",
			"rating": 5,
			"ratingScale": 5,
			"status": "approved",
			"verifiedPurchase": true,
			"source": "storefront",
			"hasPhotos": false,
			"customerId": "cus_123",
			"orderId": "ord_1001",
			"submittedAt": "2026-10-01T10:00:00.000Z"
		}
	]
}
