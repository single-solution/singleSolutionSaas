{
	"ssps": "1",
	"product": {
		"slug": "reviews",
		"name": "Reviews & Ratings",
		"kind": "service",
		"version": "1.0.0",
		"category": "engagement",
		"description": "Verified-purchase reviews collected after completed orders, review requests with reminders through your messaging, rules-based moderation with replies, attribute ratings and photos, drop-in or headless widgets, Product JSON-LD from approved reviews, Q&A, CSV import and analytics — all data in the merchant's own database."
	},
	"endpoints": {
		"base": "https://reviews.example.com",
		"dashboard": "/dashboard",
		"demo": "/dashboard",
		"events": "/.well-known/ss-events"
	},
	"capabilities": {
		"adminLaunch": true,
		"sandbox": true,
		"localEnforcement": [
			"limit:collection.max_reviews_per_customer_per_day",
			"limit:photos.max_photos_per_review",
			"limit:import.max_rows",
			"limit:qna.max_questions_per_customer_per_day"
		],
		"offlineGrace": "PT24H"
	},
	"scopes": ["events.subscribe:order.*"],
	"requires": {
		"resources": ["database"]
	},
	"events": {
		"consumes": ["order.completed@1", "order.placed@1", "order.cancelled@1", "order.refunded@1"],
		"publishes": ["reviews.submitted@1", "reviews.approved@1"]
	},
	"budget": {
		"shared": 1
	},
	"elements": [
		{
			"key": "collection",
			"name": "Collection",
			"description": "Who may review (verified buyers from order.completed@1 and your own login, identified customers or anyone), review requests timed after completion, signed review links, one review per order item, and the review submission API.",
			"modes": ["C"],
			"stateful": true,
			"price": {
				"hourly": 300,
				"metered": [
					{
						"unit": "review",
						"perUnit": 5,
						"included": {
							"starter": 300,
							"pro": 3000
						}
					}
				]
			},
			"budget": {
				"js": 0
			},
			"dependsOn": [],
			"requires": {
				"resources": ["database"]
			},
			"features": {
				"$ref": "schemas/collection.features.json"
			},
			"strings": "strings/en.json",
			"placement": false,
			"customFields": ["review"],
			"experiments": true,
			"api": {
				"resources": ["reviews", "review-requests"]
			},
			"headless": null,
			"renderer": null
		},
		{
			"key": "request_flow",
			"name": "Request flow",
			"description": "Review requests sent when the order completes, and reminders, through the merchant's own messaging connector (email, SMS, WhatsApp), quiet hours and retries (no scheduled jobs).",
			"modes": ["C"],
			"stateful": true,
			"price": {
				"hourly": 200
			},
			"budget": {
				"js": 0
			},
			"dependsOn": ["collection"],
			"requires": {
				"resources": ["messaging"]
			},
			"features": {
				"$ref": "schemas/request_flow.features.json"
			},
			"strings": "strings/en.json",
			"placement": false,
			"experiments": true,
			"api": {
				"resources": ["request-flow"]
			},
			"headless": null,
			"renderer": null
		},
		{
			"key": "moderation",
			"name": "Moderation",
			"description": "Auto-moderation with rules@1 conditions, blocked words, link and length checks, a manual queue with rejection reasons, and public merchant replies.",
			"modes": ["C"],
			"stateful": true,
			"price": {
				"hourly": 200
			},
			"budget": {
				"js": 0
			},
			"dependsOn": ["collection"],
			"features": {
				"$ref": "schemas/moderation.features.json"
			},
			"strings": "strings/en.json",
			"placement": false,
			"rules": ["when"],
			"api": {
				"resources": ["moderation"]
			},
			"headless": null,
			"renderer": null
		},
		{
			"key": "content",
			"name": "Content",
			"description": "Rating scale, title and text limits, and attribute ratings such as quality, value or fit.",
			"modes": ["C"],
			"stateful": false,
			"price": {
				"hourly": 100
			},
			"budget": {
				"js": 0
			},
			"dependsOn": ["collection"],
			"features": {
				"$ref": "schemas/content.features.json"
			},
			"strings": "strings/en.json",
			"placement": false,
			"api": {
				"resources": ["review-form"]
			},
			"headless": null,
			"renderer": null
		},
		{
			"key": "photos",
			"name": "Photos",
			"description": "Review photos uploaded straight to the merchant's own bucket with presigned links, type and size limits.",
			"modes": ["C"],
			"stateful": true,
			"price": {
				"hourly": 100
			},
			"budget": {
				"js": 0
			},
			"dependsOn": ["content"],
			"requires": {
				"resources": ["storage"]
			},
			"features": {
				"$ref": "schemas/photos.features.json"
			},
			"strings": "strings/en.json",
			"placement": false,
			"api": {
				"resources": ["review-photos"]
			},
			"headless": null,
			"renderer": null
		},
		{
			"key": "display",
			"name": "Display",
			"description": "Rating summary with distribution, review list with sorting, filters and pagination, stars for product lists, and the write-a-review form — drop-in, headless or API.",
			"modes": ["A", "B", "C"],
			"stateful": true,
			"price": {
				"hourly": 200
			},
			"budget": {
				"js": 7
			},
			"dependsOn": ["collection"],
			"features": {
				"$ref": "schemas/display.features.json"
			},
			"strings": "strings/en.json",
			"placement": true,
			"experiments": true,
			"api": {
				"resources": ["ratings"]
			},
			"headless": "headless/reviews.js#createReviews",
			"renderer": "ui/reviews.js#render",
			"variants": ["summary", "list", "stars"],
			"slots": ["before", "after", "empty"],
			"a11y": {
				"role": "region",
				"labels": true,
				"keyboard": true,
				"reducedMotion": true
			}
		},
		{
			"key": "structured_data",
			"name": "Structured data",
			"description": "Product JSON-LD with AggregateRating and Review nodes built only from approved reviews, per item.",
			"modes": ["C"],
			"stateful": true,
			"price": {
				"hourly": 100
			},
			"budget": {
				"js": 0
			},
			"dependsOn": ["collection"],
			"features": {
				"$ref": "schemas/structured_data.features.json"
			},
			"strings": "strings/en.json",
			"placement": false,
			"api": {
				"resources": ["structured-data"]
			},
			"headless": null,
			"renderer": null
		},
		{
			"key": "qna",
			"name": "Questions & answers",
			"description": "Shopper questions per item with merchant and community answers, moderation and limits.",
			"modes": ["C"],
			"stateful": true,
			"price": {
				"hourly": 200
			},
			"budget": {
				"js": 0
			},
			"dependsOn": ["collection"],
			"features": {
				"$ref": "schemas/qna.features.json"
			},
			"strings": "strings/en.json",
			"placement": false,
			"api": {
				"resources": ["questions"]
			},
			"headless": null,
			"renderer": null
		},
		{
			"key": "import",
			"name": "Import",
			"description": "CSV import of reviews from other platforms with row validation, a dry run, column mapping and duplicate protection.",
			"modes": ["C"],
			"stateful": true,
			"price": {
				"hourly": 100
			},
			"budget": {
				"js": 0
			},
			"dependsOn": ["collection"],
			"features": {
				"$ref": "schemas/import.features.json"
			},
			"strings": "strings/en.json",
			"placement": false,
			"api": {
				"resources": ["imports"]
			},
			"headless": null,
			"renderer": null
		},
		{
			"key": "analytics",
			"name": "Analytics",
			"description": "Volume, average rating and distribution over time, request conversion, moderation and reply times, top items.",
			"modes": ["C"],
			"stateful": true,
			"price": {
				"hourly": 100
			},
			"budget": {
				"js": 0
			},
			"dependsOn": ["collection"],
			"features": {
				"$ref": "schemas/analytics.features.json"
			},
			"strings": "strings/en.json",
			"placement": false,
			"api": {
				"resources": ["analytics"]
			},
			"headless": null,
			"renderer": null
		}
	],
	"plans": [
		{
			"code": "starter",
			"name": "Starter",
			"description": "Verified reviews, moderation, attribute ratings, the widgets and structured data; requests, photos, Q&A, import and analytics as add-ons.",
			"elements": ["collection", "moderation", "content", "display", "structured_data"],
			"addons": ["request_flow", "photos", "qna", "import", "analytics"]
		},
		{
			"code": "pro",
			"name": "Pro",
			"description": "Everything: request flow with reminders, photos, Q&A, import and analytics.",
			"elements": [
				"collection",
				"request_flow",
				"moderation",
				"content",
				"photos",
				"display",
				"structured_data",
				"qna",
				"import",
				"analytics"
			]
		}
	],
	"priceBook": {
		"version": "2026-10-01",
		"effectiveFrom": "2026-10-01T00:00:00Z"
	},
	"trialHours": 48,
	"retention": {
		"requests": "P730D",
		"orders": "P730D",
		"photos": "P30D"
	}
}
