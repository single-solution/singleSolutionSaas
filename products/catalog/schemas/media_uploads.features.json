{
	"type": "object",
	"title": "Media uploads",
	"additionalProperties": false,
	"properties": {
		"max_upload_bytes": {
			"type": "integer",
			"title": "Largest upload (bytes)",
			"default": 10485760,
			"minimum": 1024,
			"maximum": 524288000,
			"x-kind": "limit",
			"x-ui": {
				"group": "Limits",
				"order": 1,
				"widget": "number"
			}
		},
		"content_types": {
			"type": "array",
			"title": "Allowed content types",
			"default": ["image/jpeg", "image/png", "image/webp", "image/avif", "video/mp4"],
			"minItems": 1,
			"maxItems": 20,
			"uniqueItems": true,
			"items": {
				"type": "string",
				"title": "Type",
				"maxLength": 100,
				"minLength": 3,
				"pattern": "^(?:image|video)/[a-z0-9.+-]+$"
			},
			"x-kind": "config",
			"x-ui": {
				"group": "Rules",
				"order": 2
			}
		},
		"upload_ttl_seconds": {
			"type": "integer",
			"title": "Upload link lifetime (seconds)",
			"default": 300,
			"minimum": 60,
			"maximum": 3600,
			"x-kind": "config",
			"x-ui": {
				"group": "Links",
				"order": 3
			}
		},
		"view_ttl_seconds": {
			"type": "integer",
			"title": "Signed view link lifetime (seconds)",
			"default": 3600,
			"minimum": 60,
			"maximum": 86400,
			"x-kind": "config",
			"x-ui": {
				"group": "Links",
				"order": 4
			}
		}
	}
}
