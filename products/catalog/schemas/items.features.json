{
	"type": "object",
	"title": "Items",
	"additionalProperties": false,
	"properties": {
		"max_items": {
			"type": "integer",
			"title": "Maximum items",
			"default": 1000,
			"minimum": 1,
			"maximum": 1000000,
			"x-kind": "limit",
			"description": "Items that are not deleted count toward the limit.",
			"x-plan": {
				"starter": {
					"default": 1000,
					"max": 1000
				},
				"pro": {
					"default": 50000,
					"max": 200000
				}
			},
			"x-ui": {
				"group": "Limits",
				"order": 1,
				"widget": "number"
			}
		},
		"item_types": {
			"type": "array",
			"title": "Item types",
			"description": "What this website sells or shows: each type has a kind (physical, digital, service, rental, other) and the custom fields it uses (empty = all).",
			"default": [
				{
					"key": "item",
					"label": "Item",
					"kind": "physical",
					"requires_shipping": true,
					"custom_fields": []
				}
			],
			"minItems": 1,
			"maxItems": 50,
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": ["key", "label", "kind"],
				"properties": {
					"key": {
						"type": "string",
						"title": "Key",
						"maxLength": 40,
						"minLength": 1,
						"pattern": "^[a-z][a-z0-9_]{0,39}$"
					},
					"label": {
						"type": "string",
						"title": "Label",
						"maxLength": 80,
						"minLength": 1
					},
					"kind": {
						"type": "string",
						"title": "Kind",
						"maxLength": 20,
						"enum": ["physical", "digital", "service", "rental", "other"]
					},
					"requires_shipping": {
						"type": "boolean",
						"title": "Requires shipping"
					},
					"custom_fields": {
						"type": "array",
						"title": "Custom fields",
						"maxItems": 50,
						"uniqueItems": true,
						"items": {
							"type": "string",
							"title": "Field key",
							"maxLength": 40,
							"minLength": 1,
							"pattern": "^[a-z][a-z0-9_]{0,39}$"
						}
					}
				}
			},
			"x-kind": "config",
			"x-ui": {
				"group": "Model",
				"order": 2,
				"widget": "list"
			}
		},
		"default_type": {
			"type": "string",
			"title": "Default item type",
			"default": "item",
			"maxLength": 40,
			"pattern": "^[a-z][a-z0-9_]{0,39}$",
			"x-kind": "config",
			"x-ui": {
				"group": "Model",
				"order": 3
			}
		},
		"statuses": {
			"type": "array",
			"title": "Statuses",
			"description": "Publication statuses. `base` maps each to the standard draft, active or archived; `visible` statuses are public (pk_ keys, widgets, feeds).",
			"default": [
				{
					"key": "draft",
					"label": "Draft",
					"base": "draft",
					"visible": false
				},
				{
					"key": "active",
					"label": "Active",
					"base": "active",
					"visible": true
				},
				{
					"key": "archived",
					"label": "Archived",
					"base": "archived",
					"visible": false
				}
			],
			"minItems": 1,
			"maxItems": 20,
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": ["key", "label", "base", "visible"],
				"properties": {
					"key": {
						"type": "string",
						"title": "Key",
						"maxLength": 40,
						"minLength": 1,
						"pattern": "^[a-z][a-z0-9_]{0,39}$"
					},
					"label": {
						"type": "string",
						"title": "Label",
						"maxLength": 80,
						"minLength": 1
					},
					"base": {
						"type": "string",
						"title": "Standard status",
						"maxLength": 10,
						"enum": ["draft", "active", "archived"]
					},
					"visible": {
						"type": "boolean",
						"title": "Public"
					}
				}
			},
			"x-kind": "config",
			"x-ui": {
				"group": "Model",
				"order": 4,
				"widget": "list"
			}
		},
		"default_status": {
			"type": "string",
			"title": "Status of new items",
			"default": "draft",
			"maxLength": 40,
			"pattern": "^[a-z][a-z0-9_]{0,39}$",
			"x-kind": "config",
			"x-ui": {
				"group": "Model",
				"order": 5
			}
		},
		"custom_fields": {
			"type": "array",
			"title": "Custom fields",
			"description": "Merchant-defined fields stored in each item's `custom` object and validated on every write. Public fields are returned to pk_ keys.",
			"default": [],
			"maxItems": 50,
			"x-plan": {
				"starter": {
					"max": 10
				},
				"pro": {
					"max": 50
				}
			},
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": ["key", "label", "type"],
				"properties": {
					"key": {
						"type": "string",
						"title": "Key",
						"maxLength": 40,
						"minLength": 1,
						"pattern": "^[a-z][a-z0-9_]{0,39}$"
					},
					"label": {
						"type": "string",
						"title": "Label",
						"maxLength": 80,
						"minLength": 1
					},
					"type": {
						"type": "string",
						"title": "Type",
						"maxLength": 20,
						"enum": ["text", "long_text", "number", "integer", "boolean", "date", "url", "select", "multi_select"]
					},
					"options": {
						"type": "array",
						"title": "Options",
						"maxItems": 200,
						"uniqueItems": true,
						"items": {
							"type": "string",
							"title": "Option",
							"maxLength": 80,
							"minLength": 1
						}
					},
					"required": {
						"type": "boolean",
						"title": "Required"
					},
					"public": {
						"type": "boolean",
						"title": "Public"
					},
					"max_length": {
						"type": "integer",
						"title": "Maximum length",
						"minimum": 1,
						"maximum": 20000
					}
				}
			},
			"x-kind": "config",
			"x-ui": {
				"group": "Model",
				"order": 6,
				"widget": "list"
			}
		},
		"currency": {
			"type": "string",
			"title": "Catalog currency",
			"description": "ISO 4217 code of prices (minor units). Empty = the website currency from the Portal.",
			"default": "",
			"maxLength": 3,
			"pattern": "^(?:[A-Z]{3})?$",
			"x-kind": "config",
			"x-ui": {
				"group": "Money",
				"order": 7
			}
		},
		"item_currency": {
			"type": "boolean",
			"title": "Allow a currency per item",
			"default": false,
			"x-kind": "flag",
			"description": "Items may carry their own currency instead of the catalog currency.",
			"x-ui": {
				"group": "Money",
				"order": 8,
				"widget": "switch"
			}
		},
		"scheduled_publish": {
			"type": "boolean",
			"title": "Scheduled publishing",
			"default": true,
			"x-kind": "flag",
			"description": "Items may carry publishAt / unpublishAt; they are public only inside that window.",
			"x-ui": {
				"group": "Publishing",
				"order": 9,
				"widget": "switch"
			}
		},
		"languages": {
			"type": "array",
			"title": "Translation languages",
			"description": "BCP 47 languages items may carry translations for (title, summary, description, SEO). Readers pick one with ?lang=.",
			"default": [],
			"maxItems": 20,
			"uniqueItems": true,
			"items": {
				"type": "string",
				"title": "Language",
				"maxLength": 35,
				"minLength": 2,
				"pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
			},
			"x-kind": "config",
			"x-ui": {
				"group": "Content",
				"order": 10
			}
		},
		"max_description_length": {
			"type": "integer",
			"title": "Longest description (characters)",
			"default": 20000,
			"minimum": 100,
			"maximum": 100000,
			"x-kind": "limit",
			"x-ui": {
				"group": "Content",
				"order": 11,
				"widget": "number"
			}
		},
		"max_tags": {
			"type": "integer",
			"title": "Tags per item",
			"default": 20,
			"minimum": 0,
			"maximum": 100,
			"x-kind": "limit",
			"x-ui": {
				"group": "Content",
				"order": 12,
				"widget": "number"
			}
		},
		"page_size": {
			"type": "integer",
			"title": "Default page size",
			"default": 24,
			"minimum": 1,
			"maximum": 100,
			"x-kind": "config",
			"x-ui": {
				"group": "Listing",
				"order": 13
			}
		},
		"sorts": {
			"type": "array",
			"title": "Public sorts",
			"default": ["newest", "oldest", "title", "price_asc", "price_desc", "updated"],
			"minItems": 1,
			"maxItems": 6,
			"uniqueItems": true,
			"items": {
				"type": "string",
				"enum": ["newest", "oldest", "title", "price_asc", "price_desc", "updated"]
			},
			"x-kind": "config",
			"x-ui": {
				"group": "Listing",
				"order": 14
			}
		},
		"default_sort": {
			"type": "string",
			"title": "Default sort",
			"default": "newest",
			"enum": ["newest", "oldest", "title", "price_asc", "price_desc", "updated"],
			"x-kind": "config",
			"x-ui": {
				"group": "Listing",
				"order": 15
			}
		},
		"cache_seconds": {
			"type": "integer",
			"title": "Public cache lifetime (seconds)",
			"description": "Cache-Control max-age of public (pk_) reads.",
			"default": 60,
			"minimum": 0,
			"maximum": 3600,
			"x-kind": "config",
			"x-ui": {
				"group": "Listing",
				"order": 16
			}
		},
		"item_url_template": {
			"type": "string",
			"title": "Item page URL",
			"description": "Placeholders {domain}, {slug}, {id}, {type}. Used by widgets and feeds.",
			"default": "https://{domain}/items/{slug}",
			"maxLength": 500,
			"pattern": "^https://",
			"x-kind": "config",
			"x-ui": {
				"group": "Listing",
				"order": 17
			}
		}
	}
}
