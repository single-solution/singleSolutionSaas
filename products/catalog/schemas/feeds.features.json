{
	"type": "object",
	"title": "Feeds",
	"additionalProperties": false,
	"properties": {
		"feeds": {
			"type": "array",
			"title": "Feeds",
			"description": "Each feed is served at a tokened public URL (GET /v1/feeds lists them).",
			"default": [
				{
					"key": "shopping",
					"name": "Shopping feed",
					"format": "google_xml",
					"collection_ids": [],
					"brand_ids": [],
					"include_out_of_stock": true,
					"mapping": []
				}
			],
			"maxItems": 20,
			"x-plan": {
				"starter": {
					"max": 2
				},
				"pro": {
					"max": 20
				}
			},
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": ["key", "name", "format"],
				"properties": {
					"key": {
						"type": "string",
						"title": "Key",
						"maxLength": 40,
						"minLength": 1,
						"pattern": "^[a-z][a-z0-9_]{0,39}$"
					},
					"name": {
						"type": "string",
						"title": "Name",
						"maxLength": 120,
						"minLength": 1
					},
					"format": {
						"type": "string",
						"title": "Format",
						"maxLength": 20,
						"enum": ["google_xml", "csv", "tsv", "json"]
					},
					"collection_ids": {
						"type": "array",
						"title": "Only these collections",
						"maxItems": 50,
						"uniqueItems": true,
						"items": {
							"type": "string",
							"title": "Collection id",
							"maxLength": 128,
							"minLength": 1
						}
					},
					"brand_ids": {
						"type": "array",
						"title": "Only these brands",
						"maxItems": 50,
						"uniqueItems": true,
						"items": {
							"type": "string",
							"title": "Brand id",
							"maxLength": 128,
							"minLength": 1
						}
					},
					"include_out_of_stock": {
						"type": "boolean",
						"title": "Include sold-out variants"
					},
					"mapping": {
						"type": "array",
						"title": "Field mapping",
						"description": "Empty = the format's standard mapping.",
						"maxItems": 60,
						"items": {
							"type": "object",
							"additionalProperties": false,
							"required": ["target", "source"],
							"properties": {
								"target": {
									"type": "string",
									"title": "Feed field",
									"maxLength": 80,
									"minLength": 1,
									"pattern": "^[A-Za-z][A-Za-z0-9_:.-]*$"
								},
								"source": {
									"type": "string",
									"title": "Source",
									"maxLength": 300,
									"minLength": 1
								}
							}
						}
					}
				}
			},
			"x-kind": "config",
			"x-ui": {
				"group": "Feeds",
				"order": 1,
				"widget": "list",
				"help": "target: the feed field (e.g. g:id, title, price); source: an item field (id, item_id, sku, title, description, url, image, additional_images, price, sale_price, availability, brand, condition, gtin, mpn, item_group_id, product_type, currency, quantity), attr.<key>, custom.<key>, option.<key>, a template with {field} placeholders, or =<constant>."
			}
		},
		"condition_source": {
			"type": "string",
			"title": "Condition comes from",
			"description": "attr.<key>, custom.<key> or option.<key>; empty = every item uses the default condition.",
			"default": "",
			"maxLength": 80,
			"pattern": "^(?:(?:attr|custom|option)\\.[a-z][a-z0-9_]*)?$",
			"x-kind": "config",
			"x-ui": {
				"group": "Condition",
				"order": 2
			}
		},
		"condition_map": {
			"type": "array",
			"title": "Condition mapping",
			"description": "Your values (e.g. grades) → feed condition.",
			"default": [],
			"maxItems": 100,
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": ["from", "to"],
				"properties": {
					"from": {
						"type": "string",
						"title": "Your value",
						"maxLength": 80,
						"minLength": 1
					},
					"to": {
						"type": "string",
						"title": "Feed condition",
						"maxLength": 20,
						"enum": ["new", "refurbished", "used"]
					}
				}
			},
			"x-kind": "config",
			"x-ui": {
				"group": "Condition",
				"order": 3,
				"widget": "list"
			}
		},
		"default_condition": {
			"type": "string",
			"title": "Default condition",
			"default": "new",
			"enum": ["new", "refurbished", "used"],
			"x-kind": "config",
			"x-ui": {
				"group": "Condition",
				"order": 4
			}
		},
		"cache_seconds": {
			"type": "integer",
			"title": "Feed cache lifetime (seconds)",
			"default": 3600,
			"minimum": 60,
			"maximum": 86400,
			"x-kind": "config",
			"x-ui": {
				"group": "Delivery",
				"order": 5
			}
		},
		"token_version": {
			"type": "integer",
			"title": "Feed link version",
			"description": "Raise it to revoke every feed link and issue new ones.",
			"default": 1,
			"minimum": 1,
			"maximum": 1000000,
			"x-kind": "config",
			"x-ui": {
				"group": "Delivery",
				"order": 6
			}
		},
		"max_items_per_feed": {
			"type": "integer",
			"title": "Rows per feed",
			"default": 5000,
			"minimum": 1,
			"maximum": 200000,
			"x-kind": "limit",
			"x-plan": {
				"starter": {
					"default": 5000,
					"max": 5000
				},
				"pro": {
					"default": 50000,
					"max": 200000
				}
			},
			"x-ui": {
				"group": "Limits",
				"order": 7,
				"widget": "number"
			}
		}
	}
}
