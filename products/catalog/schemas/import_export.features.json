{
	"type": "object",
	"title": "Import & export",
	"additionalProperties": false,
	"properties": {
		"max_rows": {
			"type": "integer",
			"title": "Rows per import or export",
			"default": 2000,
			"minimum": 1,
			"maximum": 50000,
			"x-kind": "limit",
			"x-plan": {
				"starter": {
					"default": 2000,
					"max": 2000
				},
				"pro": {
					"default": 20000,
					"max": 50000
				}
			},
			"x-ui": {
				"group": "Limits",
				"order": 1,
				"widget": "number"
			}
		},
		"conflict_policy": {
			"type": "string",
			"title": "Conflict policy",
			"description": "When an item changed after the dry run (its version differs): skip the row, overwrite anyway, or fail the whole import.",
			"default": "skip",
			"enum": ["skip", "overwrite", "fail"],
			"x-kind": "config",
			"x-ui": {
				"group": "Import",
				"order": 2
			}
		},
		"allow_create": {
			"type": "boolean",
			"title": "Imports may create items",
			"default": true,
			"x-kind": "flag",
			"x-ui": {
				"group": "Import",
				"order": 3,
				"widget": "switch"
			}
		},
		"columns": {
			"type": "array",
			"title": "Export columns",
			"description": "Also accepted: attr.<key>, custom.<key>, option.<key>.",
			"default": [
				"item_id",
				"item_slug",
				"title",
				"type",
				"status",
				"brand",
				"collections",
				"tags",
				"variant_id",
				"sku",
				"barcode",
				"options",
				"price",
				"compare_at_price",
				"cost",
				"quantity",
				"currency",
				"image_urls"
			],
			"minItems": 1,
			"maxItems": 100,
			"uniqueItems": true,
			"items": {
				"type": "string",
				"title": "Column",
				"maxLength": 80,
				"minLength": 1,
				"pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)?$"
			},
			"x-kind": "config",
			"x-ui": {
				"group": "Export",
				"order": 4
			}
		},
		"list_separator": {
			"type": "string",
			"title": "List separator",
			"default": "|",
			"minLength": 1,
			"maxLength": 1,
			"pattern": "^[|;/]$",
			"x-kind": "config",
			"x-ui": {
				"group": "Format",
				"order": 5
			}
		},
		"include_cost": {
			"type": "boolean",
			"title": "Include private cost",
			"default": true,
			"x-kind": "flag",
			"description": "Cost columns are only ever served to sk_ keys and the dashboard.",
			"x-ui": {
				"group": "Export",
				"order": 6,
				"widget": "switch"
			}
		}
	}
}
