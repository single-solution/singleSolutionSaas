{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "deals.exhausted@1",
	"description": "A deal reached its total uses or its stock of units; it no longer applies.",
	"type": "object",
	"required": ["dealId", "kind", "reason", "uses", "units"],
	"additionalProperties": false,
	"properties": {
		"dealId": { "type": "string", "minLength": 1, "maxLength": 64 },
		"kind": { "type": "string", "enum": ["item", "cart", "flash", "bundle"] },
		"name": { "type": "string", "maxLength": 120 },
		"reason": { "type": "string", "enum": ["total_uses", "stock_units"] },
		"uses": { "type": "integer", "minimum": 0 },
		"units": { "type": "integer", "minimum": 0 },
		"orderId": { "type": "string", "minLength": 1, "maxLength": 128 }
	},
	"examples": [
		{ "dealId": "dl_0abc", "kind": "flash", "name": "Friday flash sale", "reason": "stock_units", "uses": 41, "units": 50 }
	]
}
