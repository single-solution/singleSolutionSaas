{
	"type": "object",
	"title": "Deals page",
	"additionalProperties": false,
	"properties": {
		"sort": {
			"type": "string",
			"title": "Sort",
			"default": "priority",
			"enum": ["priority", "ending_soon", "newest"],
			"x-kind": "config",
			"x-ui": {
				"widget": "select",
				"group": "Listing",
				"order": 1
			}
		},
		"show_upcoming": {
			"type": "boolean",
			"title": "Show upcoming deals",
			"description": "Deals that start later (\"starts Friday 18:00\").",
			"default": true,
			"x-kind": "flag",
			"x-ui": {
				"widget": "switch",
				"group": "Listing",
				"order": 2
			}
		},
		"page_size": {
			"type": "integer",
			"title": "Deals per page",
			"default": 12,
			"minimum": 1,
			"maximum": 48,
			"x-kind": "limit",
			"x-ui": {
				"widget": "number",
				"group": "Listing",
				"order": 3
			}
		},
		"items_per_deal": {
			"type": "integer",
			"title": "Items shown per deal",
			"default": 8,
			"minimum": 0,
			"maximum": 48,
			"x-kind": "limit",
			"x-ui": {
				"widget": "number",
				"group": "Listing",
				"order": 4
			}
		},
		"hide_out_of_stock": {
			"type": "boolean",
			"title": "Hide out-of-stock items",
			"default": true,
			"x-kind": "flag",
			"x-ui": {
				"widget": "switch",
				"group": "Listing",
				"order": 5
			}
		},
		"include_kinds": {
			"type": "array",
			"title": "Deal kinds listed",
			"default": ["item", "flash", "bundle", "cart"],
			"minItems": 1,
			"maxItems": 4,
			"uniqueItems": true,
			"x-kind": "config",
			"x-ui": {
				"widget": "multiselect",
				"group": "Listing",
				"order": 6
			},
			"items": {
				"type": "string",
				"enum": ["item", "flash", "bundle", "cart"]
			}
		}
	}
}
