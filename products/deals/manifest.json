{
	"ssps": "1",
	"product": {
		"slug": "deals",
		"name": "Deals & Promotions",
		"kind": "service",
		"version": "1.0.0",
		"category": "commerce",
		"description": "Automatic offers without codes for any catalog: item and collection deals with weekday/overnight schedules in the website's time zone, cart thresholds and payment conditions, flash sales, bundles, a stacking policy, price locks, drop-in or headless badges and a deals page, and a rate-limited quote API — all data in the merchant's own database."
	},
	"endpoints": {
		"base": "https://deals.example.com",
		"dashboard": "/dashboard",
		"demo": "/dashboard",
		"events": "/.well-known/ss-events"
	},
	"capabilities": {
		"adminLaunch": true,
		"sandbox": true,
		"localEnforcement": [
			"rate:quote_api.rate_per_minute",
			"limit:quote_api.max_lines",
			"limit:item_deals.max_active",
			"limit:item_deals.max_percent",
			"limit:cart_deals.max_active",
			"limit:flash_sales.max_active",
			"limit:bundles.max_active",
			"limit:price_locks.ttl_minutes"
		],
		"offlineGrace": "PT24H"
	},
	"scopes": [
		"events.subscribe:price.changed",
		"events.subscribe:inventory.changed",
		"events.subscribe:item.*",
		"events.subscribe:order.cancelled"
	],
	"requires": {
		"resources": ["database"]
	},
	"events": {
		"consumes": ["order.cancelled@1", "price.changed@1", "inventory.changed@1", "item.*"],
		"publishes": ["deals.applied@1", "deals.exhausted@1"]
	},
	"budget": {
		"shared": 2
	},
	"elements": [
		{
			"key": "quote_api",
			"name": "Deal engine & quote API",
			"description": "The deal store and the engine: create and schedule deals (time zone, weekday and overnight windows), sync items, quote carts and items, commit quotes to orders (usage, per-customer and stock limits) — rate limited per website.",
			"modes": ["C"],
			"stateful": true,
			"price": {
				"hourly": 200,
				"metered": [
					{
						"unit": "quote",
						"perUnit": 1,
						"per": 20,
						"included": {
							"starter": 20000,
							"pro": 200000
						}
					}
				]
			},
			"budget": {
				"js": 0
			},
			"dependsOn": [],
			"requires": {
				"resources": ["database"]
			},
			"features": {
				"$ref": "schemas/quote_api.features.json"
			},
			"strings": "strings/en.json",
			"placement": false,
			"rules": ["when"],
			"customFields": ["deal"],
			"api": {
				"resources": ["deals", "quotes", "items"]
			},
			"headless": null,
			"renderer": null
		},
		{
			"key": "item_deals",
			"name": "Item deals",
			"description": "Automatic discounts on items, variants, collections, brands or attributes (percent, amount off, fixed price, buy X get Y), with schedules, priority, per-customer, total-use and stock limits.",
			"modes": ["C"],
			"stateful": true,
			"price": {
				"hourly": 300
			},
			"budget": {
				"js": 0
			},
			"dependsOn": ["quote_api"],
			"requires": {
				"resources": ["database"]
			},
			"features": {
				"$ref": "schemas/item_deals.features.json"
			},
			"strings": "strings/en.json",
			"rules": ["when"],
			"headless": null,
			"renderer": null
		},
		{
			"key": "cart_deals",
			"name": "Cart deals",
			"description": "Checkout-wide deals: spend or quantity thresholds, payment and delivery method conditions, free shipping, tiered rewards, upsell hints.",
			"modes": ["C"],
			"stateful": true,
			"price": {
				"hourly": 200
			},
			"budget": {
				"js": 0
			},
			"dependsOn": ["quote_api"],
			"requires": {
				"resources": ["database"]
			},
			"features": {
				"$ref": "schemas/cart_deals.features.json"
			},
			"strings": "strings/en.json",
			"rules": ["when"],
			"headless": null,
			"renderer": null
		},
		{
			"key": "flash_sales",
			"name": "Flash sales",
			"description": "Time-boxed item deals with a countdown and an optional stock of discounted units (sold out = off).",
			"modes": ["C"],
			"stateful": true,
			"price": {
				"hourly": 200
			},
			"budget": {
				"js": 0
			},
			"dependsOn": ["quote_api"],
			"requires": {
				"resources": ["database"]
			},
			"features": {
				"$ref": "schemas/flash_sales.features.json"
			},
			"strings": "strings/en.json",
			"headless": null,
			"renderer": null
		},
		{
			"key": "bundles",
			"name": "Bundles",
			"description": "Buy-together pricing across components and mix-and-match \"any N for …\" rules.",
			"modes": ["C"],
			"stateful": true,
			"price": {
				"hourly": 200
			},
			"budget": {
				"js": 0
			},
			"dependsOn": ["quote_api"],
			"requires": {
				"resources": ["database"]
			},
			"features": {
				"$ref": "schemas/bundles.features.json"
			},
			"strings": "strings/en.json",
			"headless": null,
			"renderer": null
		},
		{
			"key": "stacking",
			"name": "Stacking policy",
			"description": "Stacking classes (which deals combine on a line), best-offer or priority selection, deals per line, and how deals combine with coupons and loyalty points. Off: one offer per line.",
			"modes": ["C"],
			"stateful": false,
			"price": {
				"hourly": 100
			},
			"budget": {
				"js": 0
			},
			"dependsOn": ["quote_api"],
			"features": {
				"$ref": "schemas/stacking.features.json"
			},
			"strings": "strings/en.json",
			"experiments": true,
			"headless": null,
			"renderer": null
		},
		{
			"key": "price_locks",
			"name": "Price locks",
			"description": "Honour the price a shopper was shown for N minutes with signed lock tokens; stale behaviour (expired, base price changed, better live price) is configurable.",
			"modes": ["C"],
			"stateful": false,
			"price": {
				"hourly": 100
			},
			"budget": {
				"js": 0
			},
			"dependsOn": ["quote_api"],
			"features": {
				"$ref": "schemas/price_locks.features.json"
			},
			"strings": "strings/en.json",
			"api": {
				"resources": ["price-locks"]
			},
			"headless": null,
			"renderer": null
		},
		{
			"key": "badges",
			"name": "Badges & pills",
			"description": "Deal badges for product cards, deal pills and strike-through prices for product pages, countdowns and low-stock notes — drop-in, headless or API.",
			"modes": ["A", "B", "C"],
			"stateful": false,
			"price": {
				"hourly": 100
			},
			"budget": {
				"js": 3
			},
			"dependsOn": ["quote_api"],
			"features": {
				"$ref": "schemas/badges.features.json"
			},
			"strings": "strings/en.json",
			"placement": true,
			"experiments": true,
			"api": {
				"resources": ["offers"]
			},
			"headless": "headless/badges.js#createBadges",
			"renderer": "ui/badges.js#render",
			"variants": ["card", "detail"],
			"slots": ["before", "after"],
			"a11y": {
				"role": "group",
				"labels": true,
				"keyboard": true,
				"reducedMotion": true
			}
		},
		{
			"key": "deals_page",
			"name": "Deals page",
			"description": "A drop-in deals listing: live and upcoming deals with their badges, countdowns and items, sorted and filtered by configuration.",
			"modes": ["A", "B", "C"],
			"stateful": false,
			"price": {
				"hourly": 100
			},
			"budget": {
				"js": 4
			},
			"dependsOn": ["quote_api"],
			"features": {
				"$ref": "schemas/deals_page.features.json"
			},
			"strings": "strings/en.json",
			"placement": true,
			"experiments": true,
			"api": {
				"resources": ["deals-page"]
			},
			"headless": "headless/dealsPage.js#createDealsPage",
			"renderer": "ui/dealsPage.js#render",
			"variants": ["grid", "list"],
			"slots": ["before", "after", "empty"],
			"a11y": {
				"role": "region",
				"labels": true,
				"keyboard": true,
				"reducedMotion": true
			}
		},
		{
			"key": "reporting",
			"name": "Reporting",
			"description": "Uses, units, discount given, revenue, average order with and without deals (uplift) and margin impact when items carry a cost.",
			"modes": ["C"],
			"stateful": true,
			"price": {
				"hourly": 100
			},
			"budget": {
				"js": 0
			},
			"dependsOn": ["quote_api"],
			"requires": {
				"resources": ["database"]
			},
			"features": {
				"$ref": "schemas/reporting.features.json"
			},
			"strings": "strings/en.json",
			"api": {
				"resources": ["reports"]
			},
			"headless": null,
			"renderer": null
		}
	],
	"plans": [
		{
			"code": "starter",
			"name": "Starter",
			"description": "Item and cart deals, price locks, badges and the deals page.",
			"elements": ["quote_api", "item_deals", "cart_deals", "price_locks", "badges", "deals_page"],
			"addons": ["flash_sales", "stacking", "reporting"]
		},
		{
			"code": "pro",
			"name": "Pro",
			"description": "Everything: flash sales, bundles, the stacking policy and reporting, with higher bounds.",
			"elements": [
				"quote_api",
				"item_deals",
				"cart_deals",
				"flash_sales",
				"bundles",
				"stacking",
				"price_locks",
				"badges",
				"deals_page",
				"reporting"
			]
		}
	],
	"priceBook": {
		"version": "2026-10-01",
		"effectiveFrom": "2026-10-01T00:00:00Z"
	},
	"trialHours": 48,
	"retention": {
		"quotes": "P2D",
		"applications": "P730D"
	}
}
