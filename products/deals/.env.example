# SSPS product environment (names from @ss/app-kit API.md). `ss dev env` prints development values.

# Pinned Portal URL — the only Portal this product trusts. `ss dev` runs the local Portal emulator here.
SS_PORTAL_URL=http://localhost:4400
# App id assigned by the Portal at registration (empty before the handshake).
SS_APP_ID=
# Product private signing key: Ed25519 private JWK as one-line JSON. Never commit a real one.
SS_APP_SIGNING_KEY=
# SHA-256 (hex) of the one-time registration token. The token itself is never stored.
SS_REGISTRATION_TOKEN_HASH=
# The product's own small control DB (replay/nonce/entitlement caches, usage queue). Empty = in-memory, dev only.
SS_PRODUCT_DB_URI=
# Connection pool of that client (default 5).
SS_PRODUCT_DB_MAX_POOL_SIZE=
SS_LOG_LEVEL=info
# Development-only outbound allowlist (comma-separated hosts/IPs; default loopback). Ignored when NODE_ENV=production.
SS_OUTBOUND_ALLOW_HOSTS=
# HMAC secret of price-lock tokens (≥ 32 chars). Empty = derived from SS_APP_SIGNING_KEY (rotating the key then
# invalidates outstanding locks, which live ≤ price_locks.ttl_minutes).
DEALS_LOCK_SECRET=
