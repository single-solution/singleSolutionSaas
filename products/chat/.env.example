# The product's own database (switches, settings, connections, sessions). Never a merchant database.
MONGODB_URI=
# Random, at least 32 characters. Typed once into Portal → Products → Add; the Portal never stores it.
CONNECT_SECRET=
# Random, at least 32 characters, different for each deployable. Encrypts the stored connections.
ENCRYPTION_KEY=
# Optional: set only while ENCRYPTION_KEY is changed (the old key, so stored values keep opening); remove it after the
# Owner's Re-seal on the product dashboard.
ENCRYPTION_KEY_PREVIOUS=
