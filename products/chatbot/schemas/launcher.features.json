{
	"type": "object",
	"title": "Launcher",
	"additionalProperties": false,
	"properties": {
		"position": {
			"type": "string",
			"title": "Position",
			"default": "bottom_end",
			"description": "bottom_end follows the reading direction (right in LTR, left in RTL).",
			"enum": ["bottom_end", "bottom_start"],
			"x-kind": "config",
			"x-experiment": true,
			"x-ui": { "widget": "select", "group": "Appearance", "order": 1 }
		},
		"offset_x": {
			"type": "integer",
			"title": "Horizontal offset (px)",
			"default": 20,
			"minimum": 0,
			"maximum": 200,
			"x-kind": "config",
			"x-ui": { "widget": "number", "group": "Appearance", "order": 2 }
		},
		"offset_y": {
			"type": "integer",
			"title": "Vertical offset (px)",
			"default": 20,
			"minimum": 0,
			"maximum": 200,
			"x-kind": "config",
			"x-ui": { "widget": "number", "group": "Appearance", "order": 3 }
		},
		"size": {
			"type": "string",
			"title": "Size",
			"default": "medium",
			"enum": ["small", "medium", "large"],
			"x-kind": "config",
			"x-ui": { "widget": "select", "group": "Appearance", "order": 4 }
		},
		"icon": {
			"type": "string",
			"title": "Icon",
			"default": "chat",
			"enum": ["chat", "help", "message", "avatar"],
			"x-kind": "config",
			"x-ui": { "widget": "select", "group": "Appearance", "order": 5 }
		},
		"avatar_url": {
			"type": "string",
			"title": "Avatar image URL (icon = avatar)",
			"default": "",
			"maxLength": 2048,
			"x-kind": "config",
			"x-ui": { "widget": "url", "group": "Appearance", "order": 6 }
		},
		"show_label": {
			"type": "boolean",
			"title": "Show the text label next to the icon",
			"default": false,
			"x-kind": "flag",
			"x-experiment": true,
			"x-ui": { "widget": "switch", "group": "Appearance", "order": 7 }
		},
		"pulse": {
			"type": "boolean",
			"title": "Pulse to draw attention (respects reduced motion)",
			"default": true,
			"x-kind": "flag",
			"x-ui": { "widget": "switch", "group": "Appearance", "order": 8 }
		},
		"unread_badge": {
			"type": "boolean",
			"title": "Show the unread badge",
			"default": true,
			"x-kind": "flag",
			"x-ui": { "widget": "switch", "group": "Appearance", "order": 9 }
		},
		"mobile_tab": {
			"type": "boolean",
			"title": "Render inside the site's mobile tab bar slot instead of floating",
			"default": false,
			"x-kind": "flag",
			"x-ui": { "widget": "switch", "group": "Appearance", "order": 10 }
		},
		"hide_on_paths": {
			"type": "array",
			"title": "Hide on paths (globs: * one segment, ** any)",
			"default": [],
			"maxItems": 50,
			"items": { "type": "string", "minLength": 1, "maxLength": 300, "pattern": "^/" },
			"x-kind": "config",
			"x-ui": { "widget": "list", "group": "Visibility", "order": 11 }
		},
		"hide_on_devices": {
			"type": "array",
			"title": "Hide on devices",
			"default": [],
			"maxItems": 3,
			"uniqueItems": true,
			"items": { "type": "string", "enum": ["mobile", "tablet", "desktop"] },
			"x-kind": "config",
			"x-ui": { "widget": "checkboxes", "group": "Visibility", "order": 12 }
		},
		"auto_open": {
			"type": "string",
			"title": "Open the window automatically",
			"default": "none",
			"enum": ["none", "delay", "scroll", "exit_intent", "idle"],
			"x-kind": "config",
			"x-experiment": true,
			"x-ui": { "widget": "select", "group": "Triggers", "order": 13 }
		},
		"auto_open_delay_seconds": {
			"type": "integer",
			"title": "Delay before opening (seconds)",
			"default": 15,
			"minimum": 0,
			"maximum": 600,
			"x-kind": "config",
			"x-ui": { "widget": "number", "group": "Triggers", "order": 14 }
		},
		"auto_open_scroll_percent": {
			"type": "integer",
			"title": "Open after scrolling (% of the page)",
			"default": 50,
			"minimum": 1,
			"maximum": 100,
			"x-kind": "config",
			"x-ui": { "widget": "number", "group": "Triggers", "order": 15 }
		},
		"auto_open_idle_seconds": {
			"type": "integer",
			"title": "Open after idle (seconds)",
			"default": 30,
			"minimum": 5,
			"maximum": 3600,
			"x-kind": "config",
			"x-ui": { "widget": "number", "group": "Triggers", "order": 16 }
		},
		"auto_open_once_per_session": {
			"type": "boolean",
			"title": "Open automatically at most once per session",
			"default": true,
			"x-kind": "flag",
			"x-ui": { "widget": "switch", "group": "Triggers", "order": 17 }
		},
		"open_selector": {
			"type": "string",
			"title": "Open when an element matching this CSS selector is clicked",
			"default": "",
			"maxLength": 200,
			"x-kind": "config",
			"x-ui": { "widget": "text", "group": "Triggers", "order": 18 }
		}
	}
}
