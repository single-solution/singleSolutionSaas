{
	"type": "object",
	"title": "Tools",
	"additionalProperties": false,
	"properties": {
		"order_lookup": {
			"type": "boolean",
			"title": "Order status for signed-in customers (from your order events)",
			"default": true,
			"x-kind": "flag",
			"x-ui": { "widget": "switch", "group": "Built-in", "order": 1 }
		},
		"guest_order_lookup": {
			"type": "boolean",
			"title": "Order status for guests who give the order number and the order e-mail",
			"default": false,
			"x-kind": "flag",
			"x-ui": { "widget": "switch", "group": "Built-in", "order": 2 }
		},
		"order_fields": {
			"type": "array",
			"title": "Order fields shared with the AI",
			"default": ["number", "status", "placedAt", "updatedAt", "total", "currency", "items"],
			"maxItems": 10,
			"uniqueItems": true,
			"items": {
				"type": "string",
				"enum": ["number", "status", "placedAt", "updatedAt", "total", "currency", "items", "refunded"]
			},
			"x-kind": "config",
			"x-ui": { "widget": "checkboxes", "group": "Built-in", "order": 3 }
		},
		"max_orders": {
			"type": "integer",
			"title": "Orders returned per lookup",
			"default": 5,
			"minimum": 1,
			"maximum": 20,
			"x-kind": "limit",
			"x-ui": { "widget": "number", "group": "Built-in", "order": 4 }
		},
		"knowledge_search": {
			"type": "boolean",
			"title": "Let the AI search the knowledge base",
			"default": true,
			"x-kind": "flag",
			"x-ui": { "widget": "switch", "group": "Built-in", "order": 5 }
		},
		"escalate": {
			"type": "boolean",
			"title": "Let the AI hand the conversation to a person",
			"default": true,
			"x-kind": "flag",
			"x-ui": { "widget": "switch", "group": "Built-in", "order": 6 }
		},
		"custom": {
			"type": "array",
			"title": "Webhook tools",
			"description": "Your endpoints the AI or flows may call. Requests are POSTed as JSON and signed (ss-chatbot-signature, HMAC-SHA256); get the secret with POST /v1/tools:signing-secret.",
			"default": [],
			"maxItems": 30,
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": ["name", "description", "url"],
				"properties": {
					"name": { "type": "string", "title": "Name", "minLength": 2, "maxLength": 48, "pattern": "^[a-z][a-z0-9_]*$" },
					"description": {
						"type": "string",
						"title": "What it does (the AI reads this)",
						"minLength": 1,
						"maxLength": 1000
					},
					"url": {
						"type": "string",
						"title": "Webhook URL (https)",
						"minLength": 9,
						"maxLength": 2048,
						"pattern": "^https://"
					},
					"parameters": {
						"type": "array",
						"title": "Input parameters",
						"maxItems": 20,
						"items": {
							"type": "object",
							"additionalProperties": false,
							"required": ["name", "type"],
							"properties": {
								"name": {
									"type": "string",
									"title": "Name",
									"minLength": 1,
									"maxLength": 40,
									"pattern": "^[a-z][a-z0-9_]*$"
								},
								"type": { "type": "string", "title": "Type", "enum": ["string", "number", "integer", "boolean"] },
								"description": { "type": "string", "title": "Description", "maxLength": 300 },
								"required": { "type": "boolean", "title": "Required" },
								"enum": {
									"type": "array",
									"title": "Allowed values",
									"maxItems": 50,
									"items": { "type": "string", "maxLength": 120 }
								}
							}
						}
					},
					"timeout_ms": { "type": "integer", "title": "Timeout (ms)", "minimum": 500, "maximum": 20000 },
					"allow_ai": { "type": "boolean", "title": "The AI may call it" },
					"allow_flows": { "type": "boolean", "title": "Flows may call it" },
					"include_customer": { "type": "boolean", "title": "Send the verified customer (subject, e-mail)" },
					"max_response_chars": {
						"type": "integer",
						"title": "Response kept (characters)",
						"minimum": 100,
						"maximum": 20000
					}
				}
			},
			"x-kind": "config",
			"x-plan": { "starter": { "max": 3 }, "pro": { "max": 30 } },
			"x-ui": { "widget": "list", "group": "Webhook tools", "order": 7 }
		},
		"signing_key_version": {
			"type": "integer",
			"title": "Signing secret version (increase to rotate)",
			"default": 1,
			"minimum": 1,
			"maximum": 1000000,
			"x-kind": "config",
			"x-ui": { "widget": "number", "group": "Webhook tools", "order": 8, "advanced": true }
		},
		"calls_per_conversation": {
			"type": "integer",
			"title": "Tool calls per conversation",
			"default": 30,
			"minimum": 1,
			"maximum": 1000,
			"x-kind": "limit",
			"x-ui": { "widget": "number", "group": "Limits", "order": 9 }
		}
	}
}
