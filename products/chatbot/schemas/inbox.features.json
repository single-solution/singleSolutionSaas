{
	"type": "object",
	"title": "Inbox",
	"additionalProperties": false,
	"properties": {
		"assignment": {
			"type": "string",
			"title": "Assignment",
			"default": "round_robin",
			"enum": ["manual", "round_robin", "least_loaded", "rules"],
			"x-kind": "config",
			"x-ui": { "widget": "select", "group": "Assignment", "order": 1 }
		},
		"assignment_rules": {
			"type": "array",
			"title": "Assignment rules (first match wins)",
			"default": [],
			"maxItems": 50,
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": ["when"],
				"properties": {
					"when": { "type": "string", "title": "Condition (rules@1)", "maxLength": 2000 },
					"team": { "type": "string", "title": "Team", "maxLength": 40 },
					"agent_id": { "type": "string", "title": "Agent", "maxLength": 64 },
					"priority": { "type": "string", "title": "Priority", "enum": ["low", "normal", "high", "urgent"] }
				}
			},
			"x-kind": "config",
			"x-ui": { "widget": "list", "group": "Assignment", "order": 2 }
		},
		"teams": {
			"type": "array",
			"title": "Teams",
			"default": [
				{
					"key": "support",
					"name": "Support",
					"time_zone": "",
					"hours": [],
					"first_response_minutes": 0,
					"resolution_minutes": 0
				}
			],
			"minItems": 1,
			"maxItems": 30,
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": ["key"],
				"properties": {
					"key": { "type": "string", "title": "Key", "minLength": 1, "maxLength": 40, "pattern": "^[a-z][a-z0-9_]*$" },
					"name": { "type": "string", "title": "Name", "maxLength": 80 },
					"time_zone": { "type": "string", "title": "Time zone (empty = the website's)", "maxLength": 64 },
					"hours": {
						"type": "array",
						"title": "Working hours (empty = always open)",
						"maxItems": 21,
						"items": {
							"type": "object",
							"additionalProperties": false,
							"required": ["days", "start", "end"],
							"properties": {
								"days": {
									"type": "array",
									"title": "Days",
									"minItems": 1,
									"maxItems": 7,
									"uniqueItems": true,
									"items": { "type": "string", "enum": ["mon", "tue", "wed", "thu", "fri", "sat", "sun"] }
								},
								"start": { "type": "string", "title": "From (HH:MM)", "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$" },
								"end": {
									"type": "string",
									"title": "Until (HH:MM, may pass midnight)",
									"pattern": "^(?:[01][0-9]|2[0-4]):[0-5][0-9]$"
								}
							}
						}
					},
					"first_response_minutes": {
						"type": "integer",
						"title": "SLA first response (minutes, 0 = default)",
						"minimum": 0,
						"maximum": 10080
					},
					"resolution_minutes": {
						"type": "integer",
						"title": "SLA resolution (minutes, 0 = default)",
						"minimum": 0,
						"maximum": 43200
					}
				}
			},
			"x-kind": "config",
			"x-ui": { "widget": "list", "group": "Teams", "order": 3 }
		},
		"default_team": {
			"type": "string",
			"title": "Default team",
			"default": "support",
			"maxLength": 40,
			"x-kind": "config",
			"x-ui": { "widget": "text", "group": "Teams", "order": 4 }
		},
		"max_agents": {
			"type": "integer",
			"title": "Agents",
			"default": 5,
			"minimum": 1,
			"maximum": 1000,
			"x-kind": "limit",
			"x-plan": { "pro": { "default": 10, "max": 1000 } },
			"x-ui": { "widget": "number", "group": "Teams", "order": 5 }
		},
		"max_concurrent_per_agent": {
			"type": "integer",
			"title": "Open conversations per agent (default)",
			"default": 8,
			"minimum": 1,
			"maximum": 200,
			"x-kind": "limit",
			"x-ui": { "widget": "number", "group": "Assignment", "order": 6 }
		},
		"sla_first_response_minutes": {
			"type": "integer",
			"title": "SLA: first human response (minutes)",
			"default": 60,
			"minimum": 1,
			"maximum": 10080,
			"x-kind": "config",
			"x-ui": { "widget": "number", "group": "SLA", "order": 7 }
		},
		"sla_resolution_minutes": {
			"type": "integer",
			"title": "SLA: resolution (minutes)",
			"default": 1440,
			"minimum": 1,
			"maximum": 43200,
			"x-kind": "config",
			"x-ui": { "widget": "number", "group": "SLA", "order": 8 }
		},
		"sla_count_business_hours_only": {
			"type": "boolean",
			"title": "Count SLA time during working hours only",
			"default": false,
			"x-kind": "flag",
			"x-ui": { "widget": "switch", "group": "SLA", "order": 9 }
		},
		"default_priority": {
			"type": "string",
			"title": "Default priority",
			"default": "normal",
			"enum": ["low", "normal", "high", "urgent"],
			"x-kind": "config",
			"x-ui": { "widget": "select", "group": "Conversations", "order": 10 }
		},
		"tags": {
			"type": "array",
			"title": "Allowed tags (empty = any)",
			"default": [],
			"maxItems": 200,
			"uniqueItems": true,
			"items": { "type": "string", "minLength": 1, "maxLength": 40, "pattern": "^[\\p{L}\\p{N}_-]+$" },
			"x-kind": "config",
			"x-ui": { "widget": "list", "group": "Conversations", "order": 11 }
		},
		"canned_replies": {
			"type": "array",
			"title": "Canned replies ({customer_name}, {agent_name}, {conversation_id} placeholders)",
			"default": [],
			"maxItems": 500,
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": ["key", "body"],
				"properties": {
					"key": { "type": "string", "title": "Shortcut", "minLength": 1, "maxLength": 40, "pattern": "^[a-z0-9_-]+$" },
					"title": { "type": "string", "title": "Title", "maxLength": 120 },
					"body": { "type": "string", "title": "Text", "minLength": 1, "maxLength": 4000 },
					"language": { "type": "string", "title": "Language", "maxLength": 35 }
				}
			},
			"x-kind": "config",
			"x-ui": { "widget": "list", "group": "Canned replies", "order": 12 }
		},
		"auto_close_after_hours": {
			"type": "integer",
			"title": "Close resolved or waiting conversations after (hours, 0 = never)",
			"default": 72,
			"minimum": 0,
			"maximum": 8760,
			"x-kind": "config",
			"x-ui": { "widget": "number", "group": "Conversations", "order": 13 }
		},
		"snooze_max_hours": {
			"type": "integer",
			"title": "Longest snooze (hours)",
			"default": 168,
			"minimum": 1,
			"maximum": 8760,
			"x-kind": "limit",
			"x-ui": { "widget": "number", "group": "Conversations", "order": 14 }
		}
	}
}
