{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "chatbot.closed@1",
	"description": "A conversation was closed (by the customer, an agent, the API, a flow or the inactivity rule).",
	"type": "object",
	"required": ["conversationId", "reason", "by", "messages", "durationSeconds", "handedOff"],
	"additionalProperties": false,
	"properties": {
		"conversationId": { "type": "string", "minLength": 1, "maxLength": 64 },
		"reason": { "type": "string", "minLength": 1, "maxLength": 40 },
		"by": { "type": "string", "enum": ["customer", "agent", "api", "staff", "merchant", "system"] },
		"messages": { "type": "integer", "minimum": 0 },
		"durationSeconds": { "type": "integer", "minimum": 0 },
		"handedOff": { "type": "boolean" },
		"customerId": { "type": "string", "minLength": 1, "maxLength": 255 }
	},
	"examples": [
		{
			"conversationId": "cnv_0abc",
			"reason": "customer",
			"by": "customer",
			"messages": 6,
			"durationSeconds": 420,
			"handedOff": false
		}
	]
}
