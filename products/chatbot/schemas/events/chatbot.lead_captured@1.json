{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "chatbot.lead_captured@1",
	"description": "A visitor left contact details (with consent) in the chat or through the API.",
	"type": "object",
	"required": ["leadId", "contact", "fields", "source"],
	"additionalProperties": false,
	"properties": {
		"leadId": { "type": "string", "minLength": 1, "maxLength": 64 },
		"conversationId": { "type": "string", "minLength": 1, "maxLength": 64 },
		"customerId": { "type": "string", "minLength": 1, "maxLength": 255 },
		"contact": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"name": { "type": "string", "maxLength": 300 },
				"email": { "type": "string", "maxLength": 320 },
				"phone": { "type": "string", "maxLength": 32 }
			}
		},
		"fields": { "type": "array", "maxItems": 20, "items": { "type": "string", "maxLength": 40 } },
		"source": { "type": "string", "enum": ["form", "flow", "api"] }
	},
	"examples": [
		{
			"leadId": "lead_0abc",
			"conversationId": "cnv_0abc",
			"contact": { "name": "Ana", "email": "ana@example.org" },
			"fields": ["name", "email", "message"],
			"source": "form"
		}
	]
}
