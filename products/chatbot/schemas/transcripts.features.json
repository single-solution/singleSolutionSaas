{
	"type": "object",
	"title": "Transcripts",
	"additionalProperties": false,
	"properties": {
		"retention_days": {
			"type": "integer",
			"title": "Keep conversations and messages for (days)",
			"description": "Enforced by a TTL index in your database; changes apply to conversations updated afterwards.",
			"default": 365,
			"minimum": 1,
			"maximum": 3650,
			"x-kind": "limit",
			"x-plan": { "starter": { "default": 180, "max": 730 }, "pro": { "default": 365, "max": 3650 } },
			"x-ui": { "widget": "number", "group": "Retention", "order": 1 }
		},
		"deleted_retention_days": {
			"type": "integer",
			"title": "Keep deleted FAQ entries and agents for (days) before purging them",
			"default": 30,
			"minimum": 1,
			"maximum": 3650,
			"x-kind": "config",
			"x-ui": { "widget": "number", "group": "Retention", "order": 2 }
		},
		"customer_download": {
			"type": "boolean",
			"title": "Customers can download their transcript",
			"default": true,
			"x-kind": "flag",
			"x-ui": { "widget": "switch", "group": "Export", "order": 2 }
		},
		"include_internal_notes": {
			"type": "boolean",
			"title": "Include internal notes in merchant exports",
			"default": false,
			"x-kind": "flag",
			"x-ui": { "widget": "switch", "group": "Export", "order": 3 }
		},
		"max_messages": {
			"type": "integer",
			"title": "Messages per export",
			"default": 2000,
			"minimum": 10,
			"maximum": 20000,
			"x-kind": "limit",
			"x-ui": { "widget": "number", "group": "Export", "order": 4 }
		}
	}
}
