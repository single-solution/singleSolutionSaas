{
	"type": "object",
	"title": "AI replies",
	"additionalProperties": false,
	"properties": {
		"model": {
			"type": "string",
			"title": "Model (empty = the connector's model, else the provider default below)",
			"default": "",
			"maxLength": 128,
			"x-kind": "config",
			"x-experiment": true,
			"x-ui": { "widget": "text", "group": "Model", "order": 1 }
		},
		"default_models": {
			"type": "object",
			"title": "Default model per provider",
			"default": { "openai": "gpt-4o-mini", "anthropic": "claude-haiku-4-5", "google": "gemini-2.5-flash", "generic": "" },
			"additionalProperties": false,
			"properties": {
				"openai": { "type": "string", "title": "OpenAI", "maxLength": 128 },
				"anthropic": { "type": "string", "title": "Anthropic", "maxLength": 128 },
				"google": { "type": "string", "title": "Google", "maxLength": 128 },
				"generic": { "type": "string", "title": "OpenAI-compatible", "maxLength": 128 }
			},
			"x-kind": "config",
			"x-ui": { "widget": "object", "group": "Model", "order": 2, "advanced": true }
		},
		"assistant_name": {
			"type": "string",
			"title": "Assistant name (empty = the window title string)",
			"default": "",
			"maxLength": 60,
			"x-kind": "config",
			"x-ui": { "widget": "text", "group": "Persona", "order": 3 }
		},
		"tone": {
			"type": "string",
			"title": "Tone preset",
			"default": "friendly",
			"enum": ["friendly", "professional", "concise", "enthusiastic", "empathetic"],
			"x-kind": "config",
			"x-experiment": true,
			"x-ui": { "widget": "select", "group": "Persona", "order": 4 }
		},
		"instructions": {
			"type": "string",
			"title": "Instructions (your business, products, policies, how to help)",
			"description": "Added to the product's safety rules, which cannot be removed.",
			"default": "",
			"maxLength": 12000,
			"x-kind": "config",
			"x-experiment": true,
			"x-ui": { "widget": "textarea", "group": "Persona", "order": 5 }
		},
		"present_as_human": {
			"type": "boolean",
			"title": "Never say it is an AI",
			"description": "Off by default: many jurisdictions require disclosing automated agents. When on, replies that disclose it are replaced.",
			"default": false,
			"x-kind": "flag",
			"x-lock": true,
			"x-ui": { "widget": "switch", "group": "Persona", "order": 6 }
		},
		"forbidden_topics": {
			"type": "array",
			"title": "Topics the assistant must decline",
			"default": [],
			"maxItems": 50,
			"items": { "type": "string", "minLength": 1, "maxLength": 200 },
			"x-kind": "config",
			"x-ui": { "widget": "list", "group": "Persona", "order": 7 }
		},
		"answer_length": {
			"type": "string",
			"title": "Answer length",
			"default": "medium",
			"enum": ["short", "medium", "long"],
			"x-kind": "config",
			"x-experiment": true,
			"x-ui": { "widget": "select", "group": "Answers", "order": 8 }
		},
		"max_output_tokens": {
			"type": "integer",
			"title": "Maximum tokens per answer",
			"default": 500,
			"minimum": 50,
			"maximum": 4000,
			"x-kind": "limit",
			"x-ui": { "widget": "number", "group": "Answers", "order": 9 }
		},
		"temperature": {
			"type": "number",
			"title": "Temperature",
			"default": 0.3,
			"minimum": 0,
			"maximum": 1,
			"x-kind": "config",
			"x-experiment": true,
			"x-ui": { "widget": "number", "group": "Answers", "order": 10, "advanced": true }
		},
		"citation_style": {
			"type": "string",
			"title": "Cite knowledge sources",
			"default": "none",
			"enum": ["none", "inline", "footnote"],
			"x-kind": "config",
			"x-ui": { "widget": "select", "group": "Answers", "order": 11 }
		},
		"max_bubbles": {
			"type": "integer",
			"title": "Maximum message bubbles per answer",
			"default": 4,
			"minimum": 1,
			"maximum": 8,
			"x-kind": "limit",
			"x-ui": { "widget": "number", "group": "Answers", "order": 12 }
		},
		"bubble_separator": {
			"type": "string",
			"title": "Line that splits an answer into bubbles",
			"default": "---",
			"minLength": 3,
			"maxLength": 10,
			"x-kind": "config",
			"x-ui": { "widget": "text", "group": "Answers", "order": 13, "advanced": true }
		},
		"history_turns": {
			"type": "integer",
			"title": "Previous turns sent as context",
			"default": 10,
			"minimum": 0,
			"maximum": 50,
			"x-kind": "limit",
			"x-ui": { "widget": "number", "group": "Answers", "order": 14 }
		},
		"language_lock": {
			"type": "boolean",
			"title": "Answer in the customer's language (checked after generation)",
			"default": true,
			"x-kind": "flag",
			"x-ui": { "widget": "switch", "group": "Languages", "order": 15 }
		},
		"language_retry": {
			"type": "boolean",
			"title": "Retry once when an answer is in the wrong language",
			"default": true,
			"x-kind": "flag",
			"x-ui": { "widget": "switch", "group": "Languages", "order": 16 }
		},
		"max_tool_rounds": {
			"type": "integer",
			"title": "Maximum tool rounds per answer",
			"default": 2,
			"minimum": 0,
			"maximum": 6,
			"x-kind": "limit",
			"x-plan": { "starter": { "default": 2, "max": 2 }, "pro": { "default": 3, "max": 6 } },
			"x-ui": { "widget": "number", "group": "Limits", "order": 17 }
		},
		"request_timeout_ms": {
			"type": "integer",
			"title": "Timeout of one provider call (ms)",
			"default": 20000,
			"minimum": 2000,
			"maximum": 60000,
			"x-kind": "limit",
			"x-ui": { "widget": "number", "group": "Limits", "order": 18 }
		},
		"reply_deadline_ms": {
			"type": "integer",
			"title": "Deadline of a whole answer, tools included (ms)",
			"default": 40000,
			"minimum": 5000,
			"maximum": 55000,
			"x-kind": "limit",
			"x-ui": { "widget": "number", "group": "Limits", "order": 19 }
		},
		"tokens_per_conversation": {
			"type": "integer",
			"title": "Token budget per conversation",
			"default": 30000,
			"minimum": 1000,
			"maximum": 2000000,
			"x-kind": "limit",
			"x-plan": { "starter": { "default": 30000, "max": 100000 }, "pro": { "default": 60000, "max": 2000000 } },
			"x-ui": { "widget": "number", "group": "Budget", "order": 20 }
		},
		"monthly_token_budget": {
			"type": "integer",
			"title": "Token budget per calendar month (0 = no cap)",
			"default": 2000000,
			"minimum": 0,
			"maximum": 10000000000,
			"x-kind": "limit",
			"x-ui": { "widget": "number", "group": "Budget", "order": 21 }
		},
		"cost_alert_percent": {
			"type": "integer",
			"title": "Alert when the monthly budget reaches (%)",
			"default": 80,
			"minimum": 1,
			"maximum": 100,
			"x-kind": "config",
			"x-ui": { "widget": "number", "group": "Budget", "order": 22 }
		},
		"on_failure": {
			"type": "string",
			"title": "When no answer can be produced",
			"default": "fallback_message",
			"enum": ["fallback_message", "handoff", "silent"],
			"x-kind": "config",
			"x-ui": { "widget": "select", "group": "Answers", "order": 23 }
		}
	}
}
