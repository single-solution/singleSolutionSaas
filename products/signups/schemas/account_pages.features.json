{
	"type": "object",
	"title": "Account pages",
	"additionalProperties": false,
	"properties": {
		"pages": {
			"type": "array",
			"title": "Pages",
			"description": "Sections of the account pages, in order. orders lists order events of the customer; consents and data need those elements.",
			"default": ["profile", "sessions", "data"],
			"minItems": 1,
			"maxItems": 6,
			"uniqueItems": true,
			"items": {
				"type": "string",
				"enum": ["profile", "addresses", "sessions", "orders", "consents", "data"]
			},
			"x-kind": "config",
			"x-ui": {
				"widget": "multiselect",
				"group": "Pages",
				"order": 1
			}
		},
		"layout": {
			"type": "string",
			"title": "Layout",
			"default": "tabs",
			"enum": ["tabs", "stacked"],
			"x-kind": "config",
			"x-ui": {
				"widget": "select",
				"group": "Display",
				"order": 2
			}
		},
		"orders_limit": {
			"type": "integer",
			"title": "Orders shown",
			"default": 10,
			"minimum": 1,
			"maximum": 50,
			"x-kind": "limit",
			"x-ui": {
				"widget": "number",
				"group": "Display",
				"order": 3
			}
		}
	}
}
