{
	"type": "object",
	"title": "Magic links",
	"additionalProperties": false,
	"properties": {
		"expiry_minutes": {
			"type": "integer",
			"title": "Link expiry (minutes)",
			"default": 15,
			"minimum": 1,
			"maximum": 60,
			"x-kind": "limit",
			"x-ui": { "widget": "number", "group": "Link", "order": 1 }
		},
		"callback_path": {
			"type": "string",
			"title": "Page the link opens",
			"description": "Path on your website that finishes sign-in (the drop-in widget does it on any page).",
			"default": "/",
			"maxLength": 512,
			"pattern": "^/[^\\s#?]*$",
			"x-kind": "config",
			"x-ui": { "widget": "text", "group": "Link", "order": 2 }
		},
		"allowed_paths": {
			"type": "array",
			"title": "Allowed redirect paths",
			"description": "Links may only lead to these paths of your own domain (https). / allows every path.",
			"default": ["/"],
			"minItems": 1,
			"maxItems": 20,
			"items": { "type": "string", "maxLength": 512, "pattern": "^/[^\\s#?]*$" },
			"x-kind": "config",
			"x-ui": { "widget": "list", "group": "Link", "order": 3 }
		},
		"bind_device": {
			"type": "boolean",
			"title": "Only the device that asked can use the link",
			"default": false,
			"x-kind": "flag",
			"x-ui": { "widget": "switch", "group": "Security", "order": 4 }
		},
		"resend_cooldown_seconds": {
			"type": "integer",
			"title": "Resend cooldown (seconds)",
			"default": 60,
			"minimum": 0,
			"maximum": 3600,
			"x-kind": "limit",
			"x-ui": { "widget": "number", "group": "Limits", "order": 5 }
		},
		"max_sends_per_identity_hour": {
			"type": "integer",
			"title": "Links per e-mail per hour",
			"default": 5,
			"minimum": 1,
			"maximum": 50,
			"x-kind": "limit",
			"x-ui": { "widget": "number", "group": "Limits", "order": 6 }
		},
		"max_sends_per_ip_hour": {
			"type": "integer",
			"title": "Links per IP address per hour",
			"default": 20,
			"minimum": 1,
			"maximum": 1000,
			"x-kind": "limit",
			"x-ui": { "widget": "number", "group": "Limits", "order": 7 }
		},
		"global_sends_per_hour": {
			"type": "integer",
			"title": "Links per hour for the whole website",
			"default": 500,
			"minimum": 1,
			"maximum": 100000,
			"x-kind": "limit",
			"x-plan": { "starter": { "default": 500, "max": 2000 }, "pro": { "default": 2000, "max": 100000 } },
			"x-ui": { "widget": "number", "group": "Limits", "order": 8 }
		},
		"allow_signup": {
			"type": "boolean",
			"title": "Create accounts for new e-mails",
			"default": true,
			"x-kind": "flag",
			"x-ui": { "widget": "switch", "group": "Accounts", "order": 9 }
		},
		"templates": {
			"type": "array",
			"title": "E-mail templates",
			"description": "Per language; placeholders {link}, {minutes}, {brand}.",
			"default": [],
			"maxItems": 30,
			"x-kind": "config",
			"x-ui": { "widget": "list", "group": "Messages", "order": 10 },
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": ["lang", "body"],
				"properties": {
					"lang": { "type": "string", "title": "Language", "maxLength": 35, "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$" },
					"subject": { "type": "string", "title": "Subject", "maxLength": 200 },
					"body": { "type": "string", "title": "Text", "minLength": 1, "maxLength": 4000 }
				}
			}
		}
	}
}
