{
	"type": "object",
	"title": "Risk",
	"additionalProperties": false,
	"properties": {
		"block_disposable_email": {
			"type": "boolean",
			"title": "Refuse disposable e-mail domains",
			"default": true,
			"x-kind": "flag",
			"x-ui": { "widget": "switch", "group": "E-mail", "order": 1 }
		},
		"disposable_domains": {
			"type": "array",
			"title": "Disposable e-mail domains",
			"description": "Subdomains match too. Edit freely: the default list is a starting point.",
			"default": [
				"mailinator.com",
				"guerrillamail.com",
				"10minutemail.com",
				"tempmail.com",
				"temp-mail.org",
				"yopmail.com",
				"trashmail.com",
				"getnada.com",
				"sharklasers.com",
				"maildrop.cc",
				"dispostable.com",
				"throwawaymail.com"
			],
			"maxItems": 2000,
			"uniqueItems": true,
			"items": { "type": "string", "minLength": 3, "maxLength": 253, "pattern": "^[a-z0-9.-]+$" },
			"x-kind": "config",
			"x-ui": { "widget": "list", "group": "E-mail", "order": 2 }
		},
		"blocked_domains": {
			"type": "array",
			"title": "Other blocked e-mail domains",
			"default": [],
			"maxItems": 500,
			"uniqueItems": true,
			"items": { "type": "string", "minLength": 3, "maxLength": 253, "pattern": "^[a-z0-9.-]+$" },
			"x-kind": "config",
			"x-ui": { "widget": "list", "group": "E-mail", "order": 3 }
		},
		"new_device_notice": {
			"type": "boolean",
			"title": "Notify customers of sign-ins from a new device",
			"default": true,
			"x-kind": "flag",
			"x-ui": { "widget": "switch", "group": "Devices", "order": 4 }
		},
		"known_devices_max": {
			"type": "integer",
			"title": "Devices remembered per customer",
			"default": 10,
			"minimum": 1,
			"maximum": 50,
			"x-kind": "limit",
			"x-ui": { "widget": "number", "group": "Devices", "order": 5 }
		},
		"max_identities_per_ip_hour": {
			"type": "integer",
			"title": "Different e-mails / phones per IP per hour",
			"default": 10,
			"minimum": 1,
			"maximum": 1000,
			"x-kind": "limit",
			"x-ui": { "widget": "number", "group": "Velocity", "order": 6 }
		},
		"max_failures_per_ip_hour": {
			"type": "integer",
			"title": "Failed verifications per IP per hour",
			"default": 30,
			"minimum": 1,
			"maximum": 10000,
			"x-kind": "limit",
			"x-ui": { "widget": "number", "group": "Velocity", "order": 7 }
		},
		"retention_days": {
			"type": "integer",
			"title": "Keep risk events (days)",
			"default": 90,
			"minimum": 1,
			"maximum": 730,
			"x-kind": "config",
			"x-ui": { "widget": "number", "group": "Log", "order": 8 }
		},
		"templates": {
			"type": "array",
			"title": "New-device notice templates",
			"description": "Per channel and language; placeholders {device}, {time}, {brand}.",
			"default": [],
			"maxItems": 30,
			"x-kind": "config",
			"x-ui": { "widget": "list", "group": "Devices", "order": 9 },
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": ["channel", "lang", "body"],
				"properties": {
					"channel": { "type": "string", "title": "Channel", "enum": ["email", "sms", "whatsapp"] },
					"lang": { "type": "string", "title": "Language", "maxLength": 35, "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$" },
					"subject": { "type": "string", "title": "Subject (e-mail)", "maxLength": 200 },
					"body": { "type": "string", "title": "Text", "minLength": 1, "maxLength": 2000 }
				}
			}
		}
	}
}
