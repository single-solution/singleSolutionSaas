{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "signups.customer_created@1",
	"description": "A customer account was created by a passwordless sign-in (the standard customer.created@1 is published too).",
	"type": "object",
	"required": ["customerId", "method", "channel"],
	"additionalProperties": false,
	"properties": {
		"customerId": { "type": "string", "minLength": 1, "maxLength": 128 },
		"method": { "type": "string", "enum": ["otp", "magic_link"] },
		"channel": { "type": "string", "enum": ["email", "sms", "whatsapp"] }
	},
	"examples": [{ "customerId": "cus_0mf2k3x1rabcdefghjkmnpqr", "method": "otp", "channel": "email" }]
}
