# Signups & Identity environment (app-kit names from @ss/app-kit API.md). `ss dev env` prints development values.

# Pinned Portal URL — the only Portal this product trusts. `ss dev` runs the local Portal emulator here.
SS_PORTAL_URL=http://localhost:4400
# App id assigned by the Portal at registration (empty before the handshake).
SS_APP_ID=
# Product private signing key: Ed25519 private JWK as one-line JSON. Never commit a real one.
SS_APP_SIGNING_KEY=
# SHA-256 (hex) of the one-time registration token. The token itself is never stored.
SS_REGISTRATION_TOKEN_HASH=
# The product's own small control DB (replay/nonce/entitlement caches, usage queue, sessions of the dashboard, website
# ids for the daily job). Empty = in-memory, development only. Customer data never goes here.
SS_PRODUCT_DB_URI=
SS_LOG_LEVEL=info
# Development-only outbound allowlist (comma-separated hosts/IPs; default loopback). Ignored when NODE_ENV=production.
SS_OUTBOUND_ALLOW_HOSTS=
# Sealing secret (≥ 32 chars) for the per-website HMAC pepper and issuer private keys stored in each merchant's DB.
# SET IT IN PRODUCTION: empty = derived from SS_APP_SIGNING_KEY, so rotating that key would make sealed keys unreadable.
SIGNUPS_SEAL_SECRET=
# Previous sealing secret during a rotation (records sealed with it still open and are re-sealed on use).
SIGNUPS_SEAL_SECRET_PREVIOUS=
# Bearer secret of the daily catch-up cron (GET /cron/maintenance); Vercel Cron sends `Authorization: Bearer $CRON_SECRET`.
CRON_SECRET=
