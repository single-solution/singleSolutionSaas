{
	"type": "object",
	"title": "Evidence photos",
	"additionalProperties": false,
	"properties": {
		"max_photos_per_claim": {
			"type": "integer",
			"title": "Photos per claim",
			"default": 4,
			"minimum": 1,
			"maximum": 10,
			"x-kind": "limit",
			"x-plan": { "starter": { "default": 4, "max": 4 }, "pro": { "default": 6, "max": 10 } },
			"x-ui": { "widget": "number", "group": "Limits", "order": 1 }
		},
		"max_photo_bytes": {
			"type": "integer",
			"title": "Maximum photo size (bytes)",
			"default": 5000000,
			"minimum": 100000,
			"maximum": 20000000,
			"x-kind": "limit",
			"x-ui": { "widget": "number", "group": "Limits", "order": 2 }
		},
		"allowed_types": {
			"type": "array",
			"title": "Allowed image types",
			"default": ["image/jpeg", "image/png", "image/webp"],
			"minItems": 1,
			"maxItems": 4,
			"uniqueItems": true,
			"items": { "type": "string", "enum": ["image/jpeg", "image/png", "image/webp", "image/heic"] },
			"x-kind": "config",
			"x-ui": { "widget": "tags", "group": "Limits", "order": 3 }
		},
		"upload_ttl_seconds": {
			"type": "integer",
			"title": "Upload link lifetime (seconds)",
			"default": 600,
			"minimum": 60,
			"maximum": 3600,
			"x-kind": "limit",
			"x-ui": { "widget": "number", "group": "Links", "order": 4 }
		},
		"view_ttl_seconds": {
			"type": "integer",
			"title": "Photo view link lifetime (seconds)",
			"description": "Photos stay private in your bucket; claims carry presigned view links of this lifetime.",
			"default": 900,
			"minimum": 60,
			"maximum": 86400,
			"x-kind": "limit",
			"x-ui": { "widget": "number", "group": "Links", "order": 5 }
		}
	}
}
