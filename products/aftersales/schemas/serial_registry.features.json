{
	"type": "object",
	"title": "Serial registry",
	"additionalProperties": false,
	"properties": {
		"public_lookup": {
			"type": "boolean",
			"title": "Public warranty lookup",
			"description": "Browsers (pk_) may look a serial up and see the item, its sale date and its cover — never the order or the customer.",
			"default": true,
			"x-kind": "flag",
			"x-ui": { "widget": "switch", "group": "Lookup", "order": 1 }
		},
		"show_sale_date": {
			"type": "boolean",
			"title": "Show the sale date in the public lookup",
			"default": true,
			"x-kind": "flag",
			"x-ui": { "widget": "switch", "group": "Lookup", "order": 2 }
		},
		"case_sensitive": {
			"type": "boolean",
			"title": "Serials are case-sensitive",
			"default": false,
			"x-kind": "flag",
			"x-ui": { "widget": "switch", "group": "Format", "order": 3 }
		},
		"ignore_separators": {
			"type": "boolean",
			"title": "Ignore spaces and dashes",
			"default": true,
			"x-kind": "flag",
			"x-ui": { "widget": "switch", "group": "Format", "order": 4 }
		},
		"min_length": {
			"type": "integer",
			"title": "Shortest serial",
			"default": 4,
			"minimum": 1,
			"maximum": 64,
			"x-kind": "config",
			"x-ui": { "widget": "number", "group": "Format", "order": 5 }
		},
		"max_length": {
			"type": "integer",
			"title": "Longest serial",
			"default": 64,
			"minimum": 4,
			"maximum": 128,
			"x-kind": "limit",
			"x-ui": { "widget": "number", "group": "Format", "order": 6 }
		},
		"lookup_rate_per_minute": {
			"type": "integer",
			"title": "Public lookups per minute (per key)",
			"default": 60,
			"minimum": 1,
			"maximum": 6000,
			"x-kind": "rate",
			"x-per": "minute",
			"x-ui": { "widget": "number", "group": "Lookup", "order": 7 }
		}
	}
}
