{
	"name": "@ss/contracts",
	"version": "0.2.0",
	"description": "Versioned schemas and validators binding the Portal and every product: manifest and settings schemas, Product-Portal wire shapes, business.json, cross-product shapes, ids, RFC 9457 problems, and the address formats per country (`./address`, browser-safe), the CSV writer and parser (`./csv`, browser-safe), the email address check (`./email`, browser-safe), the Format and time-zone helpers (`./format`, browser-safe), the phone-number normalizer (`./phone`, browser-safe), the business profile of the Setup advisor (`./profile`, browser-safe) the message template rules (`./templates`, browser-safe), the text helpers (`./text`, browser-safe) and the value helpers (`./util`, browser-safe).",
	"type": "module",
	"license": "UNLICENSED",
	"exports": {
		".": "./src/index.js",
		"./address": "./src/address.js",
		"./csv": "./src/csv.js",
		"./email": "./src/email.js",
		"./format": "./src/format.js",
		"./phone": "./src/phone.js",
		"./profile": "./src/profile.js",
		"./templates": "./src/templates.js",
		"./text": "./src/text.js",
		"./testing": "./src/testing.js",
		"./util": "./src/util.js",
		"./package.json": "./package.json"
	},
	"files": [
		"src",
		"types"
	],
	"engines": {
		"node": "22.x"
	},
	"publishConfig": {
		"access": "restricted",
		"exports": {
			".": {
				"types": "./types/src/index.d.ts",
				"default": "./src/index.js"
			},
			"./address": {
				"types": "./types/src/address.d.ts",
				"default": "./src/address.js"
			},
			"./csv": {
				"types": "./types/src/csv.d.ts",
				"default": "./src/csv.js"
			},
			"./email": {
				"types": "./types/src/email.d.ts",
				"default": "./src/email.js"
			},
			"./format": {
				"types": "./types/src/format.d.ts",
				"default": "./src/format.js"
			},
			"./phone": {
				"types": "./types/src/phone.d.ts",
				"default": "./src/phone.js"
			},
			"./profile": {
				"types": "./types/src/profile.d.ts",
				"default": "./src/profile.js"
			},
			"./templates": {
				"types": "./types/src/templates.d.ts",
				"default": "./src/templates.js"
			},
			"./text": {
				"types": "./types/src/text.d.ts",
				"default": "./src/text.js"
			},
			"./testing": {
				"types": "./types/src/testing.d.ts",
				"default": "./src/testing.js"
			},
			"./util": {
				"types": "./types/src/util.d.ts",
				"default": "./src/util.js"
			},
			"./package.json": "./package.json"
		}
	},
	"prettier": "@ss/config/prettier.json",
	"scripts": {
		"check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
		"test": "vitest run --coverage",
		"lint": "eslint .",
		"typecheck": "tsc -p tsconfig.json",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"build:types": "tsc -p tsconfig.types.json",
		"prepack": "pnpm build:types"
	},
	"dependencies": {
		"ajv": "^8.17.1",
		"ajv-formats": "^3.0.1"
	},
	"devDependencies": {
		"@ss/config": "workspace:^",
		"@types/node": "^22.20.4",
		"@vitest/coverage-v8": "^3.2.7",
		"eslint": "^9.39.5",
		"prettier": "^3.9.9",
		"typescript": "~5.9.3",
		"vitest": "^3.2.7"
	}
}
