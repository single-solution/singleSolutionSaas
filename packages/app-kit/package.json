{
	"name": "@ss/app-kit",
	"version": "0.1.0",
	"description": "Everything a service product needs to follow the Product Standard: registration, launches, website keys, entitlements with offline grace, usage reporting, events, client-owned data access, connectors, audit.",
	"type": "module",
	"license": "UNLICENSED",
	"exports": {
		".": "./src/index.js",
		"./testing": "./src/testing.js",
		"./proxy": "./src/proxy.js",
		"./package.json": "./package.json"
	},
	"files": [
		"src",
		"API.md",
		"types"
	],
	"engines": {
		"node": ">=22"
	},
	"publishConfig": {
		"access": "restricted",
		"exports": {
			".": {
				"types": "./types/src/index.d.ts",
				"default": "./src/index.js"
			},
			"./testing": {
				"types": "./types/src/testing.d.ts",
				"default": "./src/testing.js"
			},
			"./proxy": {
				"types": "./types/src/proxy.d.ts",
				"default": "./src/proxy.js"
			},
			"./package.json": "./package.json"
		}
	},
	"prettier": "@ss/config/prettier.json",
	"scripts": {
		"check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
		"test": "vitest run --coverage",
		"test:watch": "vitest",
		"lint": "eslint .",
		"typecheck": "tsc -p tsconfig.json",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"build:types": "tsc -p tsconfig.types.json",
		"prepack": "pnpm build:types"
	},
	"dependencies": {
		"@ss/contracts": "workspace:^",
		"@ss/net": "workspace:^",
		"@ss/protocol": "workspace:^",
		"mongodb": "^6.20.0",
		"nodemailer": "^10.0.13"
	},
	"devDependencies": {
		"@ss/config": "workspace:^",
		"@types/node": "^22.20.4",
		"@vitest/coverage-v8": "^3.2.7",
		"eslint": "^9.39.5",
		"mongodb-memory-server": "^10.4.3",
		"prettier": "^3.9.9",
		"typescript": "~5.9.3",
		"vitest": "^3.2.7"
	}
}
