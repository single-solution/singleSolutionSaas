{
	"name": "@ss/app-kit",
	"version": "0.2.0",
	"description": "The kit every product is built on: Portal connection, tokens and tickets, status checks, notices, price and feature reports, settings, widget texts and theme, encrypted connections, the merchant database guard, business.json, data rights, activity log, Recent changes, the product dashboard API and the widget mount.",
	"type": "module",
	"license": "UNLICENSED",
	"exports": {
		".": "./src/index.js",
		"./testing": "./src/testing.js",
		"./widget": "./src/widget.js",
		"./package.json": "./package.json"
	},
	"files": [
		"src",
		"API.md",
		"types"
	],
	"engines": {
		"node": ">=22"
	},
	"publishConfig": {
		"access": "restricted",
		"exports": {
			".": {
				"types": "./types/src/index.d.ts",
				"default": "./src/index.js"
			},
			"./testing": {
				"types": "./types/src/testing.d.ts",
				"default": "./src/testing.js"
			},
			"./widget": {
				"types": "./types/src/widget.d.ts",
				"default": "./src/widget.js"
			},
			"./package.json": "./package.json"
		}
	},
	"prettier": "@ss/config/prettier.json",
	"scripts": {
		"check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
		"test": "vitest run --coverage",
		"test:watch": "vitest",
		"lint": "eslint .",
		"typecheck": "tsc -p tsconfig.json",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"build:types": "tsc -p tsconfig.types.json",
		"prepack": "pnpm build:types"
	},
	"dependencies": {
		"@ss/contracts": "workspace:^",
		"@ss/net": "workspace:^",
		"@ss/protocol": "workspace:^",
		"mongodb": "^6.20.0"
	},
	"devDependencies": {
		"@ss/config": "workspace:^",
		"@types/node": "^22.20.4",
		"@vitest/coverage-v8": "^3.2.7",
		"eslint": "^9.39.5",
		"jsdom": "^26.1.0",
		"mongodb-memory-server": "^10.4.3",
		"prettier": "^3.9.9",
		"typescript": "~7.0.2",
		"vitest": "^3.2.7"
	}
}
