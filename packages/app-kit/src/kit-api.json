			"type": "object",
			"required": ["value"],
			"properties": {
				"value": {}
			}
		},
		"response": {
			"type": "object",
			"required": ["value"],
			"additionalProperties": false,
			"properties": {
				"value": {
					"description": "The list as saved."
				}
			}
		}
	},
	"GET /v1/connections": {
		"summary": "Connections (state and last 4 characters only)",
