	"GET /v1/activity": {
		"summary": "The activity log, newest first",
		"query": {
			"type": "object",
			"properties": {
				"actor": {
					"type": "string",
					"maxLength": 256,
					"description": "An actor id."
				},
				"action": {
					"type": "string",
					"description": "One action, or several separated by commas."
				},
				"target": {
					"type": "string",
					"maxLength": 256,
					"description": "A target id."
				},
				"q": {
					"type": "string",
					"description": "Searches labels, details, actor names and targets."
				},
				"from": {
					"type": "string",
					"description": "An ISO-8601 time, or a day (YYYY-MM-DD) in the business time zone."
				},
				"to": {
					"type": "string",
					"description": "An ISO-8601 time, or a day (YYYY-MM-DD; its end) in the business time zone."
				},
				"cursor": {
					"type": "string",
					"description": "nextCursor of the previous page."
				},
				"limit": {
					"type": "integer",
					"minimum": 1,
					"maximum": 100,
					"default": 50
				}
			}
		},
		"response": {
			"type": "object",
			"required": ["items", "nextCursor", "hasMore"],
			"additionalProperties": false,
			"properties": {
				"items": {
					"type": "array",
					"items": {
						"$ref": "#/components/schemas/ActivityEntry"
					}
				},
				"nextCursor": {
					"type": ["string", "null"]
				},
				"hasMore": {
					"type": "boolean"
				}
			}
		}
	},
	"GET /v1/activity/count": {
		"summary": "Count the activity log",
		"query": {
			"type": "object",
			"properties": {
				"actor": {
					"type": "string",
					"maxLength": 256
				},
				"action": {
					"type": "string"
				},
				"target": {
					"type": "string",
					"maxLength": 256
				},
				"q": {
					"type": "string"
				},
				"from": {
					"type": "string"
				},
				"to": {
					"type": "string"
				}
			}
		},
		"response": {
			"$ref": "#/components/schemas/Count"
		}
	},
	"GET /v1/activity/counts": {
		"summary": "Count the activity log by action, actor or kind",
		"query": {
			"type": "object",
			"required": ["by"],
			"properties": {
				"by": {
					"type": "string",
					"enum": ["action", "actor", "kind"]
				},
				"actor": {
					"type": "string",
					"maxLength": 256
				},
				"action": {
					"type": "string"
				},
				"target": {
					"type": "string",
					"maxLength": 256
				},
				"q": {
					"type": "string"
				},
				"from": {
					"type": "string"
				},
				"to": {
					"type": "string"
				}
			}
		},
		"response": {
			"$ref": "#/components/schemas/Counts"
		}
	}
}
