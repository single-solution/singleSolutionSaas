{
	"name": "@ss/importer",
	"version": "0.1.0",
	"description": "ss-import: reads a store database read-only into NDJSON files and an id map (one source mapping per schema family), sends them to the products' import routes with the server tokens (dry run first), and verifies the counts. Never deployed.",
	"type": "module",
	"license": "UNLICENSED",
	"exports": {
		".": "./src/index.js",
		"./fixture": "./src/fixture/index.js",
		"./package.json": "./package.json"
	},
	"files": [
		"src"
	],
	"bin": {
		"ss-import": "./src/bin.js"
	},
	"engines": {
		"node": "22.x"
	},
	"publishConfig": {
		"access": "restricted"
	},
	"prettier": "@ss/config/prettier.json",
	"scripts": {
		"check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
		"test": "vitest run --coverage",
		"test:watch": "vitest",
		"lint": "eslint .",
		"typecheck": "tsc -p tsconfig.json",
		"format": "prettier --write .",
		"format:check": "prettier --check ."
	},
	"dependencies": {
		"@ss/contracts": "workspace:^",
		"mongodb": "^6.21.0"
	},
	"devDependencies": {
		"@ss/config": "workspace:^",
		"@types/node": "^22.20.4",
		"@vitest/coverage-v8": "^3.2.7",
		"eslint": "^9.39.5",
		"mongodb-memory-server": "^10.4.3",
		"prettier": "^3.9.9",
		"typescript": "~5.9.3",
		"vitest": "^3.2.7"
	}
}
