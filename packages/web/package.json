{
	"name": "@ss/web",
	"version": "0.1.0",
	"description": "Widget helpers a product may bundle into its own widget.js: a DOM-free widget core, an API client and safe DOM helpers.",
	"type": "module",
	"license": "UNLICENSED",
	"exports": {
		".": "./src/index.js",
		"./widget": "./src/widget.js",
		"./renderer": "./src/renderer.js",
		"./package.json": "./package.json"
	},
	"files": [
		"src",
		"types"
	],
	"sideEffects": false,
	"engines": {
		"node": ">=22"
	},
	"publishConfig": {
		"access": "restricted",
		"exports": {
			".": {
				"types": "./types/src/index.d.ts",
				"default": "./src/index.js"
			},
			"./widget": {
				"types": "./types/src/widget.d.ts",
				"default": "./src/widget.js"
			},
			"./renderer": {
				"types": "./types/src/renderer.d.ts",
				"default": "./src/renderer.js"
			},
			"./package.json": "./package.json"
		}
	},
	"prettier": "@ss/config/prettier.json",
	"scripts": {
		"check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
		"test": "vitest run --coverage",
		"test:watch": "vitest",
		"lint": "eslint .",
		"typecheck": "tsc -p tsconfig.json",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"build:types": "tsc -p tsconfig.types.json",
		"prepack": "pnpm build:types"
	},
	"devDependencies": {
		"@ss/config": "workspace:^",
		"@types/node": "^22.20.4",
		"@vitest/coverage-v8": "^3.2.7",
		"eslint": "^9.39.5",
		"jsdom": "^30.1.2",
		"prettier": "^3.9.9",
		"typescript": "~5.9.3",
		"vitest": "^3.2.7"
	}
}
