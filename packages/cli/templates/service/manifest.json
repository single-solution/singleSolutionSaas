{
	"ssps": "1",
	"product": {
		"slug": "{{slug}}",
		"name": "{{name}}",
		"kind": "service",
		"version": "0.1.0",
		"category": "tools",
		"description": "{{name}}: a service product generated by ss app init."
	},
	"endpoints": {
		"base": "https://{{slug}}.example.com",
		"dashboard": "/dashboard",
		"demo": "/dashboard",
		"events": "/.well-known/ss-events",
		"register": "/.well-known/ss-register"
	},
	"capabilities": {
		"adminLaunch": true,
		"sandbox": true,
		"localEnforcement": ["limit:notes.max_notes"],
		"offlineGrace": "PT24H"
	},
	"scopes": ["events.subscribe:order.placed"],
	"requires": { "resources": ["database"] },
	"events": { "consumes": ["order.placed@1"], "publishes": ["{{namespace}}.note_created@1"] },
	"budget": { "shared": 1 },
	"elements": [
		{
			"key": "notes",
			"name": "Notes",
			"description": "A tiny stateful element: per-website notes with pinning.",
			"modes": ["A", "B", "C"],
			"stateful": true,
			"price": {
				"hourly": 10,
				"metered": [{ "unit": "note_created", "perUnit": 1, "per": 10, "included": { "starter": 100 } }]
			},
			"budget": { "js": 3 },
			"dependsOn": [],
			"requires": { "resources": ["database"] },
			"features": { "$ref": "schemas/notes.features.json" },
			"strings": "strings/en.json",
			"placement": true,
			"api": { "resources": ["notes"] },
			"headless": "headless/notes.js#createNotes",
			"renderer": "ui/notes.js#render",
			"variants": ["list", "compact"],
			"slots": ["before", "after", "empty"],
			"a11y": { "role": "region", "labels": true, "keyboard": true, "reducedMotion": true }
		}
	],
	"plans": [{ "code": "starter", "name": "Starter", "elements": ["notes"] }],
	"priceBook": { "version": "2026-01-01", "effectiveFrom": "2026-01-01T00:00:00Z" },
	"trialHours": 48,
	"retention": { "notes": "P365D" }
}
