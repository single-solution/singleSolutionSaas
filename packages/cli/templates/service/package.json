{
	"name": "{{slug}}",
	"version": "0.1.0",
	"description": "{{name}} — SSPS v1 service product.",
	"type": "module",
	"private": true,
	"license": "UNLICENSED",
	"engines": {
		"node": ">=22"
	},
	"prettier": "@ss/config/prettier.json",
	"scripts": {
		"dev": "next dev --port 3000",
		"prebuild": "ss app assets .",
		"build": "next build",
		"start": "next start --port 3000",
		"serve": "node serve.js 3000",
		"portal": "ss dev",
		"check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
		"test": "vitest run --coverage",
		"test:watch": "vitest",
		"lint": "eslint .",
		"typecheck": "tsc -p tsconfig.json",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"validate": "ss app validate .",
		"certify": "ss certify . --url http://localhost:3000"
	},
	"dependencies": {
		"@ss/app-kit": "{{sdkVersion}}",
		"@ss/contracts": "{{sdkVersion}}",
		"mongodb": "^6.21.0",
		"next": "^16.3.7",
		"react": "^19.3.0",
		"react-dom": "^19.3.0"
	},
	"devDependencies": {
		"@ss/cli": "{{sdkVersion}}",
		"@ss/config": "{{sdkVersion}}",
		"@types/node": "^22.20.4",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitest/coverage-v8": "^3.2.7",
		"eslint": "^9.39.5",
		"prettier": "^3.9.9",
		"typescript": "~5.9.3",
		"vitest": "^3.2.7"
	}
}
