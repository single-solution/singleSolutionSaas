{
	"openapi": "3.1.0",
	"info": { "title": "{{name}} API", "version": "0.1.0", "description": "Mode C API of {{name}} (SSPS v1)." },
	"servers": [{ "url": "https://{{slug}}.example.com" }],
	"security": [{ "websiteKey": [] }],
	"paths": {
		"/v1/notes": {
			"get": {
				"operationId": "listNotes",
				"summary": "List notes (newest first, cursor pagination)",
				"parameters": [
					{ "name": "cursor", "in": "query", "schema": { "type": "string" } },
					{ "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 20 } }
				],
				"responses": {
					"200": {
						"description": "A page of notes. `Link: <…>; rel=\"next\"` when more exist.",
						"content": {
							"application/json": {
								"schema": { "$ref": "#/components/schemas/NotePage" },
								"example": {
									"items": [
										{
											"id": "note_0mf2k3x1rabc",
											"text": "Call supplier",
											"pinned": false,
											"createdAt": "2026-10-01T09:00:00.000Z",
											"updatedAt": "2026-10-01T09:00:00.000Z"
										}
									],
									"nextCursor": null
								}
							}
						}
					},
					"default": { "$ref": "#/components/responses/Problem" }
				}
			},
			"post": {
				"operationId": "createNote",
				"summary": "Create a note",
				"parameters": [
					{ "name": "Idempotency-Key", "in": "header", "required": true, "schema": { "type": "string", "maxLength": 255 } }
				],
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": { "$ref": "#/components/schemas/NoteInput" },
							"example": { "text": "Call supplier" }
						}
					}
				},
				"responses": {
					"201": {
						"description": "Created",
						"content": {
							"application/json": {
								"schema": { "$ref": "#/components/schemas/Note" },
								"example": {
									"id": "note_0mf2k3x1rabc",
									"text": "Call supplier",
									"pinned": false,
									"createdAt": "2026-10-01T09:00:00.000Z",
									"updatedAt": "2026-10-01T09:00:00.000Z"
								}
							}
						}
					},
					"default": { "$ref": "#/components/responses/Problem" }
				}
			}
		},
		"/v1/notes/{id}": {
			"parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
			"get": {
				"operationId": "getNote",
				"responses": {
					"200": {
						"description": "The note",
						"content": { "application/json": { "schema": { "$ref": "#/components/schemas/Note" } } }
					},
					"default": { "$ref": "#/components/responses/Problem" }
				}
			},
			"patch": {
				"operationId": "updateNote",
				"requestBody": {
					"required": true,
					"content": {
						"application/merge-patch+json": {
							"schema": { "$ref": "#/components/schemas/NotePatch" },
							"example": { "pinned": true }
						}
					}
				},
				"responses": {
					"200": {
						"description": "Updated",
						"content": { "application/json": { "schema": { "$ref": "#/components/schemas/Note" } } }
					},
					"default": { "$ref": "#/components/responses/Problem" }
				}
			},
			"delete": {
				"operationId": "deleteNote",
				"responses": {
					"200": {
						"description": "Soft-deleted",
						"content": { "application/json": { "example": { "id": "note_0mf2k3x1rabc", "deleted": true } } }
					},
					"default": { "$ref": "#/components/responses/Problem" }
				}
			}
		}
	},
	"components": {
		"securitySchemes": {
			"websiteKey": {
				"type": "http",
				"scheme": "bearer",
				"description": "pk_ (browser, domain-locked) or sk_ (server) website key"
			}
		},
		"schemas": {
			"Note": {
				"type": "object",
				"required": ["id", "text", "pinned", "createdAt", "updatedAt"],
				"properties": {
					"id": { "type": "string" },
					"text": { "type": "string" },
					"pinned": { "type": "boolean" },
					"createdAt": { "type": "string", "format": "date-time" },
					"updatedAt": { "type": "string", "format": "date-time" }
				}
			},
			"NoteInput": {
				"type": "object",
				"required": ["text"],
				"additionalProperties": false,
				"properties": { "text": { "type": "string", "minLength": 1 }, "pinned": { "type": "boolean" } }
			},
			"NotePatch": {
				"type": "object",
				"additionalProperties": false,
				"properties": { "text": { "type": "string", "minLength": 1 }, "pinned": { "type": "boolean" } }
			},
			"NotePage": {
				"type": "object",
				"required": ["items", "nextCursor"],
				"properties": {
					"items": { "type": "array", "items": { "$ref": "#/components/schemas/Note" } },
					"nextCursor": { "type": ["string", "null"] }
				}
			},
			"Problem": {
				"type": "object",
				"required": ["type", "title", "status"],
				"properties": {
					"type": { "type": "string" },
					"title": { "type": "string" },
					"status": { "type": "integer" },
					"detail": { "type": "string" },
					"instance": { "type": "string" },
					"requestId": { "type": "string" },
					"errors": { "type": "array", "items": { "type": "object" } }
				}
			}
		},
		"responses": {
			"Problem": {
				"description": "RFC 9457 problem details",
				"content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } }
			}
		}
	}
}
