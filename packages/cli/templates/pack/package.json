{
	"name": "{{slug}}",
	"version": "0.1.0",
	"description": "{{name}} — SSPS v1 element pack.",
	"type": "module",
	"private": true,
	"license": "UNLICENSED",
	"exports": {
		"./headless/*": "./headless/*",
		"./ui/*": "./ui/*"
	},
	"engines": {
		"node": ">=22"
	},
	"prettier": "@ss/config/prettier.json",
	"scripts": {
		"dev": "ss dev",
		"check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
		"test": "vitest run --coverage",
		"test:watch": "vitest",
		"lint": "eslint .",
		"typecheck": "tsc -p tsconfig.json",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"validate": "ss app validate .",
		"certify": "ss certify ."
	},
	"dependencies": {
		"@ss/contracts": "{{sdkVersion}}"
	},
	"devDependencies": {
		"@ss/cli": "{{sdkVersion}}",
		"@ss/config": "{{sdkVersion}}",
		"@types/node": "^22.20.4",
		"@vitest/coverage-v8": "^3.2.7",
		"eslint": "^9.39.5",
		"prettier": "^3.9.9",
		"typescript": "~5.9.3",
		"vitest": "^3.2.7"
	}
}
