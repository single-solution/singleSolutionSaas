{
	"$schemas": {
		"Note": {
			"type": "object",
			"description": "A visitor's note.",
			"required": ["id", "text", "email", "createdAt"],
			"additionalProperties": false,
			"properties": {
				"id": { "type": "string", "pattern": "^note_[0-9a-z]{10,64}$" },
				"text": { "type": "string", "minLength": 1, "maxLength": 2000 },
				"email": { "type": ["string", "null"], "format": "email", "maxLength": 254, "description": "Lower case." },
				"createdAt": { "type": "string", "format": "date-time" }
			}
		},
		"NotePage": {
			"type": "object",
			"description": "One page of notes, newest first.",
			"required": ["items", "nextCursor", "hasMore"],
			"additionalProperties": false,
			"properties": {
				"items": { "type": "array", "items": { "$ref": "#/components/schemas/Note" } },
				"nextCursor": { "type": ["string", "null"], "description": "Pass it as cursor for the next page." },
				"hasMore": { "type": "boolean" }
			}
		}
	},
	"POST /v1/notes": {
		"summary": "Leave a note",
		"description": "A visitor leaves a note. A text longer than the maxLength setting answers 422 validation_failed.",
		"body": {
			"type": "object",
			"required": ["text"],
			"properties": {
				"text": {
					"type": "string",
					"minLength": 1,
					"maxLength": 2000,
					"description": "Trimmed; at most the maxLength setting."
				},
				"email": { "type": "string", "maxLength": 254, "description": "Optional; '' for none." }
			}
		},
		"status": 201,
		"response": {
			"type": "object",
			"required": ["id", "createdAt"],
			"additionalProperties": false,
			"properties": {
				"id": { "type": "string", "pattern": "^note_[0-9a-z]{10,64}$" },
				"createdAt": { "type": "string", "format": "date-time" }
			}
		}
	},
	"GET /v1/notes": {
		"summary": "The notes, newest first",
		"query": {
			"type": "object",
			"properties": {
				"cursor": { "type": "string", "description": "nextCursor of the previous page." },
				"limit": { "type": "integer", "minimum": 1, "maximum": 100, "default": 20 }
			}
		},
		"response": { "$ref": "#/components/schemas/NotePage" }
	},
	"GET /v1/notes/count": { "summary": "Count the notes", "response": { "$ref": "#/components/schemas/Count" } },
	"GET /v1/admin/notes": {
		"summary": "The notes, newest first (inbox widget)",
		"query": {
			"type": "object",
			"properties": {
				"cursor": { "type": "string", "description": "nextCursor of the previous page." },
				"limit": { "type": "integer", "minimum": 1, "maximum": 100, "default": 20 }
			}
		},
		"response": { "$ref": "#/components/schemas/NotePage" }
	},
	"GET /v1/admin/notes/count": {
		"summary": "Count the notes (inbox widget)",
		"response": { "$ref": "#/components/schemas/Count" }
	}
}
