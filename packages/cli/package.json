{
	"name": "@ss/cli",
	"version": "0.1.0",
	"description": "Developer CLI: app init, validate, pack build | publish, dev (local Portal emulator), register, certify.",
	"type": "module",
	"license": "UNLICENSED",
	"exports": {
		".": "./src/index.js",
		"./pack": "./src/pack/index.js",
		"./package.json": "./package.json"
	},
	"files": [
		"src",
		"templates",
		"types"
	],
	"bin": {
		"ss": "./src/bin.js"
	},
	"engines": {
		"node": ">=22"
	},
	"publishConfig": {
		"access": "restricted",
		"exports": {
			".": {
				"types": "./types/src/index.d.ts",
				"default": "./src/index.js"
			},
			"./pack": {
				"types": "./types/src/pack/index.d.ts",
				"default": "./src/pack/index.js"
			},
			"./package.json": "./package.json"
		}
	},
	"prettier": "@ss/config/prettier.json",
	"scripts": {
		"check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
		"test": "vitest run --coverage",
		"test:watch": "vitest",
		"lint": "eslint .",
		"typecheck": "tsc -p tsconfig.json",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"build:types": "tsc -p tsconfig.types.json",
		"prepack": "pnpm build:types"
	},
	"dependencies": {
		"@ss/contracts": "workspace:^",
		"@ss/entitlements": "workspace:^",
		"@ss/protocol": "workspace:^",
		"@ss/rules": "workspace:^",
		"esbuild": "^0.28.2"
	},
	"peerDependencies": {
		"mongodb-memory-server": "^10.4.3"
	},
	"peerDependenciesMeta": {
		"mongodb-memory-server": {
			"optional": true
		}
	},
	"devDependencies": {
		"@ss/app-kit": "workspace:^",
		"@ss/config": "workspace:^",
		"@types/node": "^22.20.4",
		"@vitest/coverage-v8": "^3.2.7",
		"eslint": "^9.39.5",
		"mongodb-memory-server": "^10.4.3",
		"prettier": "^3.9.9",
		"typescript": "~5.9.3",
		"vitest": "^3.2.7"
	}
}
