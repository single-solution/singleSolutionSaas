{
	"name": "@ss/cli",
	"version": "0.2.0",
	"description": "Developer CLI for Single Solution products: ss app init, ss app validate, ss app assets.",
	"type": "module",
	"license": "UNLICENSED",
	"exports": {
		".": "./src/index.js",
		"./package.json": "./package.json"
	},
	"files": [
		"src",
		"templates",
		"types"
	],
	"bin": {
		"ss": "./src/bin.js"
	},
	"engines": {
		"node": ">=22"
	},
	"publishConfig": {
		"access": "restricted",
		"exports": {
			".": {
				"types": "./types/src/index.d.ts",
				"default": "./src/index.js"
			},
			"./package.json": "./package.json"
		}
	},
	"prettier": "@ss/config/prettier.json",
	"scripts": {
		"check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
		"test": "vitest run --coverage",
		"test:watch": "vitest",
		"lint": "eslint .",
		"typecheck": "tsc -p tsconfig.json",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"build:types": "tsc -p tsconfig.types.json",
		"prepack": "pnpm build:types"
	},
	"dependencies": {
		"@ss/app-kit": "workspace:^",
		"@ss/contracts": "workspace:^",
		"esbuild": "^0.28.2"
	},
	"devDependencies": {
		"@ss/config": "workspace:^",
		"@types/node": "^22.20.4",
		"@vitest/coverage-v8": "^3.2.7",
		"eslint": "^10.12.0",
		"jsdom": "^26.1.0",
		"mongodb": "^6.21.0",
		"mongodb-memory-server": "^10.4.3",
		"prettier": "^3.9.9",
		"typescript": "~5.9.3",
		"vitest": "^3.2.7"
	}
}
