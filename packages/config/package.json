{
	"name": "@ss/config",
	"version": "0.1.0",
	"description": "Shared tooling for every Single Solution unit: ESLint (functional rules, JSX variant), TypeScript base config, Prettier config, the Vitest preset and the MongoMemoryReplSet global setup.",
	"type": "module",
	"license": "UNLICENSED",
	"exports": {
		"./eslint": "./eslint.js",
		"./vitest": "./vitest.js",
		"./mongo-setup": "./mongo-setup.js",
		"./tsconfig.base.json": "./tsconfig.base.json",
		"./prettier.json": "./prettier.json",
		"./package.json": "./package.json"
	},
	"files": [
		"eslint.js",
		"vitest.js",
		"mongo-setup.js",
		"tsconfig.base.json",
		"prettier.json",
		"types"
	],
	"engines": {
		"node": ">=22"
	},
	"publishConfig": {
		"access": "restricted",
		"exports": {
			"./eslint": {
				"types": "./types/eslint.d.ts",
				"default": "./eslint.js"
			},
			"./vitest": {
				"types": "./types/vitest.d.ts",
				"default": "./vitest.js"
			},
			"./mongo-setup": {
				"types": "./types/mongo-setup.d.ts",
				"default": "./mongo-setup.js"
			},
			"./tsconfig.base.json": "./tsconfig.base.json",
			"./prettier.json": "./prettier.json",
			"./package.json": "./package.json"
		}
	},
	"prettier": "./prettier.json",
	"scripts": {
		"check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
		"test": "vitest run --coverage",
		"lint": "eslint .",
		"typecheck": "tsc -p tsconfig.json",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"build:types": "tsc -p tsconfig.types.json",
		"prepack": "pnpm build:types"
	},
	"dependencies": {
		"@eslint/js": "^9.39.5",
		"globals": "^17.12.0"
	},
	"peerDependencies": {
		"@vitest/coverage-v8": "^3.2.7",
		"eslint": "^9.39.5",
		"mongodb": "^6.21.0",
		"mongodb-memory-server": "^10.4.3",
		"prettier": "^3.9.9",
		"typescript": "~7.0.2",
		"vitest": "^3.2.7"
	},
	"peerDependenciesMeta": {
		"@vitest/coverage-v8": {
			"optional": true
		},
		"eslint": {
			"optional": true
		},
		"mongodb": {
			"optional": true
		},
		"mongodb-memory-server": {
			"optional": true
		},
		"prettier": {
			"optional": true
		},
		"typescript": {
			"optional": true
		},
		"vitest": {
			"optional": true
		}
	},
	"devDependencies": {
		"@types/node": "^22.20.4",
		"@vitest/coverage-v8": "^3.2.7",
		"eslint": "^9.39.5",
		"mongodb": "^6.21.0",
		"mongodb-memory-server": "^10.4.3",
		"prettier": "^3.9.9",
		"typescript": "~7.0.2",
		"vitest": "^3.2.7"
	}
}
