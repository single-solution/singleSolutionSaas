{
	"name": "@ss/platform",
	"version": "0.1.0",
	"description": "Single Solution Portal — admins, merchants, websites, connected products, products on websites with their tokens, credits and billing, consoles.",
	"type": "module",
	"private": true,
	"license": "UNLICENSED",
	"exports": {
		"./testing": "./src/testing.js",
		"./package.json": "./package.json"
	},
	"engines": {
		"node": ">=22"
	},
	"prettier": "@ss/config/prettier.json",
	"scripts": {
		"dev": "next dev -p 4000",
		"build": "next build",
		"start": "next start -p 4000",
		"db:memory": "node scripts/dev-mongo.js",
		"env:dev": "node scripts/dev-env.js",
		"check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
		"test": "vitest run --coverage",
		"test:watch": "vitest",
		"lint": "eslint .",
		"typecheck": "tsc -p tsconfig.json",
		"format": "prettier --write .",
		"format:check": "prettier --check ."
	},
	"dependencies": {
		"@ss/contracts": "workspace:^",
		"@ss/net": "workspace:^",
		"@ss/protocol": "workspace:^",
		"@ss/ui": "workspace:^",
		"mongodb": "^6.21.0",
		"next": "^16.3.7",
		"nodemailer": "^10.0.13",
		"qrcode-generator": "2.0.4",
		"react": "^19.3.0",
		"react-dom": "^19.3.0"
	},
	"devDependencies": {
		"@ss/config": "workspace:^",
		"@tailwindcss/postcss": "^4.3.3",
		"@types/node": "^22.20.4",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitest/coverage-v8": "^3.2.7",
		"eslint": "^9.39.5",
		"fast-check": "^4.10.2",
		"jsdom": "^26.1.0",
		"mongodb-memory-server": "^10.4.3",
		"prettier": "^3.9.9",
		"tailwindcss": "^4.3.3",
		"typescript": "~5.9.3",
		"vitest": "^3.2.7"
	}
}
