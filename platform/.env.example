# Portal environment. Full reference: platform/README.md (Configuration).
# Development: `pnpm env:dev > .env.local` prints fresh local values. Never commit real values.

# ── Required ────────────────────────────────────────────────────────────────
# Control-plane MongoDB (never a client database). Atlas: mongodb+srv://user:pass@cluster/ss_portal
MONGODB_URI=
# Canonical Portal URL, https in production.
PORTAL_URL=http://localhost:4000
# JSON array of private Ed25519 JWKs; the first signs, all are published.
PORTAL_SIGNING_KEYS=
# Envelope-encryption key(s): kid:base64(32 bytes)[,kid:base64…], first is active.
SECRETS_KEK=
# ≥ 32 bytes each, all different.
SESSION_SECRET=
WEBSITE_KEY_PEPPER=
# ≥ 32 characters; the daily cron (/api/cron/daily) requires Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=
# Production: JSON array of private Ed25519 JWKs that sign website keys only (kids differ from the Portal's).
WEBSITE_KEY_SIGNING_KEYS=

# ── Optional ────────────────────────────────────────────────────────────────
PORTAL_ENV=
MONGODB_DB=
# Pool per instance (default 5; one Atlas M0 cluster allows ~500 connections across every deployment).
MONGODB_MAX_POOL_SIZE=
IDEMPOTENCY_SECRET=
# Platform mailer: smtp(s)://user:pass@host:port and the sender.
PLATFORM_SMTP_URL=
PLATFORM_MAIL_FROM=
# Our delivery artefacts (never client data): S3-compatible JSON config, or file:<dir> / memory outside production.
PLATFORM_ASSET_STORAGE=
# Separate cookie-less origin for merchant previews (another registrable domain is best).
PREVIEW_ORIGIN=
DELIVERY_BUDGET_KB=
PROBLEM_BASE_URI=
PORTAL_VERSION=
LOG_LEVEL=info
TRUST_PROXY_HEADERS=
MAX_BODY_BYTES=
CRON_DEADLINE_MS=
STAFF_SESSION_IDLE_MINUTES=
STAFF_SESSION_MAX_HOURS=
MERCHANT_SESSION_IDLE_MINUTES=
MERCHANT_SESSION_MAX_HOURS=
# Development only: hosts outbound calls may reach although private or plain http.
OUTBOUND_DEV_ALLOW_HOSTS=
