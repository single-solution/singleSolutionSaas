# Portal environment: every value is a plain string. Full reference: platform/README.md (Environment).
# Development: `pnpm env:dev > .env.local` prints fresh local values. Never commit real values.
# NODE_ENV decides the environment (production unless development or test).

# ── Required ────────────────────────────────────────────────────────────────
# Control-plane MongoDB (never a client database). Atlas: mongodb+srv://user:pass@cluster/ss_portal
MONGODB_URI=
# The Portal's address (token issuer/audience, e-mail links, CSRF origin). Development default http://localhost:4000.
PUBLIC_URL=https://portal.example.com
# Ed25519 signing keys, kid:seed (seed = base64url of 32 bytes); first signs, all are published.
SIGNING_KEYS=
# Same form, signs website keys only (kids and keys differ from SIGNING_KEYS). Derived outside production.
WEBSITE_SIGNING_KEYS=
# Envelope-encryption keys: kid:base64(32 bytes)[,kid:base64…], first is active.
ENCRYPTION_KEYS=
# ≥ 32 bytes each, different.
SESSION_SECRET=
KEY_PEPPER=

# ── Optional ────────────────────────────────────────────────────────────────
# Mailer: smtp(s)://user:pass@host:port and the sender.
SMTP_URL=
MAIL_FROM=
# Asset storage (our delivery artefacts, never client data): an S3-compatible bucket.
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_ENDPOINT=
STORAGE_REGION=
# Development only, instead of a bucket: a local directory or :memory:
STORAGE_DIR=
# Separate cookie-less origin for merchant previews (another registrable domain is best).
PREVIEW_URL=
APP_VERSION=
# Other tuning (MONGODB_DB, MONGODB_MAX_POOL_SIZE, TRUST_PROXY_HEADERS, session lifetimes, …): see the README.
