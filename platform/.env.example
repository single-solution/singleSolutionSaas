# Portal environment: only the database (plus the optional asset storage). Everything else (keys, secrets, mail) is
# generated or set inside the Portal. After the first deploy open https://<your domain>/admin/login and choose the
# admin password. The Portal's address is the one it is opened at.
MONGODB_URI=
# optional: website scripts and pack files
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
