# Portal environment (PLAN 0.4.8). Production and preview never share a database. After the first deploy open
# https://<PORTAL_URL host>/login and create the first admin at once.
MONGODB_URI=
# the Portal's own address, https in production, no path (products pin it when they connect)
PORTAL_URL=
# random, at least 32 characters; encrypts the stored secrets (mail password, two-step secrets)
ENCRYPTION_KEY=
# optional until step 5: website scripts and pack files
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
