# Portal environment (PLAN 0.11). Production and preview never share a database. After the first deploy open
# https://<PORTAL_URL host>/login and create the first admin at once.
MONGODB_URI=
# the Portal's own address, https in production, no path (products pin it when they connect)
PORTAL_URL=
# random, at least 32 characters; encrypts the stored secrets (mail password, two-step secrets, server tokens)
ENCRYPTION_KEY=
