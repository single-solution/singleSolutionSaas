root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab
indent_size = 3

[*.md]
trim_trailing_whitespace = false

# YAML cannot hold tabs: Prettier indents it with 3 spaces (tabWidth 3)
[*.{yml,yaml}]
indent_style = space
indent_size = 3
