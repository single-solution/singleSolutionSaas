{
	"name": "single-solution-saas",
	"private": true,
	"scripts": {
		"dev": "pnpm --parallel -r dev",
		"dev:portal": "pnpm --filter portal dev",
		"build": "pnpm -r build",
		"build:portal": "pnpm --filter portal build",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"fix": "eslint . --fix && prettier --write .",
		"check": "pnpm lint && pnpm format:check && pnpm test && pnpm -r build"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"autoprefixer": "^10.5.4",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^4.6.2",
		"globals": "^17.11.0",
		"next": "14.2.25",
		"prettier": "^3.0.3",
		"tailwindcss": "^3.4.17",
		"vitest": "^2.1.9"
	}
}
