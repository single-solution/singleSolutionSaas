{
	"name": "shelfway-suite",
	"private": true,
	"type": "module",
	"engines": {
		"node": "22.x"
	},
	"prettier": "@ss/config/prettier.json",
	"scripts": {
		"check": "prettier --check . && pnpm -r --workspace-concurrency=1 check",
		"format": "prettier --write . && pnpm -r format",
		"validate": "pnpm --filter './products/*' validate"
	},
	"devDependencies": {
		"@ss/config": "workspace:^",
		"prettier": "^3.9.9"
	}
}
