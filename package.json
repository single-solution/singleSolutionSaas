{
	"name": "single-solution",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@11.5.2",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"lint": "eslint .",
		"typecheck": "tsc -p tsconfig.json",
		"test": "vitest run",
		"test:watch": "vitest",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test"
	},
	"devDependencies": {
		"@ss/cli": "workspace:*",
		"@eslint/js": "^9.39.5",
		"@types/node": "^22.20.4",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitest/coverage-v8": "^3.2.7",
		"eslint": "^9.39.5",
		"fast-check": "^4.10.2",
		"globals": "^17.12.0",
		"jsdom": "^26.1.0",
		"mongodb-memory-server": "^10.4.3",
		"prettier": "^3.9.9",
		"typescript": "~5.9.3",
		"vitest": "^3.2.7"
	}
}
