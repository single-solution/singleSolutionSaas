{
	"name": "single-solution",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"prettier": "@ss/config/prettier.json",
	"scripts": {
		"check": "prettier --check . && pnpm -r --workspace-concurrency=1 --filter '!./products/chatbot' check",
		"test": "pnpm -r --workspace-concurrency=1 --filter '!./products/chatbot' test",
		"test:all": "vitest run",
		"lint": "pnpm -r --filter '!./products/chatbot' lint",
		"typecheck": "pnpm -r --filter '!./products/chatbot' typecheck",
		"format": "prettier --write . && pnpm -r --filter '!./products/chatbot' format",
		"format:check": "prettier --check . && pnpm -r --filter '!./products/chatbot' format:check",
		"validate": "pnpm --filter './products/*' --filter '!./products/chatbot' validate"
	},
	"devDependencies": {
		"@ss/cli": "workspace:^",
		"@ss/config": "workspace:^",
		"@vitest/coverage-v8": "^3.2.7",
		"prettier": "^3.9.9",
		"vitest": "^3.2.7"
	}
}
