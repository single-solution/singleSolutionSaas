{
	"openapi": "3.1.0",
	"info": {
		"title": "Notes API",
		"version": "0.1.0"
	},
	"servers": [
		{
			"url": "https://notes.test"
		}
	],
	"paths": {
		"/v1/admin/notes": {
			"get": {
				"x-ss-auth": "ticket",
				"x-ss-feature": "notes",
				"x-ss-permission": "notes.read",
				"security": [
					{
						"ticket": []
					}
				],
				"parameters": [],
				"responses": {
					"2XX": {
						"description": "Success (JSON)"
					},
					"default": {
						"description": "Problem (RFC 9457) with a stable code",
						"content": {
							"application/problem+json": {
								"schema": {
									"$ref": "#/components/schemas/Problem"
								}
							}
						}
					}
				}
			}
		},
		"/v1/data-rights/delete": {
			"post": {
				"summary": "Delete one user's records",
				"x-ss-auth": "server",
				"security": [
					{
						"serverToken": []
					}
				],
				"parameters": [],
				"responses": {
					"2XX": {
						"description": "Success (JSON)"
					},
					"default": {
						"description": "Problem (RFC 9457) with a stable code",
						"content": {
							"application/problem+json": {
								"schema": {
									"$ref": "#/components/schemas/Problem"
								}
							}
						}
					}
				}
			}
		},
		"/v1/data-rights/export": {
			"post": {
				"summary": "Export one user's records",
				"x-ss-auth": "server",
				"security": [
					{
						"serverToken": []
					}
				],
				"parameters": [],
				"responses": {
					"2XX": {
						"description": "Success (JSON)"
					},
					"default": {
						"description": "Problem (RFC 9457) with a stable code",
						"content": {
							"application/problem+json": {
								"schema": {
									"$ref": "#/components/schemas/Problem"
								}
							}
						}
					}
				}
			}
		},
		"/v1/notes": {
			"get": {
				"x-ss-auth": "server",
				"x-ss-feature": "notes",
				"security": [
					{
						"serverToken": []
					}
				],
				"parameters": [],
				"responses": {
					"2XX": {
						"description": "Success (JSON)"
					},
					"default": {
						"description": "Problem (RFC 9457) with a stable code",
						"content": {
							"application/problem+json": {
								"schema": {
									"$ref": "#/components/schemas/Problem"
								}
							}
						}
					}
				}
			},
			"post": {
				"x-ss-auth": "browser",
				"x-ss-feature": "notes",
				"security": [
					{
						"browserToken": []
					}
				],
				"parameters": [
					{
						"name": "Idempotency-Key",
						"in": "header",
						"required": false,
						"schema": {
							"type": "string",
							"maxLength": 255
						}
					}
				],
				"responses": {
					"2XX": {
						"description": "Success (JSON)"
					},
					"default": {
						"description": "Problem (RFC 9457) with a stable code",
						"content": {
							"application/problem+json": {
								"schema": {
									"$ref": "#/components/schemas/Problem"
								}
							}
						}
					}
				}
			}
		},
		"/v1/tickets": {
			"post": {
				"summary": "Ticket for an admin widget (15 minutes)",
				"x-ss-auth": "server",
				"security": [
					{
						"serverToken": []
					}
				],
				"parameters": [],
				"responses": {
					"2XX": {
						"description": "Success (JSON)"
					},
					"default": {
						"description": "Problem (RFC 9457) with a stable code",
						"content": {
							"application/problem+json": {
								"schema": {
									"$ref": "#/components/schemas/Problem"
								}
							}
						}
					}
				}
			}
		}
	},
	"components": {
		"securitySchemes": {
			"browserToken": {
				"type": "http",
				"scheme": "bearer",
				"description": "The website's browser token: visitor routes, from https://<exact domain> or a local origin."
			},
			"serverToken": {
				"type": "http",
				"scheme": "bearer",
				"description": "The website's server token: the merchant's server only, never with an Origin header."
			},
			"ticket": {
				"type": "http",
				"scheme": "bearer",
				"description": "A ticket from POST /v1/tickets: admin widgets, only from the origin it names."
			}
		},
		"schemas": {
			"Problem": {
				"type": "object",
				"required": [
					"type",
					"title",
					"status"
				],
				"properties": {
					"type": {
						"type": "string"
					},
					"title": {
						"type": "string"
					},
					"status": {
						"type": "integer"
					},
					"code": {
						"type": "string"
					},
					"detail": {
						"type": "string"
					}
				}
			}
		}
	}
}
