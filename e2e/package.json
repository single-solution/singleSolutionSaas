		"@ss/product-payments": "workspace:^",
		"@ss/protocol": "workspace:^",
		"@types/node": "^22.20.4",
		"eslint": "^9.39.5",
		"jsdom": "^30.1.2",
		"mongodb": "^6.21.0",
		"mongodb-memory-server": "^10.4.3",
